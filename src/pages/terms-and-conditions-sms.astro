---
import Nav    from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { ORG_CICON, WEBSITE_CICON } from '../lib/schema-constants';
import '../styles/globals.css';
import { getSmsTermsPage } from '../lib/sanity';
import { renderPortableText } from '../lib/portable-text';

const isPreview    = import.meta.env.VERCEL_ENV !== 'production';
const canonicalUrl = 'https://cicon.ca/terms-and-conditions-sms/';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    ORG_CICON,
    WEBSITE_CICON,
    {
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: 'SMS Terms and Conditions — CiCon Marketing',
      description: 'Terms and conditions for CiCon Marketing\'s SMS messaging program, including opt-out instructions and carrier information.',
      isPartOf: { '@id': 'https://cicon.ca/#website' },
      breadcrumb: { '@id': `${canonicalUrl}#breadcrumb` },
      inLanguage: 'en-CA',
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home',              item: 'https://cicon.ca/' },
        { '@type': 'ListItem', position: 2, name: 'SMS Terms',         item: canonicalUrl },
      ],
    },
  ],
};

let smsData = { pageTitle: 'Terms and Conditions – SMS', lastReviewed: 'May 2026', content: null as any };
try {
  const sanity = await getSmsTermsPage();
  if (sanity?.pageTitle) smsData = sanity;
} catch {}
const smsContentHtml = smsData.content ? renderPortableText(smsData.content) : null;
---

<!DOCTYPE html>
<html lang="en-CA">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SMS Terms and Conditions — CiCon Marketing</title>
  <meta name="description" content="Terms and conditions for CiCon Marketing's SMS messaging program, including opt-out instructions and carrier information." />
  <link rel="canonical" href={canonicalUrl} />
  {isPreview
    ? <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
    : <meta name="robots" content="index, follow" />
  }
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <style>
    :root {
      --navy:    #212129;
      --teal:    #9D833E;
      --gray:    #E7E7E7;
      --charcoal:#3A3A3A;
      --off-white:#FAFAFA;
    }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: 'Inter', sans-serif; background: var(--off-white); color: var(--charcoal); }
    h1,h2,h3 { font-family: 'Inter', sans-serif; }
    .legal-body h2 { font-size: 1.1rem; font-weight: 700; color: var(--navy); margin: 2rem 0 0.5rem; }
    .legal-body p  { font-size: 0.95rem; line-height: 1.75; margin: 0 0 1rem; }
    .legal-body ul { font-size: 0.95rem; line-height: 1.75; margin: 0 0 1rem; padding-left: 1.4rem; }
    .legal-body li { margin-bottom: 0.35rem; }
    .legal-body a  { color: var(--teal); text-decoration: none; }
    .legal-body a:hover { text-decoration: underline; }
  </style>

  <!-- Google Tag Manager -->
  <script is:inline>
  (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-NH5ZSMKJ');
  </script>
  <!-- End Google Tag Manager -->
  <!-- Meta Pixel Code -->
  <script is:inline>
  !function(f,b,e,v,n,t,s)
  {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
  n.callMethod.apply(n,arguments):n.queue.push(arguments)};
  if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
  n.queue=[];t=b.createElement(e);t.async=!0;
  t.src=v;s=b.getElementsByTagName(e)[0];
  s.parentNode.insertBefore(t,s)}(window, document,'script',
  'https://connect.facebook.net/en_US/fbevents.js');
  fbq('init', '1299226945517753');
  fbq('track', 'PageView');
  </script>
  <noscript><img height="1" width="1" style="display:none"
  src="https://www.facebook.com/tr?id=1299226945517753&ev=PageView&noscript=1"/></noscript>
  <!-- End Meta Pixel Code -->
</head>
<body style="background:var(--off-white);">
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NH5ZSMKJ"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->

  <Nav />

  <!-- Page hero -->
  <section style="background:var(--navy);padding:64px 24px 48px;">
    <div style="max-width:800px;margin:0 auto;">
      <p style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.15em;color:#9D833E;margin:0 0 12px;">Legal</p>
      <h1 style="font-size:clamp(1.8rem,3.5vw,2.6rem);font-weight:900;color:#fff;margin:0 0 12px;line-height:1.15;letter-spacing:-0.02em;">{smsData.pageTitle}</h1>
      <p style="font-size:0.9rem;color:rgba(255,255,255,0.55);margin:0;">CiCon Marketing — Last reviewed {smsData.lastReviewed}</p>
    </div>
  </section>

  <!-- Content -->
  <main style="padding:56px 24px 80px;">
    <div style="max-width:800px;margin:0 auto;" class="legal-body">

      {smsContentHtml ? (
        <Fragment set:html={smsContentHtml} />
      ) : (
        <>
          <p>Our program provides appointment reminder and confirmation texts for our marketing services. Users can expect to receive timely reminders and confirmations for their scheduled appointments.</p>

          <h2>Opting Out</h2>
          <p>You can cancel the SMS service at any time. Simply text <strong>"STOP"</strong> to the shortcode. Upon sending "STOP," we will confirm your unsubscribe status via SMS. Following this confirmation, you will no longer receive SMS messages from us. To rejoin, sign up as you did initially, and we will resume sending SMS messages to you.</p>

          <h2>Support</h2>
          <p>If you experience issues with the messaging program, reply with the keyword <strong>HELP</strong> for more assistance, or reach out directly to <a href="mailto:info@cicon.ca">info@cicon.ca</a>.</p>

          <h2>Carrier Liability</h2>
          <p>Carriers are not liable for delayed or undelivered messages.</p>

          <h2>Message &amp; Data Rates</h2>
          <p>As always, message and data rates may apply for messages sent to you from us and to us from you. You will receive appointment reminder and confirmation texts. For questions about your text plan or data plan, contact your wireless provider.</p>

          <h2>Privacy</h2>
          <p>For privacy-related inquiries, please refer to our <a href="/privacy-policy/">Privacy Policy</a>.</p>

          <!-- Summary callout -->
          <div style="margin:2.5rem 0;padding:24px 28px;background:#fff;border:1px solid var(--gray);border-radius:12px;border-left:4px solid #9D833E;">
            <h2 style="margin-top:0;">SMS User Rights Summary</h2>
            <ul style="margin-bottom:0;">
              <li><strong>Message Frequency:</strong> You may receive up to 4–6 SMS per month from CiCon Marketing, unless otherwise requested by you.</li>
              <li><strong>Carrier Fees:</strong> Message and data rates may apply depending on your mobile plan.</li>
              <li><strong>Opt-Out:</strong> Reply <strong>STOP</strong> to unsubscribe from SMS messages at any time.</li>
              <li><strong>Support:</strong> Reply <strong>HELP</strong> for assistance or contact us at <a href="mailto:info@cicon.ca">info@cicon.ca</a>.</li>
            </ul>
          </div>
        </>
      )}

      <p style="margin-top:2.5rem;padding-top:1.5rem;border-top:1px solid var(--gray);font-size:0.85rem;color:#888;">
        See also: <a href="/privacy-policy/">Privacy Policy</a>
      </p>

    </div>
  </main>

  <Footer />

</body>
</html>
