---
import Nav    from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { ORG_CICON, WEBSITE_CICON } from '../lib/schema-constants';
import '../styles/globals.css';
import { getPrivacyPolicyPage } from '../lib/sanity';
import { renderPortableText } from '../lib/portable-text';

const isPreview    = import.meta.env.VERCEL_ENV !== 'production';
const canonicalUrl = 'https://cicon.ca/privacy-policy/';

let ppData = { pageTitle: 'Privacy Policy', lastReviewed: 'May 2026', content: null as any };
try {
  const sanity = await getPrivacyPolicyPage();
  if (sanity?.pageTitle) ppData = sanity;
} catch {}
const ppContentHtml = ppData.content ? renderPortableText(ppData.content) : null;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    ORG_CICON,
    WEBSITE_CICON,
    {
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: 'Privacy Policy — CiCon Marketing',
      description: 'Learn how CiCon Marketing collects, uses, and protects your personal information.',
      isPartOf: { '@id': 'https://cicon.ca/#website' },
      breadcrumb: { '@id': `${canonicalUrl}#breadcrumb` },
      inLanguage: 'en-CA',
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home',           item: 'https://cicon.ca/' },
        { '@type': 'ListItem', position: 2, name: 'Privacy Policy', item: canonicalUrl },
      ],
    },
  ],
};
---

<!DOCTYPE html>
<html lang="en-CA">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="/fonts/fonts.css" />
  <title>Privacy Policy — CiCon Marketing</title>
  <meta name="description" content="Learn how CiCon Marketing collects, uses, and protects your personal information when you interact with our services." />
  <link rel="canonical" href={canonicalUrl} />
  {isPreview
    ? <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
    : <meta name="robots" content="index, follow" />
  }
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <style>
    :root {
      --navy:    #212129;
      --teal:    #9D833E;
      --gray:    #E7E7E7;
      --charcoal:#3A3A3A;
      --off-white:#FAFAFA;
    }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: 'Inter', sans-serif; background: var(--off-white); color: var(--charcoal); }
    h1,h2,h3 { font-family: 'Clash Display', 'Inter', sans-serif; }
    .legal-body h2 { font-size: 1.1rem; font-weight: 700; color: var(--navy); margin: 2rem 0 0.5rem; }
    .legal-body p  { font-size: 0.95rem; line-height: 1.75; margin: 0 0 1rem; }
    .legal-body ul { font-size: 0.95rem; line-height: 1.75; margin: 0 0 1rem; padding-left: 1.4rem; }
    .legal-body li { margin-bottom: 0.35rem; }
    .legal-body a  { color: var(--teal); text-decoration: none; }
    .legal-body a:hover { text-decoration: underline; }
  </style>

  <!-- Google Tag Manager (lazy: loads after 3.5 s or first user interaction) -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    window.gtag = gtag;
    (function () {
      function loadGTM() {
        if (window._gtmLoaded) return;
        window._gtmLoaded = true;
        (function(w,d,s,l,i){
          w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});
          var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';
          j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;
          f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','GTM-NH5ZSMKJ');
      }
      setTimeout(loadGTM, 3500);
      ['click','keydown','mousemove','touchstart','scroll'].forEach(function(ev){
        window.addEventListener(ev, loadGTM, {once:true, passive:true});
      });
    })();
  </script>
  <!-- End Google Tag Manager -->
  <!-- Meta Pixel (lazy: fbq stub queues calls immediately; fbevents.js loads after 3.5s or first interaction) -->
  <link rel="preconnect" href="https://connect.facebook.net" crossorigin />
  <script is:inline>
    !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){
    n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
    fbq('init','1299226945517753');
    fbq('track','PageView');
    (function(){
      function loadPixel(){
        if(window._fbqLoaded)return;window._fbqLoaded=true;
        var s=document.createElement('script');s.async=true;
        s.src='https://connect.facebook.net/en_US/fbevents.js';
        document.head.appendChild(s);
      }
      setTimeout(loadPixel,3500);
      ['click','keydown','mousemove','touchstart','scroll'].forEach(function(ev){
        window.addEventListener(ev,loadPixel,{once:true,passive:true});
      });
    })();
  </script>
  <noscript><img height="1" width="1" style="display:none"
  src="https://www.facebook.com/tr?id=1299226945517753&ev=PageView&noscript=1"/></noscript>
  <!-- End Meta Pixel -->
</head>
<body style="background:var(--off-white);">
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NH5ZSMKJ"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->

  <Nav />

  <!-- Page hero -->
  <section style="background:var(--navy);padding:64px 24px 48px;">
    <div style="max-width:800px;margin:0 auto;">
      <p style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.15em;color:#9D833E;margin:0 0 12px;">Legal</p>
      <h1 class="font-heading" style="font-size:clamp(1.8rem,3.5vw,2.6rem);font-weight:900;color:#fff;margin:0 0 12px;line-height:1.15;letter-spacing:-0.02em;">{ppData.pageTitle}</h1>
      <p style="font-size:0.9rem;color:rgba(255,255,255,0.55);margin:0;">CiCon Marketing — Last reviewed {ppData.lastReviewed}</p>
    </div>
  </section>

  <!-- Content -->
  <main style="padding:56px 24px 80px;">
    <div style="max-width:800px;margin:0 auto;" class="legal-body">

      {ppContentHtml ? (
        <Fragment set:html={ppContentHtml} />
      ) : (
        <>
          <p>CiCon Marketing ("we," "us," or "our") respects the privacy of our users ("you" or "your"). This Privacy Policy describes the types of information we collect through our lead capture forms on Meta Platforms (including Facebook, Instagram, and WhatsApp) and LinkedIn and how we use that information.</p>

          <h2 class="font-heading">Information We Collect</h2>
          <p>We collect the following information when you submit a lead capture form on our website, Meta Platforms, Google Ads and LinkedIn campaigns:</p>
          <ul>
            <li>Full Name</li>
            <li>Email Address</li>
            <li>Phone Number</li>
            <li>City</li>
          </ul>

          <h2 class="font-heading">SMS Message</h2>
          <p>SMS messages will inform the recipient:</p>
          <ul>
            <li>They are consenting to receive messages from the business</li>
            <li>Their personal info will not be shared with third parties for marketing purposes</li>
            <li>Message frequency may vary but is generally limited to no more than 4–6 messages per month unless initiated by the user</li>
            <li>They may reply STOP (or other keywords) to opt-out of future messaging</li>
            <li>They may reply HELP for more information</li>
            <li>Message and data rates may apply</li>
          </ul>
          <p>We collect your phone number when you opt in to receive appointment reminders and promotional SMS messages. You may withdraw this consent at any time by replying STOP or contacting us at <a href="mailto:info@cicon.ca">info@cicon.ca</a>.</p>

          <h2 class="font-heading">Use of Information</h2>
          <p>We use the information we collect to:</p>
          <ul>
            <li>Respond to your inquiries and requests about CiCon Marketing's services.</li>
            <li>Send you information about CiCon Marketing's services, but only with your consent (you will have the option to opt-in or opt-out of receiving marketing communications).</li>
            <li>Improve our marketing and advertising efforts on Meta Platforms and LinkedIn.</li>
          </ul>

          <h2 class="font-heading">Data Sharing</h2>
          <p>We will not share your information with any third party without your consent, except for the following limited circumstances:</p>
          <ul>
            <li><strong>Service Providers:</strong> We may share your information with service providers who help us operate our business, such as email marketing providers. These service providers are obligated to protect your information according to strict confidentiality agreements.</li>
          </ul>

          <h2 class="font-heading">Data Retention</h2>
          <p>We will retain your information for as long as necessary to fulfill the purposes described in this Privacy Policy, unless a longer retention period is required or permitted by law (e.g., for tax or accounting purposes).</p>

          <h2 class="font-heading">Your Rights</h2>
          <p>You have the following rights with respect to your information:</p>
          <ul>
            <li><strong>Access:</strong> You have the right to access your information and request a copy of it.</li>
            <li><strong>Rectification:</strong> You have the right to request that we correct any inaccurate information about you.</li>
            <li><strong>Erasure:</strong> You can request that we erase your information.</li>
            <li><strong>Restriction of Processing:</strong> You can request that we restrict the processing of your information.</li>
            <li><strong>Objection:</strong> You can object to the processing of your information, such as for marketing purposes.</li>
          </ul>
          <p>To exercise any of these rights, please contact our Privacy Officer at <a href="mailto:info@cicon.ca">info@cicon.ca</a> or by mail at:</p>
          <p style="padding:16px 20px;background:#f5f5f5;border-radius:8px;font-size:0.9rem;line-height:1.8;">
            <strong>CiCon Marketing</strong><br />
            Attn: Privacy Officer<br />
            69 Cartier Crescent, Richmond Hill, ON L4C 2N3, Canada
          </p>

          <h2 class="font-heading">Security</h2>
          <p>We take reasonable steps to protect your information from unauthorized access, disclosure, alteration, or destruction. However, no internet transmission is completely secure, and we cannot guarantee the security of your information.</p>

          <h2 class="font-heading">Changes to this Privacy Policy</h2>
          <p>We may update this Privacy Policy from time to time. We will post any changes on this webpage.</p>

          <h2 class="font-heading">Contact Us</h2>
          <p>If you have any questions about this Privacy Policy, please contact our Privacy Officer at <a href="mailto:info@cicon.ca">info@cicon.ca</a> or by mail at the address provided above.</p>
        </>
      )}

      <p style="margin-top:2.5rem;padding-top:1.5rem;border-top:1px solid var(--gray);font-size:0.85rem;color:#888;">
        See also: <a href="/terms-and-conditions-sms/">SMS Terms &amp; Conditions</a>
      </p>

    </div>
  </main>

  <Footer />

</body>
</html>
