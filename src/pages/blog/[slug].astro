---
/**
 * [slug].astro — CiCon Blog Post Template (v1.0)
 * 11 sections + 5 micro-interactions per CICON_BLOG_TEMPLATE_SPEC.md
 */
import { createClient } from '@sanity/client'
import { renderPortableText, extractH2s } from '../../lib/portable-text'
import type { PTNode } from '../../lib/portable-text'
import { PERSON_MAJID, ORG_CICON, WEBSITE_CICON } from '../../lib/schema-constants'
import Nav from '../../components/Nav.astro'
import Footer from '../../components/Footer.astro'
import '../../styles/globals.css'

// ── Sanity client ──────────────────────────────────────────────────────────────

function getSanityClient() {
  const rawId = (import.meta.env.PUBLIC_SANITY_PROJECT_ID ?? '').trim()
  const dataset = (import.meta.env.PUBLIC_SANITY_DATASET ?? 'production').trim()
  if (!/^[a-z0-9-]+$/.test(rawId)) return null
  return createClient({ projectId: rawId, dataset, useCdn: false, apiVersion: '2024-01-01' })
}

// ── Queries ────────────────────────────────────────────────────────────────────

const ALL_SLUGS_QUERY = `
  *[_type == "blogPost" && status == "published" && !(_id in path("drafts.**"))] {
    "slug": slug.current
  }
`

const POST_QUERY = `
  *[_type == "blogPost" && slug.current == $slug && status == "published" && !(_id in path("drafts.**"))][0] {
    _id, _createdAt, _updatedAt,
    title,
    "slug": slug.current,
    dek,
    heroImage{ url, alt, caption },
    readTime,
    publishedAt,
    quickAnswer,
    body[]{
      _key, _type,
      style, listItem, level,
      children[]{ _key, _type, text, marks },
      markDefs[]{ _key, _type, href },
      number, label, source,
      quote, attribution,
      url, alt, caption, tilt,
      heading,
      tabs[]{ _key, title, body[]{ _key, _type, style, listItem, level, children[]{ _key, _type, text, marks }, markDefs[]{ _key, _type, href } } },
      title, whyItMatters,
      "body": body[]{ _key, _type, style, listItem, level, children[]{ _key, _type, text, marks }, markDefs[]{ _key, _type, href } },
      headers,
      rows[]{ _key, _type, cells }
    },
    faqs[]{ _key, question, answer },
    endCtaStat{ number, context, source },
    "category": category->{ name, "slug": slug.current },
    "relatedPosts": relatedPosts[0..2]->{
      _id, title, "slug": slug.current, dek,
      heroImage{ url, alt, caption },
      readTime, publishedAt,
      "category": category->{ name, "slug": slug.current }
    },
    metaTitle, metaDescription, keywords,
    "aboutEntities": aboutEntities[]{ name, type, sameAs },
    "mentionsEntities": mentionsEntities[]{ name, type, sameAs }
  }
`

// ── getStaticPaths ─────────────────────────────────────────────────────────────

export async function getStaticPaths() {
  try {
    const { createClient: _createClient } = await import('@sanity/client')
    const rawId = (import.meta.env.PUBLIC_SANITY_PROJECT_ID ?? '').trim()
    const dataset = (import.meta.env.PUBLIC_SANITY_DATASET ?? 'production').trim()
    if (!/^[a-z0-9-]+$/.test(rawId)) return []
    const _client = _createClient({ projectId: rawId, dataset, useCdn: false, apiVersion: '2024-01-01' })
    const slugs = await _client.fetch<Array<{ slug: string }>>(
      `*[_type == "blogPost" && status == "published" && !(_id in path("drafts.**"))] { "slug": slug.current }`
    )
    return slugs.map(({ slug }) => ({ params: { slug } }))
  } catch (err) {
    console.error('[Sanity] Failed to fetch slugs for [slug].astro:', err)
    return []
  }
}

// ── Fetch post data ────────────────────────────────────────────────────────────

const { slug } = Astro.params
const client = getSanityClient()

let post: any = null
if (client) {
  try {
    post = await client.fetch(POST_QUERY, { slug })
  } catch (err) {
    console.error(`[Sanity] Failed to fetch post "${slug}":`, err)
  }
}

if (!post) {
  return Astro.redirect('/blog/', 302)
}

// Block indexing on Vercel preview builds; allow on production (cicon.ca).
const isPreview = import.meta.env.VERCEL_ENV !== 'production'

// ── Derived data ───────────────────────────────────────────────────────────────

const postUrl = `https://cicon.ca/blog/${post.slug}/`
const datePublished = post.publishedAt ?? post._createdAt?.slice(0, 10) ?? ''
const dateModified = post._updatedAt?.slice(0, 10) ?? datePublished
const datePublishedISO = datePublished ? new Date(datePublished).toISOString() : ''
const dateModifiedISO = dateModified ? new Date(dateModified).toISOString() : ''

const formattedDate = dateModified
  ? new Date(dateModified).toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric' })
  : ''

const bodyHtml = renderPortableText((post.body ?? []) as PTNode[])
const tocHeadings = extractH2s((post.body ?? []) as PTNode[])

const metaTitle = post.metaTitle || `${post.title} | CiCon Marketing`
const metaDesc = post.metaDescription || post.dek || ''
const canonicalUrl = postUrl

// ── JSON-LD Connected Graph (7 nodes) ─────────────────────────────────────────

const faqNodes = (post.faqs ?? []).map((faq: any) => ({
  '@type': 'Question',
  name: faq.question,
  acceptedAnswer: { '@type': 'Answer', text: faq.answer },
}))

// Only Place and Organization pass through; everything else (including any legacy
// SoftwareApplication values) coerces to Thing — safe for Google Rich Results.
const ALLOWED_ENTITY_TYPES = new Set(['Place', 'Organization'])
function safeEntityType(raw: string | undefined): string {
  return raw && ALLOWED_ENTITY_TYPES.has(raw) ? raw : 'Thing'
}

const aboutEntities = (post.aboutEntities ?? []).map((e: any) => {
  const node: any = { '@type': safeEntityType(e.type), name: e.name }
  if (e.sameAs) node.sameAs = e.sameAs
  return node
})

const mentionsEntities = (post.mentionsEntities ?? []).map((e: any) => {
  const node: any = { '@type': safeEntityType(e.type), name: e.name }
  if (e.sameAs) node.sameAs = e.sameAs
  return node
})

const schema: any = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      '@id': `${postUrl}#blogposting`,
      url: postUrl,
      headline: post.title,
      description: metaDesc,
      datePublished: datePublishedISO,
      dateModified: dateModifiedISO,
      inLanguage: 'en-CA',
      author: { '@id': 'https://cicon.ca/#majid-behzad' },
      publisher: { '@id': 'https://cicon.ca/#organization' },
      isPartOf: { '@id': `${postUrl}#webpage` },
      mainEntityOfPage: { '@id': `${postUrl}#webpage` },
      speakable: {
        '@type': 'SpeakableSpecification',
        cssSelector: ['.quick-answer__body', '.end-cta__stat-number', '.end-cta__stat-context'],
      },
      ...(post.heroImage?.url ? {
        image: {
          '@type': 'ImageObject',
          url: post.heroImage.url,
          description: post.heroImage.alt ?? post.title,
        },
      } : {}),
      ...(aboutEntities.length > 0 ? { about: aboutEntities } : {}),
      ...(mentionsEntities.length > 0 ? { mentions: mentionsEntities } : {}),
      ...(post.readTime ? { timeRequired: `PT${post.readTime}M` } : {}),
    },
    {
      '@type': 'WebPage',
      '@id': `${postUrl}#webpage`,
      url: postUrl,
      name: metaTitle,
      description: metaDesc,
      isPartOf: { '@id': 'https://cicon.ca/#website' },
      primaryImageOfPage: post.heroImage?.url ? { '@type': 'ImageObject', url: post.heroImage.url } : undefined,
      breadcrumb: { '@id': `${postUrl}#breadcrumb` },
      inLanguage: 'en-CA',
    },
    WEBSITE_CICON,
    {
      '@type': 'BreadcrumbList',
      '@id': `${postUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://cicon.ca/' },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://cicon.ca/blog/' },
        { '@type': 'ListItem', position: 3, name: post.title, item: postUrl },
      ],
    },
    PERSON_MAJID,
    ORG_CICON,
    ...(faqNodes.length > 0 ? [{
      '@type': 'FAQPage',
      '@id': `${postUrl}#faqpage`,
      mainEntity: faqNodes,
    }] : []),
  ].filter(Boolean),
}
---

<!DOCTYPE html>
<html lang="en-CA">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{metaTitle}</title>
  <meta name="description" content={metaDesc} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="icon" type="image/png" sizes="120x120" href="/logo-cicon-120.png" />
  {isPreview
    ? <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
    : <meta name="robots" content="index, follow" />
  }

  <!-- Open Graph -->
  <meta property="og:type" content="article" />
  <meta property="og:url" content={postUrl} />
  <meta property="og:title" content={metaTitle} />
  <meta property="og:description" content={metaDesc} />
  {post.heroImage?.url && <meta property="og:image" content={post.heroImage.url} />}
  <meta property="article:published_time" content={datePublishedISO} />
  <meta property="article:modified_time" content={dateModifiedISO} />
  <meta property="article:author" content="Majid Behzad" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={metaTitle} />
  <meta name="twitter:description" content={metaDesc} />
  {post.heroImage?.url && <meta name="twitter:image" content={post.heroImage.url} />}

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

  <!-- JSON-LD Connected Graph -->
  <script type="application/ld+json" id="article-schema" set:html={JSON.stringify(schema)} />

  <!-- Google Tag Manager (lazy: loads after 3.5 s or first user interaction) -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    window.gtag = gtag;
    (function () {
      function loadGTM() {
        if (window._gtmLoaded) return;
        window._gtmLoaded = true;
        (function(w,d,s,l,i){
          w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});
          var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';
          j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;
          f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','GTM-NH5ZSMKJ');
      }
      setTimeout(loadGTM, 3500);
      ['click','keydown','mousemove','touchstart','scroll'].forEach(function(ev){
        window.addEventListener(ev, loadGTM, {once:true, passive:true});
      });
    })();
  </script>
  <!-- End Google Tag Manager -->
  <!-- Meta Pixel (lazy: fbq stub queues calls immediately; fbevents.js loads after 3.5s or first interaction) -->
  <link rel="preconnect" href="https://connect.facebook.net" crossorigin />
  <script is:inline>
    !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){
    n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
    fbq('init','1299226945517753');
    fbq('track','PageView');
    (function(){
      function loadPixel(){
        if(window._fbqLoaded)return;window._fbqLoaded=true;
        var s=document.createElement('script');s.async=true;
        s.src='https://connect.facebook.net/en_US/fbevents.js';
        document.head.appendChild(s);
      }
      setTimeout(loadPixel,3500);
      ['click','keydown','mousemove','touchstart','scroll'].forEach(function(ev){
        window.addEventListener(ev,loadPixel,{once:true,passive:true});
      });
    })();
  </script>
  <noscript><img height="1" width="1" style="display:none"
  src="https://www.facebook.com/tr?id=1299226945517753&ev=PageView&noscript=1"/></noscript>
  <!-- End Meta Pixel -->
</head>

<body class="font-sans antialiased" style="background:var(--off-white);color:var(--charcoal)">
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NH5ZSMKJ"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->

<!-- ══ SECTION 1: SITE-WIDE NAV ═══════════════════════════════════════════════ -->
<Nav />

<!-- Reading progress bar -->
<div id="reading-progress" class="fixed top-0 left-0 h-[3px] w-0 z-[60] transition-none" style="background:var(--amber)" aria-hidden="true"></div>

<!-- ══ SECTION 2: HERO BLOCK ══════════════════════════════════════════════════ -->
<section id="hero" class="relative" style="background:var(--shadow)">
  <div class="max-w-[1280px] mx-auto px-6 py-16 md:py-24">
    <!-- Category chip -->
    {post.category && (
      <span class="inline-block font-display font-semibold uppercase text-[11px] tracking-[0.1em] px-4 py-1.5 rounded-full mb-4" style="color:var(--goldenrod);border:1px solid var(--goldenrod)">
        {post.category.name}
      </span>
    )}

    <!-- H1 -->
    <h1 class="font-display font-bold text-white max-w-[900px] mb-5 leading-tight" style="font-size:clamp(2.5rem,5vw,4rem);letter-spacing:-0.02em">
      {post.title}
    </h1>

    <!-- Dek -->
    {post.dek && (
      <p class="font-body text-[1.25rem] italic max-w-[700px] mb-8 leading-relaxed" style="color:rgba(255,255,255,0.8)">
        {post.dek}
      </p>
    )}

    <!-- Meta row -->
    <p class="font-body font-medium text-sm mb-6" style="color:rgba(255,255,255,0.7)">
      By Majid Behzad
      {post.readTime && <span> · {post.readTime} min read</span>}
      {formattedDate && <span> · Last updated <time datetime={dateModifiedISO}>{formattedDate}</time></span>}
    </p>

    <!-- Amber accent rule -->
    <div class="w-[60px] h-[2px]" style="background:var(--amber)"></div>
  </div>

  <!-- Featured image card — overlaps next section -->
  {post.heroImage?.url && (
    <div class="relative pb-0">
      <div class="max-w-[880px] mx-auto px-6">
        <figure class="relative" style="transform:rotate(-1.5deg);margin-bottom:-80px">
          <img
            src={post.heroImage.url}
            alt={post.heroImage.alt ?? post.title}
            loading="eager"
            fetchpriority="high"
            width="880"
            height="495"
            class="w-full rounded-lg object-cover"
            style="box-shadow:0 30px 60px -20px rgba(33,33,41,0.4),0 10px 30px -10px rgba(0,0,0,0.2);border:1px solid rgba(157,131,62,0.4)"
          />
          {post.heroImage.caption && (
            <figcaption class="text-center mt-3 font-body italic text-sm" style="color:rgba(58,58,58,0.7)">
              {post.heroImage.caption}
            </figcaption>
          )}
        </figure>
      </div>
    </div>
  )}
</section>

<!-- ══ SECTION 3: QUICK ANSWER CARD ══════════════════════════════════════════ -->
{post.quickAnswer && (
  <section id="quick-answer" class="max-w-[880px] mx-auto px-6" style="padding-top:calc(80px + 80px);padding-bottom:0">
    <div class="quick-answer-card relative rounded-xl p-8 md:p-10" style="background:var(--glass-bg);backdrop-filter:blur(16px);border:1px solid var(--glass-border);border-left:4px solid var(--goldenrod);box-shadow:0 0 0 1px rgba(157,131,63,0.25),0 20px 40px -20px rgba(33,33,41,0.18)">
      <!-- Header row -->
      <div class="flex items-start justify-between gap-4 mb-4">
        <span class="font-display font-semibold uppercase text-[11px] tracking-[0.15em]" style="color:var(--goldenrod)">Quick Answer</span>
        <button
          id="copy-answer-btn"
          class="flex-shrink-0 p-1 rounded transition-colors duration-200 group"
          aria-label="Copy answer to clipboard"
          title="Copy to clipboard"
          style="color:rgba(58,58,58,0.5)"
          onmouseover="this.style.color='var(--charcoal)'"
          onmouseout="this.style.color='rgba(58,58,58,0.5)'"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
          </svg>
        </button>
      </div>
      <!-- Answer -->
      <p id="quick-answer-text" class="quick-answer__body font-body font-medium leading-relaxed" style="font-size:1.125rem;color:var(--charcoal);line-height:1.6">
        {post.quickAnswer}
      </p>
      <!-- Copied tooltip -->
      <span id="copy-tooltip" class="hidden absolute top-4 right-10 text-xs font-display font-semibold text-white px-2 py-1 rounded" style="background:var(--goldenrod)">Copied!</span>
    </div>
  </section>
)}

<!-- ══ SECTION 4 + 5 + 6: ANTI-GRID BODY + TOC SIDEBAR + ARTICLE ════════════ -->
<main id="article-main" class="max-w-[1280px] mx-auto px-6" style={`padding-top:${post.quickAnswer ? '64px' : '80px'};padding-bottom:80px`}>
  <div class="article-grid">

    <!-- LEFT GUTTER (desktop-only pull quotes via CSS grid) -->
    <div class="article-gutter" aria-hidden="true"></div>

    <!-- MAIN PROSE COLUMN -->
    <article id="article-body" class="article-prose min-w-0">
      <div set:html={bodyHtml} />

      <!-- ══ FAQ SECTION ══════════════════════════════════════════════════════ -->
      {post.faqs && post.faqs.length > 0 && (
        <section class="mt-16" aria-label="Frequently Asked Questions">
          <h2 class="font-display font-bold mb-8 leading-tight scroll-mt-24" style="font-size:clamp(1.75rem,3vw,2.5rem);color:var(--black);letter-spacing:-0.01em" id="faq">
            Frequently Asked Questions
          </h2>

          <div class="faq-list space-y-3">
            {post.faqs.map((faq: any, i: number) => (
              <div class="faq-item rounded-xl border overflow-hidden" style="border-color:var(--hairline)">
                <button
                  class="faq-toggle w-full flex items-start justify-between gap-4 px-6 py-5 text-left transition-colors duration-200 bg-white hover:bg-[#FAFAFA]"
                  aria-expanded="false"
                  aria-controls={`faq-answer-${i}`}
                  id={`faq-question-${i}`}
                >
                  <span class="font-display font-semibold text-[1rem] leading-snug" style="color:var(--black)">{faq.question}</span>
                  <svg class="faq-chevron flex-shrink-0 mt-0.5 w-5 h-5 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true" style="color:var(--goldenrod)">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                  </svg>
                </button>
                <div id={`faq-answer-${i}`} class="faq-answer hidden" role="region" aria-labelledby={`faq-question-${i}`}>
                  <div class="px-6 pb-6 pt-1 border-t" style="border-color:var(--hairline)">
                    <p class="font-body leading-relaxed" style="color:var(--charcoal);font-size:1rem;line-height:1.7">{faq.answer}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}
    </article>

    <!-- STICKY RIGHT SIDEBAR (desktop ≥1024px) -->
    {tocHeadings.length > 0 && (
      <aside id="toc-sidebar" class="article-sidebar hidden lg:block" aria-label="Table of contents">
        <div class="sticky top-24">
          <p class="font-display font-semibold uppercase text-[11px] tracking-[0.15em] mb-4" style="color:var(--goldenrod)">On This Page</p>
          <nav aria-label="Article sections">
            <ul class="space-y-0" role="list">
              {tocHeadings.map(h => (
                <li>
                  <a
                    href={`#${h.id}`}
                    class="toc-link block py-2.5 text-sm font-medium transition-all duration-200 border-l-2 pl-4"
                    style="color:rgba(58,58,58,0.7);border-color:transparent"
                    data-toc-target={h.id}
                  >
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>

          <!-- Sidebar divider -->
          <div class="my-6 h-px" style="background:var(--hairline)"></div>

          <!-- Sidebar WhatsApp CTA -->
          <a
            href="https://wa.me/16475840800"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 w-full text-white font-display font-semibold text-xs px-4 py-3 rounded-lg transition-colors duration-200"
            style="background:var(--whatsapp-bright);padding:6px 16px"
            onmouseover="this.style.background='var(--whatsapp-bright-hover)'"
            onmouseout="this.style.background='var(--whatsapp-bright)'"
          >
            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Chat on WhatsApp →
          </a>
        </div>
      </aside>
    )}
  </div>
</main>

<!-- ══ SECTION 7: END CTA ════════════════════════════════════════════════════ -->
