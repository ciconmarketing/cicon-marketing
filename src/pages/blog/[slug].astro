<!-- ══ SCRIPTS: 5 Micro-Interactions ════════════════════════════════════════ -->
<script is:inline>
(function() {
  'use strict';

  // ── Micro-interaction 1: Reading Progress Bar ──────────────────────────
  const progressBar = document.getElementById('reading-progress');
  const articleBody = document.getElementById('article-body');

  if (progressBar && articleBody) {
    let rafId = null;
    function updateProgress() {
      const articleRect = articleBody.getBoundingClientRect();
      const articleTop = articleRect.top + window.scrollY;
      const articleHeight = articleRect.height;
      const viewportH = window.innerHeight;
      const scrollable = articleHeight - viewportH;
      if (scrollable <= 0) { progressBar.style.width = '100%'; return; }
      const scrolled = window.scrollY - articleTop;
      const pct = Math.min(100, Math.max(0, (scrolled / scrollable) * 100));
      progressBar.style.width = pct + '%';
    }
    window.addEventListener('scroll', function() {
      if (rafId) cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(updateProgress);
    }, { passive: true });
    updateProgress();
  }

  // ── Micro-interaction 2: Scroll-Spy TOC ────────────────────────────────
  const tocLinks = document.querySelectorAll('.toc-link[data-toc-target]');
  const mobileTocLinks = document.querySelectorAll('.mobile-toc-link[data-toc-target]');

  if (tocLinks.length > 0) {
    const headings = Array.from(tocLinks).map(link => {
      const id = link.getAttribute('data-toc-target');
      return document.getElementById(id);
    }).filter(Boolean);

    let activeId = null;

    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          activeId = entry.target.id;
          tocLinks.forEach(link => {
            const matches = link.getAttribute('data-toc-target') === activeId;
            link.classList.toggle('active', matches);
          });
        }
      });
    }, { rootMargin: '-80px 0px -70% 0px', threshold: 0 });

    headings.forEach(h => observer.observe(h));
  }

  // ── Micro-interaction 3: Stat Count-Up ────────────────────────────────
  function parseStatTarget(rawTarget) {
    if (!rawTarget) return null;
    const str = String(rawTarget);
    const match = str.match(/[\d.]+/);
    if (!match) return null;
    return {
      value: parseFloat(match[0]),
      prefix: str.slice(0, match.index),
      suffix: str.slice(match.index + match[0].length),
      decimals: (match[0].split('.')[1] || '').length,
    };
  }

  function animateCountUp(el, parsed, duration) {
    const start = performance.now();
    function step(now) {
      const elapsed = now - start;
      const t = Math.min(elapsed / duration, 1);
      const eased = t * (2 - t); // ease-out
      const current = parsed.value * eased;
      el.textContent = parsed.prefix + current.toFixed(parsed.decimals) + parsed.suffix;
      if (t < 1) requestAnimationFrame(step);
      else el.textContent = parsed.prefix + parsed.value.toFixed(parsed.decimals) + parsed.suffix;
    }
    requestAnimationFrame(step);
  }

  const statEls = document.querySelectorAll('.stat-count-up[data-target]');
  if (statEls.length > 0) {
    const statObserver = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const el = entry.target;
          const parsed = parseStatTarget(el.getAttribute('data-target'));
          if (parsed) {
            const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            if (reduced) {
              el.textContent = parsed.prefix + parsed.value.toFixed(parsed.decimals) + parsed.suffix;
            } else {
              // Reset to zero before animating so the count-up always starts from 0
              el.textContent = parsed.prefix + (parsed.decimals ? (0).toFixed(parsed.decimals) : '0') + parsed.suffix;
              animateCountUp(el, parsed, 1500);
            }
          }
          statObserver.unobserve(el);
        }
      });
    }, { threshold: 0.3 });
    statEls.forEach(el => statObserver.observe(el));
  }

  // ── Micro-interaction 5: Smooth Scroll (anchor clicks with -80px offset)
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function(e) {
      const id = this.getAttribute('href').slice(1);
      const target = document.getElementById(id);
      if (!target) return;
      e.preventDefault();
      const top = target.getBoundingClientRect().top + window.scrollY - 80;
      window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
    });
  });

  // ── FAQ Accordion ────────────────────────────────────────────────────
  document.querySelectorAll('.faq-toggle').forEach(btn => {
    btn.addEventListener('click', function() {
      const expanded = this.getAttribute('aria-expanded') === 'true';
      const answerId = this.getAttribute('aria-controls');
      const answer = document.getElementById(answerId);
      const chevron = this.querySelector('.faq-chevron');

      this.setAttribute('aria-expanded', String(!expanded));
      if (answer) {
        answer.classList.toggle('open', !expanded);
        answer.classList.toggle('hidden', false); // remove hidden once opened
        if (expanded) {
          // closing: re-hide after transition
          answer.addEventListener('transitionend', function hide() {
            if (!answer.classList.contains('open')) answer.classList.add('hidden');
            answer.removeEventListener('transitionend', hide);
          });
        }
      }
      if (chevron) {
        chevron.style.transform = expanded ? '' : 'rotate(180deg)';
      }
    });
  });

  // ── Deep Dive Accordion ──────────────────────────────────────────────
  document.querySelectorAll('.deep-dive-toggle').forEach(btn => {
    btn.addEventListener('click', function() {
      const expanded = this.getAttribute('aria-expanded') === 'true';
      const bodyId = this.getAttribute('aria-controls');
      const body = document.getElementById(bodyId);
      const chevron = this.querySelector('.deep-dive-chevron');

      this.setAttribute('aria-expanded', String(!expanded));
      if (body) {
        body.classList.toggle('open', !expanded);
        body.classList.toggle('hidden', false);
        if (expanded) {
          body.addEventListener('transitionend', function hide() {
            if (!body.classList.contains('open')) body.classList.add('hidden');
            body.removeEventListener('transitionend', hide);
          });
        }
      }
      if (chevron) {
        chevron.style.transform = expanded ? '' : 'rotate(180deg)';
      }
    });
  });

  // ── Comparison Tabs ──────────────────────────────────────────────────
  document.querySelectorAll('[data-tab-group]').forEach(container => {
    const groupId = container.getAttribute('data-tab-group');
    const buttons = container.querySelectorAll(`.tab-btn[data-tab-group="${groupId}"]`);
    const panels = container.querySelectorAll(`[id^="tab-panel-${groupId}-"]`);
    const underline = container.querySelector('.tab-underline');

    function activateTab(index) {
      buttons.forEach((btn, i) => {
        const active = i === index;
        btn.setAttribute('aria-selected', String(active));
        btn.style.color = active ? 'var(--black)' : 'rgba(58,58,58,0.6)';
        btn.style.fontWeight = active ? '700' : '600';
      });
      panels.forEach((panel, i) => {
        panel.classList.toggle('hidden', i !== index);
      });
      // Move underline
      if (underline && buttons[index]) {
        const btn = buttons[index];
        underline.style.left = btn.offsetLeft + 'px';
        underline.style.width = btn.offsetWidth + 'px';
      }
    }

    buttons.forEach((btn, i) => {
      btn.addEventListener('click', () => activateTab(i));
    });

    // Initialize
    activateTab(0);
  });

  // ── Quick Answer Copy ────────────────────────────────────────────────
  const copyBtn = document.getElementById('copy-answer-btn');
  const copyTooltip = document.getElementById('copy-tooltip');
  const answerText = document.getElementById('quick-answer-text');

  if (copyBtn && answerText) {
    copyBtn.addEventListener('click', async function() {
      try {
        await navigator.clipboard.writeText(answerText.textContent || '');
        if (copyTooltip) {
          copyTooltip.classList.remove('hidden');
          setTimeout(() => copyTooltip.classList.add('hidden'), 2000);
        }
      } catch (err) {
        // Clipboard API unavailable — fail silently
      }
    });
  }

  // ── Mobile TOC Sheet ─────────────────────────────────────────────────
  const mobileTocBtn = document.getElementById('mobile-toc-btn');
  const mobileTocSheet = document.getElementById('mobile-toc-sheet');
  const mobileTocBackdrop = document.getElementById('mobile-toc-backdrop');
  const mobileTocClose = document.getElementById('mobile-toc-close');

  function openMobileToc() {
    if (!mobileTocSheet || !mobileTocBackdrop) return;
    mobileTocSheet.classList.remove('hidden');
    mobileTocBackdrop.classList.remove('hidden');
    requestAnimationFrame(() => {
      mobileTocSheet.style.transform = 'translateY(0)';
    });
    if (mobileTocBtn) mobileTocBtn.setAttribute('aria-expanded', 'true');
  }

  function closeMobileToc() {
    if (!mobileTocSheet || !mobileTocBackdrop) return;
    mobileTocSheet.style.transform = 'translateY(100%)';
    mobileTocSheet.addEventListener('transitionend', function hide() {
      mobileTocSheet.classList.add('hidden');
      mobileTocBackdrop.classList.add('hidden');
      mobileTocSheet.removeEventListener('transitionend', hide);
    });
    if (mobileTocBtn) mobileTocBtn.setAttribute('aria-expanded', 'false');
  }

  if (mobileTocBtn) mobileTocBtn.addEventListener('click', openMobileToc);
  if (mobileTocClose) mobileTocClose.addEventListener('click', closeMobileToc);
  if (mobileTocBackdrop) mobileTocBackdrop.addEventListener('click', closeMobileToc);

  // Close mobile TOC when a link is clicked
  document.querySelectorAll('.mobile-toc-link').forEach(link => {
    link.addEventListener('click', closeMobileToc);
  });

  // Show mobile TOC button after hero
  if (mobileTocBtn) {
    const heroEl = document.getElementById('hero');
    const showObserver = new IntersectionObserver(entries => {
      const heroVisible = entries[0].isIntersecting;
      mobileTocBtn.style.opacity = heroVisible ? '0' : '1';
      mobileTocBtn.style.pointerEvents = heroVisible ? 'none' : 'auto';
    }, { threshold: 0 });
    if (heroEl) showObserver.observe(heroEl);
  }


})();
</script>

</body>
</html>
