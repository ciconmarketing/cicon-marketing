---
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import BlogHero from '../../components/blog/index/BlogHero.astro';
import CategoryFilter from '../../components/blog/index/CategoryFilter.astro';
import PostGrid from '../../components/blog/index/PostGrid.astro';
import Pagination from '../../components/blog/index/Pagination.astro';
import EndCtaIndex from '../../components/blog/index/EndCtaIndex.astro';
import { getBlogIndexData } from '../../lib/sanity';
import { FALLBACK_CATEGORIES } from '../../lib/blog-fallback';
import { WEBSITE_CICON, ORG_CICON } from '../../lib/schema-constants';
import type { BlogPost, BlogCategory } from '../../lib/sanity';
import '../../styles/globals.css';

// SSR — rendered at request time so page count always matches live Sanity data.
// getStaticPaths was removed because it ran at build time with a stale post count,
// causing page/2/ to 404 whenever posts were added between deploys.
export const prerender = false;

const isPreview = import.meta.env.VERCEL_ENV !== 'production';

const { page } = Astro.params;
const pageNum = parseInt(page ?? '2', 10);

// Reject non-numeric or page 1 (handled by index.astro)
if (isNaN(pageNum) || pageNum < 2) {
  return Astro.redirect('/blog/', 301);
}

const PER_PAGE = 12;

let posts: BlogPost[] = [];
let categories: BlogCategory[] = [];
let totalPosts = 0;
let hasFeatured = false;

try {
  const data = await getBlogIndexData(pageNum, PER_PAGE);
  totalPosts = data.totalPosts;
  hasFeatured = !!data.featured;
  if (data.posts.length > 0) {
    posts = data.posts;
    categories = data.categories;
  } else {
    categories = FALLBACK_CATEGORIES;
  }
} catch {
  categories = FALLBACK_CATEGORIES;
}

// Mirror the same logic as index.astro: featured post is outside the grid,
// so only non-featured posts are paginated.
const nonFeaturedCount = hasFeatured ? Math.max(0, totalPosts - 1) : totalPosts;
const totalPages = Math.max(1, Math.ceil(nonFeaturedCount / PER_PAGE));

// Redirect out-of-bounds pages to /blog/ rather than rendering an empty grid
if (pageNum > totalPages) {
  return Astro.redirect('/blog/', 301);
}

const pageUrl = `https://cicon.ca/blog/page/${pageNum}/`;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'CollectionPage', '@id': `${pageUrl}#collectionpage`, url: pageUrl, name: `Field Notes on Modern Marketing — Page ${pageNum}`, isPartOf: { '@id': 'https://cicon.ca/#website' }, inLanguage: 'en-CA' },
    WEBSITE_CICON, ORG_CICON,
  ],
};
---

<!DOCTYPE html>
<html lang="en-CA">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Blog (Page {pageNum}) — CiCon Marketing</title>
  <meta name="description" content={`Browse the CiCon Marketing blog archive — page ${pageNum}.`} />
  <link rel="canonical" href={pageUrl} />
  {pageNum > 1 && <link rel="prev" href={pageNum === 2 ? 'https://cicon.ca/blog/' : `https://cicon.ca/blog/page/${pageNum - 1}/`} />}
  {pageNum < totalPages && <link rel="next" href={`https://cicon.ca/blog/page/${pageNum + 1}/`} />}
  {isPreview
    ? <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
    : <meta name="robots" content="index, follow" />
  }
  <!-- Fonts: self-hosted via @fontsource-variable/inter in globals.css (no CDN, no render-block) -->
  <link rel="stylesheet" href="https://unpkg.com/aos@2.3.4/dist/aos.css" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <!-- Google Tag Manager (lazy: loads after 3.5 s or first user interaction) -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    window.gtag = gtag;
    (function () {
      function loadGTM() {
        if (window._gtmLoaded) return;
        window._gtmLoaded = true;
        (function(w,d,s,l,i){
          w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});
          var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';
          j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;
          f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','GTM-NH5ZSMKJ');
      }
      setTimeout(loadGTM, 3500);
      ['click','keydown','mousemove','touchstart','scroll'].forEach(function(ev){
        window.addEventListener(ev, loadGTM, {once:true, passive:true});
      });
    })();
  </script>
  <!-- End Google Tag Manager -->
  <!-- Meta Pixel Code -->
  <script is:inline>
  !function(f,b,e,v,n,t,s)
  {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
  n.callMethod.apply(n,arguments):n.queue.push(arguments)};
  if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
  n.queue=[];t=b.createElement(e);t.async=!0;
  t.src=v;s=b.getElementsByTagName(e)[0];
  s.parentNode.insertBefore(t,s)}(window, document,'script',
  'https://connect.facebook.net/en_US/fbevents.js');
  fbq('init', '1299226945517753');
  fbq('track', 'PageView');
  </script>
  <noscript><img height="1" width="1" style="display:none"
  src="https://www.facebook.com/tr?id=1299226945517753&ev=PageView&noscript=1"/></noscript>
  <!-- End Meta Pixel Code -->
</head>
<body class="font-sans bg-gray-50 text-gray-900 antialiased">
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NH5ZSMKJ"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->
  <Nav />
  <BlogHero />
  <CategoryFilter categories={categories} />
  <PostGrid posts={posts} categories={categories} />
  <Pagination currentPage={pageNum} totalPages={totalPages} />
  <EndCtaIndex />
  <Footer />
  <script is:inline src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
  <script is:inline>if (typeof AOS !== 'undefined') AOS.init({ duration: 600, easing: 'ease-out-cubic', once: true, offset: 60 });</script>
</body>
</html>
