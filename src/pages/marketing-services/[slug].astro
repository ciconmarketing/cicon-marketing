---
/**
 * /services/[slug]/ — Service spoke page.
 * Dynamically renders one servicePage document from Sanity.
 * Section order: Hero → StickyBar → PAA → AntiPitch →
 * Capabilities → [Dental: CDCP + Channels] → Process →
 * EeatBlock → FAQ → RelatedServices → RelatedPosts → FinalCta
 */
import '../../styles/globals.css';
import { getServicePage, ALL_SERVICE_SLUGS_QUERY } from '../../lib/sanity'
import { ORG_CICON, PERSON_MAJID, WEBSITE_CICON, REVIEW_COUNT } from '../../lib/schema-constants'
import Nav                 from '../../components/Nav.astro'
import Footer              from '../../components/Footer.astro'
import ServiceHero         from '../../components/services/ServiceHero.astro'
import PaaBlock            from '../../components/services/PaaBlock.astro'
import AntiPitch           from '../../components/services/AntiPitch.astro'
import CapabilitiesGrid    from '../../components/services/CapabilitiesGrid.astro'
import ProcessStrip        from '../../components/services/ProcessStrip.astro'
import EeatBlock           from '../../components/services/EeatBlock.astro'
import ServiceFaq          from '../../components/services/ServiceFaq.astro'
import RelatedServices     from '../../components/services/RelatedServices.astro'
import RelatedPosts        from '../../components/services/RelatedPosts.astro'
import FinalCta            from '../../components/services/FinalCta.astro'
import GoogleReviews       from '../../components/react/GoogleReviews.tsx'
import CdcpBlock           from '../../components/services/dental/CdcpBlock.astro'
import PatientChannels     from '../../components/services/dental/PatientChannels.astro'

// ── Static paths ──────────────────────────────────────────────────────────────
export async function getStaticPaths() {
  // Import getSanityClient directly for the slug list
  const { createClient } = await import('@sanity/client')
  const projectId = (import.meta.env.PUBLIC_SANITY_PROJECT_ID ?? '').trim()
  const dataset   = (import.meta.env.PUBLIC_SANITY_DATASET ?? 'production').trim()
  if (!projectId) return []
  const client = createClient({ projectId, dataset, useCdn: false, apiVersion: '2024-01-01' })
  const slugs: Array<{ slug: string }> = await client.fetch(ALL_SERVICE_SLUGS_QUERY).catch(() => [])
  return slugs.map((s) => ({ params: { slug: s.slug } }))
}

// ── Data ──────────────────────────────────────────────────────────────────────
const { slug } = Astro.params
const page = await getServicePage(slug)

if (!page) {
  return Astro.redirect('/marketing-services/', 307)
}

const isPreview = import.meta.env.VERCEL_ENV !== 'production'
const canonicalUrl = page.canonical ?? `https://cicon.ca/marketing-services/${slug}/`
const isDental = page.serviceType === 'dental'

// ── Schema.org ────────────────────────────────────────────────────────────────
const areaServed = (page.areaServed ?? ['Richmond Hill', 'Toronto', 'Markham', 'Vaughan', 'North York', 'Greater Toronto Area'])
  .map((name: string) => ({ '@type': 'City', name }))

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    // Organization (imported constant)
    ORG_CICON,
    // Person
    PERSON_MAJID,
    // WebSite
    WEBSITE_CICON,
    // Service
    {
      '@type': 'Service',
      '@id': `${canonicalUrl}#service`,
      name: page.title,
      description: page.metaDescription ?? page.heroDescription ?? '',
      provider: { '@id': 'https://cicon.ca/#organization' },
      ...(page.serviceTypeSchema && { serviceType: page.serviceTypeSchema }),
      areaServed,
      offers: {
        '@type': 'Offer',
        name: 'Chat on WhatsApp',
        price: 0,
        priceCurrency: 'CAD',
        description: 'Free WhatsApp consultation with our senior strategist',
      },
    },
    // FAQPage
    ...(page.faqs?.length ? [{
      '@type': 'FAQPage',
      '@id': `${canonicalUrl}#faq`,
      mainEntity: page.faqs.map((faq: { question: string; answer: string }) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    }] : []),
    // BreadcrumbList
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home',     item: 'https://cicon.ca/' },
        { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://cicon.ca/marketing-services/' },
        { '@type': 'ListItem', position: 3, name: page.title },
      ],
    },
    // AggregateRating (agency-level)
    {
      '@type': 'AggregateRating',
      '@id': 'https://cicon.ca/#aggregaterating',
      itemReviewed: { '@id': 'https://cicon.ca/#organization' },
      ratingValue: '5.0',
      reviewCount: REVIEW_COUNT,
    },
  ],
}
---

<!DOCTYPE html>
<html lang="en-CA">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{page.metaTitle ?? `${page.title} | CiCon Marketing — GTA`}</title>
  <meta name="description" content={page.metaDescription ?? page.heroDescription ?? ''} />
  <link rel="canonical" href={canonicalUrl} />
  {isPreview
    ? <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
    : <meta name="robots" content="index, follow" />
  }

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={page.metaTitle ?? `${page.title} | CiCon Marketing`} />
  <meta property="og:description" content={page.metaDescription ?? page.heroDescription ?? ''} />
  <meta property="og:image" content={page.heroImage?.asset?.url ?? 'https://cicon.ca/logo-cicon.jpg'} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={page.metaTitle ?? `${page.title} | CiCon Marketing`} />
  <meta name="twitter:description" content={page.metaDescription ?? page.heroDescription ?? ''} />
  <meta name="twitter:image" content={page.heroImage?.asset?.url ?? 'https://cicon.ca/logo-cicon.jpg'} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- Brand tokens -->
  <style>
    :root {
      --action:    #FFCF00;
      --accent:    #9D833E;
      --shadow:    #212129;
      --alabaster: #E7E7E7;
      --off-white: #FAFAFA;
      --charcoal:  #3A3A3A;
      --black:     #000;
    }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: 'Inter', sans-serif; background: var(--off-white); color: var(--charcoal); }
    h1, h2, h3, h4, h5, h6 { font-family: 'Inter', sans-serif; }
    /* FAQ summary marker removal */
    details > summary { list-style: none; }
    details > summary::-webkit-details-marker { display: none; }
  </style>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

  <!-- Google Tag Manager -->
  <script is:inline>
  (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-NH5ZSMKJ');
  </script>
  <!-- End Google Tag Manager -->
  <!-- Meta Pixel Code -->
  <script is:inline>
  !function(f,b,e,v,n,t,s)
  {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
  n.callMethod.apply(n,arguments):n.queue.push(arguments)};
  if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
  n.queue=[];t=b.createElement(e);t.async=!0;
  t.src=v;s=b.getElementsByTagName(e)[0];
  s.parentNode.insertBefore(t,s)}(window, document,'script',
  'https://connect.facebook.net/en_US/fbevents.js');
  fbq('init', '1299226945517753');
  fbq('track', 'PageView');
  </script>
  <noscript><img height="1" width="1" style="display:none"
  src="https://www.facebook.com/tr?id=1299226945517753&ev=PageView&noscript=1"/></noscript>
  <!-- End Meta Pixel Code -->
</head>

<body>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NH5ZSMKJ"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->

  <Nav />

  <ServiceHero
    badge={page.heroBadge}
    headline={page.heroHeadline}
    subheadline={page.heroSubheadline}
    description={page.heroDescription}
    stats={page.heroStats}
    serviceName={page.title}
    heroImage={page.heroImage}
  />

  {page.paaQuestions?.length && (
    <PaaBlock questions={page.paaQuestions} />
  )}

  {page.antiPitchItems?.length && (
    <AntiPitch
      headline={page.antiPitchHeadline}
      items={page.antiPitchItems}
    />
  )}

  {page.capabilities?.length && (
    <CapabilitiesGrid
      headline={page.capabilitiesHeadline}
      intro={page.capabilitiesIntro}
      capabilities={page.capabilities}
    />
  )}

  {isDental && (
    <CdcpBlock
      headline={page.cdcpBlock?.headline}
      body={page.cdcpBlock?.body}
      bullets={page.cdcpBlock?.bullets}
    />
  )}

  {isDental && (
    <PatientChannels channels={page.patientChannels} />
  )}

  <ProcessStrip steps={page.processSteps} />

  <EeatBlock
    headline={page.eeatHeadline}
    body={page.eeatBody}
    stats={page.eeatStats}
  />

  {page.faqs?.length && (
    <ServiceFaq faqs={page.faqs} pageUrl={canonicalUrl} />
  )}

  {page.relatedServices?.length && (
    <RelatedServices services={page.relatedServices} />
  )}

  {page.relatedPosts?.length && (
    <RelatedPosts posts={page.relatedPosts} />
  )}

  <GoogleReviews client:visible />

  <FinalCta
    headline={page.finalCtaHeadline}
    body={page.finalCtaBody}
    serviceName={page.title}
  />

  <Footer />

</body>
</html>
