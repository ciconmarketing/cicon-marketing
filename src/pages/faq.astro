const ALL_FAQS = FAQ_GROUPS.flatMap(g => g.items);

/**
 * Schema-safe serializer: turns an answer's inline HTML into the exact plain
 * text a visitor reads.
 *
 * Anchor *text* is kept (it is visible copy — dropping it would silently
 * remove words from the answer) while the markup and href are discarded, so
 * FAQPage.mainEntity never contains links or markup the user cannot see.
 * Entities are decoded so "&amp;" does not reach the JSON-LD as literal
 * markup, and whitespace is collapsed to match the rendered paragraph.
 *
 * Deliberately a small explicit pipeline rather than a single regex replace:
 * the tag strip runs only after anchors have been unwrapped, so no anchor
 * text can be swallowed.
 */
function faqAnswerToPlainText(html: string): string {
  if (typeof html !== 'string' || !html) return '';
  return html
    .replace(/<a\b[^>]*>(.*?)<\/a>/gis, '$1')  // unwrap links, keep their text
    .replace(/<br\s*\/?>/gi, ' ')
    .replace(/<[^>]+>/g, '')                    // strip any remaining markup
    .replace(/&nbsp;/g, ' ')
    .replace(/&amp;/g, '&')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&#39;|&apos;/g, "'")
    .replace(/\s+/g, ' ')
    .trim();
}

// ── JSON-LD ────────────────────────────────────────────────────────────────────
// Four entities here; the fifth (LocalBusiness) is emitted sitewide by
// <Footer />, so the page must not declare its own or the two would conflict.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    ORG_CICON,
    WEBSITE_CICON,
    {
      '@type': 'FAQPage',
      '@id': `${canonicalUrl}#faqpage`,
      url: canonicalUrl,
      name: 'Digital Marketing, SEO & Lead Generation FAQs | CiCon Marketing',
      description: 'Answers for service businesses across Toronto, Richmond Hill and the GTA about local and AI SEO, Google Ads, social media, dental marketing, web design, content, media production and lead generation.',
      inLanguage: 'en-CA',
      isPartOf: { '@id': 'https://cicon.ca/#website' },
      about: { '@id': 'https://cicon.ca/#organization' },
      publisher: { '@id': 'https://cicon.ca/#organization' },
      breadcrumb: { '@id': `${canonicalUrl}#breadcrumb` },
      mainEntity: ALL_FAQS.map(f => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: faqAnswerToPlainText(f.answerHtml) },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://cicon.ca/' },
        { '@type': 'ListItem', position: 2, name: 'FAQ',  item: canonicalUrl },
      ],
    },
  ],
};

const LAST_UPDATED = 'August 22, 2026';
