        Digital Marketing, SEO &amp; Lead Generation FAQs
      </h1>
      <h2 class="font-heading" style="font-size:clamp(1.1rem,2vw,1.375rem);font-weight:600;color:rgba(255,255,255,0.8);margin:0 0 24px;">
        Practical answers for service businesses across Toronto, Richmond Hill and the GTA
      </h2>
      <p style="font-size:1.05rem;line-height:1.72;color:rgba(255,255,255,0.75);margin:0 0 12px;">
        Answers to the questions we hear most from local service businesses, dental clinics, home-service companies and growth-focused teams across the Greater Toronto Area — covering SEO and AI search, paid advertising, social media, web design and conversion, content, and media production. Don't see your question? <a href="https://wa.me/16475840800" style="color:#fff;text-decoration:underline;">Message us on WhatsApp</a> and a senior strategist will help.
      </p>
      <p style="font-size:0.85rem;color:rgba(255,255,255,0.45);margin:0;">Last updated: {LAST_UPDATED}</p>
    </div>
  </section>

  <!-- FAQ groups -->
  <main>
    <section style="padding:56px 0 88px;background:#fff;">
      <div class="container-xl" style="max-width:800px;">
        {FAQ_GROUPS.map((group, gi) => (
          <div style={gi > 0 ? 'margin-top:48px;' : ''}>
            <h2 class="font-heading" style="font-size:clamp(1.25rem,2.5vw,1.6rem);font-weight:800;color:#000;letter-spacing:-0.01em;margin:0 0 20px;">
              {group.category}
            </h2>
            <div style="display:flex;flex-direction:column;gap:10px;">
              {group.items.map((faq, fi) => {
                const idx = `${gi}-${fi}`;
                return (
                  <div class="faq-item">
                    <button
                      class="faq-toggle"
                      aria-expanded="false"
                      aria-controls={`faq-answer-${idx}`}
                      id={`faq-question-${idx}`}
                    >
                      <span>{faq.question}</span>
                      <svg class="faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                        <polyline points="6 9 12 15 18 9"/>
                      </svg>
                    </button>
                    <div id={`faq-answer-${idx}`} class="faq-answer" role="region" aria-labelledby={`faq-question-${idx}`}>
                      <div class="faq-answer-inner">
                        <p set:html={faq.answerHtml} />
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>

  <Footer />

  <script>
    // ── FAQ Accordion — content is always in the DOM; only visually collapsed ──
    document.querySelectorAll('.faq-toggle').forEach((btn) => {
      btn.addEventListener('click', function () {
        const expanded = this.getAttribute('aria-expanded') === 'true';
        const answerId = this.getAttribute('aria-controls');
        const answer = answerId ? document.getElementById(answerId) : null;
        const chevron = this.querySelector('.faq-chevron');

        this.setAttribute('aria-expanded', String(!expanded));
        if (answer) answer.classList.toggle('open', !expanded);
        if (chevron) chevron.style.transform = expanded ? '' : 'rotate(180deg)';
      });
    });
  </script>
</body>
</html>
