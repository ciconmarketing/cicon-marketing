---
/**
 * /redesign-preview — "THE SYSTEM, SEALED"
 *
 * Full creative reset: the page is the funnel. A lead enters the top of the
 * page as scattered amber light and leaks away; scrolling is the repair.
 * Seven schematic chapters — LEAK → DIAGNOSIS → SYSTEM → METHOD → WHO →
 * PROOF → SEAL — indexed by a fixed instrument spine; by the final chapter
 * the light converges into a drawn seal ring around the WhatsApp CTA.
 *
 * Presentation layer only: all copy verbatim from the live homepage, flowing
 * through the exact same Sanity queries + defaults. The live `/` and its
 * components are untouched. Permanently noindex; preview deploys only.
 */
import XNav from '../components/redesign/experience/XNav.astro';
import XSpine from '../components/redesign/experience/XSpine.astro';
import XFooter from '../components/redesign/experience/XFooter.astro';
import ChLeak from '../components/redesign/experience/ChLeak.astro';
import ChDiagnosis from '../components/redesign/experience/ChDiagnosis.astro';
import ChSystem from '../components/redesign/experience/ChSystem.astro';
import ChMethod from '../components/redesign/experience/ChMethod.astro';
import ChWho from '../components/redesign/experience/ChWho.astro';
import ChProof from '../components/redesign/experience/ChProof.astro';
import ChSeal from '../components/redesign/experience/ChSeal.astro';
import '../styles/globals.css';

import { getHomepage, getTrustedByMarquee, getWhyCiconCards } from '../lib/sanity';
import { defaultHomepageData, defaultTrustedByMarquee } from '../lib/defaults';
import type { HomepageData, TrustedByMarqueeData } from '../lib/types';

// Same content sources as the live homepage: Sanity first, defaults fallback.
let data: HomepageData = defaultHomepageData;
let trustedBy: TrustedByMarqueeData = defaultTrustedByMarquee;
let whyCiconCards = {
  eyebrow: 'WHY CICON',
  heading: 'Three things every account gets',
  cards: [
    { label: 'THE OPERATOR', heading: 'Senior strategy on every account', body: "You get direct access to the strategist who built your system — not an account coordinator reading dashboards. Senior-level thinking, every call, every quarter." },
    { label: 'THE METHOD',   heading: 'A documented 90-day system',        body: "Every engagement runs on a documented 90-day cycle: audit, roadmap, build, and quarterly business review. No guesswork, no scope creep, no surprises." },
    { label: 'THE FOOTPRINT',heading: 'Local GTA market knowledge',        body: "14+ years operating in GTA markets means the campaigns we build reflect real local search behaviour — not borrowed playbooks written for other cities." },
  ],
};
try {
  const [sanityData, sanityTrustedBy, sanityWhyCards] = await Promise.all([
    getHomepage(),
    getTrustedByMarquee(),
    getWhyCiconCards(),
  ]);
  if (sanityData?.hero?.headline) data = sanityData;
  if (sanityTrustedBy?.logos?.length) trustedBy = sanityTrustedBy;
  if (sanityWhyCards?.heading) whyCiconCards = { ...whyCiconCards, ...sanityWhyCards };
} catch {
  // Sanity not configured – using defaults is fine
}

// Live contact facts (the stale defaults predate the current site; the phone
// display is an immutable brand fact).
const contactData = {
  ...data.contact,
  phone: '+1 (289) 807-1020',
  email: data.contact.email === 'hello@cicon.ca' ? 'info@cicon.ca' : data.contact.email,
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Homepage Redesign — The System, Sealed | CiCon Marketing</title>
  <meta name="description" content="Internal design experiment. Not a public page." />
  <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
  <link rel="icon" type="image/png" sizes="120x120" href="/logo-cicon-120.png" />
  <meta name="theme-color" content="#0E0E14" />

  <!-- Heading + mono weights — preloaded so type paints without a flash -->
  <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/ClashDisplay-Semibold.woff2" />
  <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/SpaceMono-Bold.woff2" />

  <!-- Self-hosted fonts + the two design-system layers. All served from
       /public so they stay outside the Tailwind content scan and Vite's CSS
       chunk graph — live pages' compiled CSS cannot be perturbed. -->
  <link rel="stylesheet" href="/fonts/fonts.css" />
  <link rel="stylesheet" href="/redesign/redesign.css" />
  <link rel="stylesheet" href="/redesign/experience.css" />
</head>

<body class="font-sans antialiased rd-page x-page">
  <a class="x-skip" href="#main">Skip to content</a>

  <XNav />
  <XSpine />

  <main id="main">
    <ChLeak />
    <ChDiagnosis data={data.problemsSolved} />
    <ChSystem data={data.services} />
    <ChMethod data={data.howItWorks} whyCards={whyCiconCards} />
    <ChWho data={data.whoWeServe} />
    <ChProof data={data.whyCicon} trustedBy={trustedBy} />
    <ChSeal data={data.readyToGrow} contact={contactData} />
  </main>

  <XFooter />

  <script>
    /**
     * Motion boot: adds the .rd-motion gate (reveal initial states apply only
     * under it) and lazy-loads the experience runtime after first paint.
     * Reduced-motion users never get the gate — the page is fully static.
     * If the runtime fails to load, the gate is removed so nothing stays put
     * at opacity 0.
     */
    const motionOK = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;
    const forceStatic = new URLSearchParams(window.location.search).has('static');
    if (motionOK && !forceStatic) {
      document.documentElement.classList.add('rd-motion');
      const boot = () =>
        import('../components/redesign/motion/experience')
          .then((m) => m.initExperience())
          .catch((err) => {
            console.warn('[x] experience runtime failed, reverting to static', err);
            document.documentElement.classList.remove('rd-motion');
          });
      if ('requestIdleCallback' in window) {
        requestIdleCallback(boot, { timeout: 1200 });
      } else {
        setTimeout(boot, 200);
      }
    }
  </script>
</body>
</html>
