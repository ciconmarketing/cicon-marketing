---
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import WhyCiCon from '../components/WhyCiCon.astro';
import ResultsShowcase from '../components/react/ResultsShowcase.tsx';
import Services from '../components/Services.astro';
import WhoWeServe from '../components/WhoWeServe.astro';
import HowItWorks from '../components/HowItWorks.astro';
import ProblemsSolved from '../components/ProblemsSolved.astro';
import GoogleReviews from '../components/react/GoogleReviews.tsx';
import ReadyToGrow from '../components/ReadyToGrow.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import ToolsStrip from '../components/home/ToolsStrip.astro';
import TrustedByMarquee from '../components/home/TrustedByMarquee.astro';
import ScrollProgress from '../components/react/ScrollProgress.tsx';
import '../styles/globals.css';

import { getHomepage, getTrustedByMarquee, getWhyCiconCards } from '../lib/sanity';
import { ORG_CICON, WEBSITE_CICON } from '../lib/schema-constants';
import { defaultHomepageData, defaultTrustedByMarquee } from '../lib/defaults';
import type { HomepageData, TrustedByMarqueeData } from '../lib/types';

// Block indexing on Vercel preview builds; allow on production (cicon.ca).
// Vercel sets VERCEL_ENV='production' for the production build only.
const isPreview = import.meta.env.VERCEL_ENV !== 'production'

// Try Sanity first, fall back to hard-coded defaults
let data: HomepageData = defaultHomepageData;
let trustedBy: TrustedByMarqueeData = defaultTrustedByMarquee;
let whyCiconCards = {
  eyebrow: 'WHY CICON',
  heading: 'Three things every account gets',
  cards: [
    { label: 'THE OPERATOR', heading: 'Senior strategy on every account', body: "You get direct access to the strategist who built your system — not an account coordinator reading dashboards. Senior-level thinking, every call, every quarter." },
    { label: 'THE METHOD',   heading: 'A documented 90-day system',        body: "Every engagement runs on a documented 90-day cycle: audit, roadmap, build, and quarterly business review. No guesswork, no scope creep, no surprises." },
    { label: 'THE FOOTPRINT',heading: 'Local GTA market knowledge',        body: "14+ years operating in GTA markets means the campaigns we build reflect real local search behaviour — not borrowed playbooks written for other cities." },
  ],
};
try {
  const [sanityData, sanityTrustedBy, sanityWhyCards] = await Promise.all([
    getHomepage(),
    getTrustedByMarquee(),
    getWhyCiconCards(),
  ]);
  if (sanityData?.hero?.headline) data = sanityData;
  if (sanityTrustedBy?.logos?.length) trustedBy = sanityTrustedBy;
  if (sanityWhyCards?.heading) whyCiconCards = { ...whyCiconCards, ...sanityWhyCards };
} catch {
  // Sanity not configured – using defaults is fine
}
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Primary Meta -->
  <title>CiCon Marketing | Digital Marketing Agency, Richmond Hill GTA</title>
  <meta name="description" content="Boutique digital marketing agency in Richmond Hill. Turning ad spend into real leads for GTA businesses and dental clinics. 14+ years." />
  <meta name="keywords" content="digital marketing agency Richmond Hill, GTA marketing agency, Google Ads, SEO, dental marketing, social media marketing" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://cicon.ca/" />
  <meta property="og:title" content="CiCon Marketing | Digital Marketing Agency, Richmond Hill GTA" />
  <meta property="og:description" content="Boutique digital marketing agency in Richmond Hill. Turning ad spend into real leads for GTA businesses and dental clinics." />
  <meta property="og:image" content="https://cicon.ca/logo-cicon.jpg" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="CiCon Marketing | Digital Marketing Agency, Richmond Hill GTA" />
  <meta name="twitter:description" content="Boutique digital marketing agency in Richmond Hill. Turning ad spend into real leads for GTA businesses and dental clinics. 14+ years." />
  <meta name="twitter:image" content="https://cicon.ca/logo-cicon.jpg" />

  <!-- Canonical -->
  <link rel="canonical" href="https://cicon.ca/" />
  {isPreview
    ? <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
    : <meta name="robots" content="index, follow" />
  }

  <!-- AOS – Animate On Scroll (non-blocking: preload as style, swap rel on load) -->
  <link rel="preload" href="https://unpkg.com/aos@2.3.4/dist/aos.css" as="style"
        onload="this.onload=null;this.rel='stylesheet'" />
  <noscript><link rel="stylesheet" href="https://unpkg.com/aos@2.3.4/dist/aos.css" /></noscript>

  <!-- Favicon -->
  <link rel="icon" type="image/png" sizes="120x120" href="/logo-cicon-120.png" />

  <!-- Schema.org structured data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      ORG_CICON,
      WEBSITE_CICON,
      {
        '@type': 'LocalBusiness',
        '@id': 'https://cicon.ca/#local-business',
        name: 'CiCon Marketing',
        url: 'https://cicon.ca/',
        telephone: '+1-289-807-1020',
        email: 'hello@cicon.ca',
        logo: { '@type': 'ImageObject', url: 'https://cicon.ca/logo-cicon.jpg' },
        image: 'https://cicon.ca/logo-cicon.jpg',
        address: {
          '@type': 'PostalAddress',
          streetAddress: '131 Golf Club Ct',
          addressLocality: 'Richmond Hill',
          addressRegion: 'ON',
          postalCode: 'L4C 5E1',
          addressCountry: 'CA',
        },
        geo: {
          '@type': 'GeoCoordinates',
          latitude: 43.8828,
          longitude: -79.4403,
        },
        openingHoursSpecification: [
          {
            '@type': 'OpeningHoursSpecification',
            dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'],
            opens: '09:00',
            closes: '18:00',
          },
        ],
        priceRange: '$$',
        areaServed: { '@type': 'AdministrativeArea', name: 'Greater Toronto Area' },
        sameAs: ORG_CICON.sameAs,
      },
    ],
  })} />

  <!-- Google Tag Manager (lazy: loads after 3.5 s or first user interaction) -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    window.gtag = gtag;
    (function () {
      function loadGTM() {
        if (window._gtmLoaded) return;
        window._gtmLoaded = true;
        (function(w,d,s,l,i){
          w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});
          var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';
          j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;
          f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','GTM-NH5ZSMKJ');
      }
      setTimeout(loadGTM, 3500);
      ['click','keydown','mousemove','touchstart','scroll'].forEach(function(ev){
        window.addEventListener(ev, loadGTM, {once:true, passive:true});
      });
    })();
  </script>
  <!-- End Google Tag Manager -->
  <!-- Meta Pixel (lazy: fbq stub queues calls immediately; fbevents.js loads after 3.5s or first interaction) -->
  <link rel="preconnect" href="https://connect.facebook.net" crossorigin />
  <script is:inline>
    !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){
    n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
    fbq('init','1299226945517753');
    fbq('track','PageView');
    (function(){
      function loadPixel(){
        if(window._fbqLoaded)return;window._fbqLoaded=true;
        var s=document.createElement('script');s.async=true;
        s.src='https://connect.facebook.net/en_US/fbevents.js';
        document.head.appendChild(s);
      }
      setTimeout(loadPixel,3500);
      ['click','keydown','mousemove','touchstart','scroll'].forEach(function(ev){
        window.addEventListener(ev,loadPixel,{once:true,passive:true});
      });
    })();
  </script>
  <noscript><img height="1" width="1" style="display:none"
  src="https://www.facebook.com/tr?id=1299226945517753&ev=PageView&noscript=1"/></noscript>
  <!-- End Meta Pixel -->
</head>

<body class="font-sans bg-white text-gray-900 antialiased">
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NH5ZSMKJ"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->

  <!-- Scroll progress bar — client:idle defers until after first paint -->
  <ScrollProgress client:idle />

  <Nav />

  <main>
    <Hero           data={data.hero} />
    <ToolsStrip />
    <WhyCiCon       data={data.whyCicon} />
    <ResultsShowcase client:visible />

    <!-- ── WHY CICON CARDS — Three things every account gets ── -->
    <section aria-labelledby="why-cicon-cards-h2" style="padding:80px 0 96px;background:#fff;">
      <div class="container-xl">
        <p style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.15em;color:#9D833E;margin:0 0 14px;">
          {whyCiconCards.eyebrow}
        </p>
        <h2 id="why-cicon-cards-h2" style="font-size:clamp(1.75rem,3vw,2.5rem);font-weight:900;color:#212129;letter-spacing:-0.02em;line-height:1.12;margin:0 0 52px;">
          {whyCiconCards.heading}
        </h2>
        <div class="hp-why-cards-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:32px;">
          {whyCiconCards.cards.map((card: { label: string; heading: string; body: string }, i: number) => (
            <div style={`background:#FAFAFA;border:1px solid #E7E7E7;border-top:3px solid ${i === 0 ? '#FFCF00' : i === 1 ? '#9D833E' : '#212129'};border-radius:12px;padding:32px 28px 28px;`}>
              <p style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.14em;color:#9D833E;margin:0 0 14px;">
                {card.label}
              </p>
              <h3 style="font-size:1.1rem;font-weight:800;color:#212129;line-height:1.35;margin:0 0 14px;letter-spacing:-0.01em;">
                {card.heading}
              </h3>
              <p style="font-size:0.95rem;line-height:1.7;color:rgba(58,58,58,0.8);margin:0;">
                {card.body}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>
    <style>
      @media (max-width: 767px) {
        .hp-why-cards-grid { grid-template-columns: 1fr !important; }
      }
    </style>

    <Services       data={data.services} />
    <TrustedByMarquee data={trustedBy} />
    <WhoWeServe     data={data.whoWeServe} />
    <HowItWorks     data={data.howItWorks} />
    <ProblemsSolved data={data.problemsSolved} />
    <!-- Social proof section after Problems We Solve -->
    <GoogleReviews  client:visible />
    <ReadyToGrow    data={data.readyToGrow} />
    <Contact        data={data.contact} />
  </main>

  <Footer includeLocalBusinessSchema={false} />

  <!-- Scroll-reveal: add .in-view to .reveal elements as they enter the viewport -->
  <script>
    const observer = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.isIntersecting && e.target.classList.add('in-view')),
      { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
    );
    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
  </script>

  <!-- AOS — loaded idle so it never forces a layout reflow during LCP -->
  <script is:inline>
    (function () {
      function loadAOS() {
        var s = document.createElement('script');
        s.src = 'https://unpkg.com/aos@2.3.4/dist/aos.js';
        s.onload = function () {
          if (typeof AOS !== 'undefined') {
            AOS.init({ duration: 650, easing: 'ease-out-cubic', once: true, offset: 60, delay: 0 });
          }
        };
        s.onerror = function () {
          document.querySelectorAll('[data-aos]').forEach(function (el) {
            el.removeAttribute('data-aos');
            el.removeAttribute('data-aos-delay');
          });
        };
        document.head.appendChild(s);
      }
      // Defer until browser is idle — prevents forced reflow impacting LCP/TBT
      if ('requestIdleCallback' in window) {
        requestIdleCallback(loadAOS, { timeout: 3000 });
      } else {
        setTimeout(loadAOS, 300);
      }
    })();
  </script>

</body>
</html>
