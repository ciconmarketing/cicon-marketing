---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ScrollProgress from '../components/redesign/ScrollProgress.astro';
import '../styles/globals.css';

// Redesign body components ("The Leak, Sealed" — approved on
// /redesign-preview, branch redesign/hero-leak-sealed). Presentation-layer
// swap only: same data fetching below, same head/SEO further down.
import HeroLeakSealed from '../components/redesign/HeroLeakSealed.astro';
import RToolsMarquee from '../components/redesign/sections/RToolsMarquee.astro';
import RStats from '../components/redesign/sections/RStats.astro';
import RMedia from '../components/redesign/sections/RMedia.astro';
import RThreeThings from '../components/redesign/sections/RThreeThings.astro';
import RServices from '../components/redesign/sections/RServices.astro';
import RClientLogos from '../components/redesign/sections/RClientLogos.astro';
import RWhoWeServe from '../components/redesign/sections/RWhoWeServe.astro';
import RHowItWorks from '../components/redesign/sections/RHowItWorks.astro';
import RProblems from '../components/redesign/sections/RProblems.astro';
import RReviews from '../components/redesign/sections/RReviews.astro';
import RFinalCta from '../components/redesign/sections/RFinalCta.astro';
import RContact from '../components/redesign/sections/RContact.astro';

import { getHomepage, getTrustedByMarquee, getWhyCiconCards } from '../lib/sanity';
import { ORG_CICON, WEBSITE_CICON, LOCAL_BUSINESS_CICON, RATING_VALUE, REVIEW_COUNT } from '../lib/schema-constants';
import { defaultHomepageData, defaultTrustedByMarquee } from '../lib/defaults';
import type { HomepageData, TrustedByMarqueeData } from '../lib/types';

// Block indexing on Vercel preview builds; allow on production (cicon.ca).
// Vercel sets VERCEL_ENV='production' for the production build only.
const isPreview = import.meta.env.VERCEL_ENV !== 'production'

// Try Sanity first, fall back to hard-coded defaults
let data: HomepageData = defaultHomepageData;
let trustedBy: TrustedByMarqueeData = defaultTrustedByMarquee;
let whyCiconCards = {
  eyebrow: 'WHY CICON',
  heading: 'Three things every account gets',
  cards: [
    { label: 'THE OPERATOR', heading: 'Senior strategy on every account', body: "You get direct access to the strategist who built your system — not an account coordinator reading dashboards. Senior-level thinking, every call, every quarter." },
    { label: 'THE METHOD',   heading: 'A documented 90-day system',        body: "Every engagement runs on a documented 90-day cycle: audit, roadmap, build, and quarterly business review. No guesswork, no scope creep, no surprises." },
    { label: 'THE FOOTPRINT',heading: 'Local GTA market knowledge',        body: "14+ years operating in GTA markets means the campaigns we build reflect real local search behaviour — not borrowed playbooks written for other cities." },
  ],
};
try {
  const [sanityData, sanityTrustedBy, sanityWhyCards] = await Promise.all([
    getHomepage(),
    getTrustedByMarquee(),
    getWhyCiconCards(),
  ]);
  if (sanityData?.hero?.headline) data = sanityData;
  if (sanityTrustedBy?.logos?.length) trustedBy = sanityTrustedBy;
  if (sanityWhyCards?.heading) whyCiconCards = { ...whyCiconCards, ...sanityWhyCards };
} catch {
  // Sanity not configured – using defaults is fine
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Primary Meta -->
  <title>CiCon Marketing | Digital Marketing Agency, Richmond Hill GTA</title>
  <meta name="description" content="Boutique digital marketing agency in Richmond Hill. Turning ad spend into real leads for GTA businesses and dental clinics. 14+ years." />
  <meta name="keywords" content="digital marketing agency Richmond Hill, GTA marketing agency, Google Ads, SEO, dental marketing, social media marketing" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://cicon.ca/" />
  <meta property="og:title" content="CiCon Marketing | Digital Marketing Agency, Richmond Hill GTA" />
  <meta property="og:description" content="Boutique digital marketing agency in Richmond Hill. Turning ad spend into real leads for GTA businesses and dental clinics." />
  <meta property="og:image" content="https://cicon.ca/logo-cicon.jpg" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="CiCon Marketing | Digital Marketing Agency, Richmond Hill GTA" />
  <meta name="twitter:description" content="Boutique digital marketing agency in Richmond Hill. Turning ad spend into real leads for GTA businesses and dental clinics. 14+ years." />
  <meta name="twitter:image" content="https://cicon.ca/logo-cicon.jpg" />

  <!-- Canonical -->
  <link rel="canonical" href="https://cicon.ca/" />
  {isPreview
    ? <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
    : <meta name="robots" content="index, follow" />
  }

  <!-- Favicon -->
  <link rel="icon" type="image/png" sizes="120x120" href="/logo-cicon-120.png" />

  <!-- Schema.org structured data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      ORG_CICON,
      WEBSITE_CICON,
      // Canonical LocalBusiness — shared constant so NAP/email/areaServed stay
      // consistent sitewide (Footer skips its copy on this page).
      LOCAL_BUSINESS_CICON,
    ],
  })} />

  <!-- Google Tag Manager (lazy: loads after 3.5 s or first user interaction) -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    window.gtag = gtag;
    (function () {
      function loadGTM() {
        if (window._gtmLoaded) return;
        window._gtmLoaded = true;
        (function(w,d,s,l,i){
          w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});
          var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';
          j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;
          f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','GTM-NH5ZSMKJ');
      }
      setTimeout(loadGTM, 3500);
      ['click','keydown','mousemove','touchstart','scroll'].forEach(function(ev){
        window.addEventListener(ev, loadGTM, {once:true, passive:true});
      });
    })();
  </script>
  <!-- End Google Tag Manager -->
  <!-- Meta Pixel (lazy: fbq stub queues calls immediately; fbevents.js loads after 3.5s or first interaction) -->
  <link rel="preconnect" href="https://connect.facebook.net" crossorigin />
  <script is:inline>
    !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){
    n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
    fbq('init','1299226945517753');
    fbq('track','PageView');
    (function(){
      function loadPixel(){
        if(window._fbqLoaded)return;window._fbqLoaded=true;
        var s=document.createElement('script');s.async=true;
        s.src='https://connect.facebook.net/en_US/fbevents.js';
        document.head.appendChild(s);
      }
      setTimeout(loadPixel,3500);
      ['click','keydown','mousemove','touchstart','scroll'].forEach(function(ev){
        window.addEventListener(ev,loadPixel,{once:true,passive:true});
      });
    })();
  </script>
  <noscript><img height="1" width="1" style="display:none"
  src="https://www.facebook.com/tr?id=1299226945517753&ev=PageView&noscript=1"/></noscript>
  <!-- End Meta Pixel -->

  <!--
    Redesign presentation assets — added for the "Leak, Sealed" body swap.
    No SEO-relevant tag above this line was touched: title, description,
    canonical, robots, OG, Twitter, JSON-LD, favicon, GTM, Pixel are all
    byte-for-byte unchanged. These four lines only load the redesign's
    typography (self-hosted, no font CDN) and section CSS.
  -->
  <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/ClashDisplay-Semibold.woff2" />
  <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/SpaceMono-Bold.woff2" />
  <link rel="stylesheet" href="/fonts/fonts.css" />
  <link rel="stylesheet" href="/redesign/redesign.css" />
</head>

<body class="font-sans antialiased rd-page" style="background:#212129;color:#E7E7E7;">
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NH5ZSMKJ"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->

  {import.meta.env.DEV && (
    <script type="module">
      /**
       * Dev-only Vite/React preamble — see redesign/hero-leak-sealed's
       * HeroLeakSealed particle scene for why this is needed. Compiled away
       * in production (no dev refresh runtime exists there to detect).
       */
      import RefreshRuntime from '/@react-refresh';
      RefreshRuntime.injectIntoGlobalHook(window);
      window.$RefreshReg$ = () => {};
      window.$RefreshSig$ = () => (type) => type;
      window.__vite_plugin_react_preamble_installed__ = true;
    </script>
  )}

  <!-- Scroll progress bar — vanilla, no framework runtime -->
  <ScrollProgress />

  <Nav />

  <main class="rd-page">
    <HeroLeakSealed />
    <RToolsMarquee />
    <RStats data={data.whyCicon} />
    <RMedia />
    <RThreeThings data={whyCiconCards} />
    <RServices data={data.services} />
    <RClientLogos data={trustedBy} />
    <RWhoWeServe data={data.whoWeServe} />
    <RHowItWorks data={data.howItWorks} />
    <RProblems data={data.problemsSolved} />
    <RReviews />
    <RFinalCta data={data.readyToGrow} />
    <RContact data={data.contact} />
  </main>

  <Footer includeLocalBusinessSchema={false} />

  <script>
    /**
     * Motion boot: adds the .rd-motion gate (reveal initial states apply only
     * under it) and lazy-loads the shared motion runtime after first paint.
     * Reduced-motion users never get the gate — the page is fully static.
     * If the runtime fails to load, the gate is removed so nothing stays put
     * at opacity 0.
     */
    const motionOK = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;
    const forceStatic = new URLSearchParams(window.location.search).has('static');
    if (motionOK && !forceStatic) {
      document.documentElement.classList.add('rd-motion');
      const boot = () =>
        import('../components/redesign/motion/motion')
          .then((m) => m.initMotion())
          .catch((err) => {
            console.warn('[rd] motion runtime failed, reverting to static', err);
            document.documentElement.classList.remove('rd-motion');
          });
      if ('requestIdleCallback' in window) {
        requestIdleCallback(boot, { timeout: 1200 });
      } else {
        setTimeout(boot, 200);
      }
    }
  </script>

</body>
</html>
