  <!-- Page-level GA4 event wiring -->
  <script is:inline>
    // Hero path-button pre-selection
    function ciconPreselect(type) {
      // Fire GA4
      if (typeof gtag === 'function') {
        gtag('event', 'contact_path_select', { path: type });
      }
      // Dispatch custom event to ContactForm
      window.dispatchEvent(new CustomEvent('cicon:preselect', { detail: { type: type } }));
    }

    // Phone click GA4
    var phoneLink = document.getElementById('phone-link');
    if (phoneLink) {
      phoneLink.addEventListener('click', function () {
        if (typeof gtag === 'function') gtag('event', 'phone_click');
      });
    }

    // WhatsApp trust stack click GA4
    var waLink = document.getElementById('whatsapp-trust-link');
    if (waLink) {
      waLink.addEventListener('click', function () {
        if (typeof gtag === 'function') gtag('event', 'whatsapp_click');
      });
    }

    // Mobile FAB WhatsApp click GA4
    var waFab = document.getElementById('mobile-wa-fab');
    if (waFab) {
      waFab.addEventListener('click', function () {
        if (typeof gtag === 'function') gtag('event', 'whatsapp_click');
      });
    }
  </script>

