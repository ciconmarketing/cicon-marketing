---
import '../styles/globals.css';
import Nav          from '../components/Nav.astro';
import Footer       from '../components/Footer.astro';
import ContactForm  from '../components/contact/ContactForm.astro';
import { getContactPage } from '../lib/sanity';

const isPreview = import.meta.env.VERCEL_ENV !== 'production';

// ── Sanity-driven content with hardcoded fallbacks ────────────────────────────
let contactHero = {
  headline: "Talk to a senior strategist — not a sales funnel.",
  subheadline: "Tell us about your clinic or local business and you'll hear back within 1 business hour, Monday to Friday. No discovery-call gauntlet. No junior account manager.",
};
let contactFaqs = [
  { question: 'How fast do you actually respond?', answer: 'Within 1 business hour, Monday to Friday, 9am – 6pm ET. Submissions after hours or on weekends get a reply first thing the next business day. No exceptions, no auto-replies pretending to be us.' },
  { question: "What's your minimum engagement?", answer: "Our smallest engagements start around $1,500/month for focused work like Google Business Profile management or local SEO. Full-service builds — paid ads, SEO, content, creative — typically start at $3,000–$5,000/month. We'd rather under-promise than oversell a retainer you don't need yet." },
  { question: 'Do you work with businesses outside the GTA?', answer: "Most of our clients are GTA-based because local SEO and Google Business Profile work benefit from us knowing the territory. We do take on remote clients for paid ads, SEO, and content — but if you need physical photo/video production or in-person strategy, GTA-only." },
  { question: "What if I'm already working with another agency?", answer: "Two options. We can run a no-strings audit of what they're doing — sometimes the answer is 'they're doing fine, stay put.' Or, if you're already decided to switch, we handle the offboarding so you don't have to fight for assets and access. Either way, no awkwardness — we've been on both sides of that conversation." },
];
let contactSeoCopy = {
  headline: 'Marketing that earns its keep — for clinics and local businesses across the GTA',
  body: 'CiCon Marketing is a boutique digital agency based in Richmond Hill, Ontario. We work with dental clinics, local service businesses, and retail across the Greater Toronto Area on Google Ads, Meta Ads, local SEO, Google Business Profile management, social media, and professional photo and video production. Every engagement is run by a senior strategist — no junior handoff, no template playbook. Reach out using the form above, by phone at +1 (289) 807-1020, or on WhatsApp.',
};
let contactSeoOverrides: { seoTitle?: string; seoDescription?: string; ogImageUrl?: string; canonicalOverride?: string } = {};
try {
  const sanity = await getContactPage();
  if (sanity?.hero?.headline) contactHero = sanity.hero;
  if (sanity?.faqs?.length) contactFaqs = sanity.faqs;
  if (sanity?.seoCopy?.headline) contactSeoCopy = sanity.seoCopy;
  if (sanity?.seoTitle) contactSeoOverrides.seoTitle = sanity.seoTitle;
  if (sanity?.seoDescription) contactSeoOverrides.seoDescription = sanity.seoDescription;
  if (sanity?.ogImageUrl) contactSeoOverrides.ogImageUrl = sanity.ogImageUrl;
  if (sanity?.canonicalOverride) contactSeoOverrides.canonicalOverride = sanity.canonicalOverride;
} catch {}

// JSON-LD blocks
const jsonLdContactPage = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "@id": "https://cicon.ca/contact-us/",
  "name": "Contact CiCon Marketing",
  "url": "https://cicon.ca/contact-us/",
  "description": "Contact CiCon Marketing to talk to a senior marketing strategist for your dental clinic or local business in the GTA.",
  "isPartOf": { "@id": "https://cicon.ca/#website" }
};

const jsonLdLocalBusiness = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "https://cicon.ca/#organization",
  "name": "CiCon Marketing",
  "url": "https://cicon.ca",
  "telephone": "+1-289-807-1020",
  "email": "info@cicon.ca",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "131 Golf Club Ct",
    "addressLocality": "Richmond Hill",
    "addressRegion": "ON",
    "postalCode": "L4C 5E1",
    "addressCountry": "CA"
  },
  "geo": { "@type": "GeoCoordinates", "latitude": 43.8801, "longitude": -79.4392 },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
    "opens": "09:00",
    "closes": "18:00"
  },
  "sameAs": [
    "https://www.linkedin.com/in/majidlm/",
    "https://www.instagram.com/mbehzadpix/",
    "https://www.facebook.com/ciconmarketing/",
    "https://www.instagram.com/ciconmktg/",
    "https://linkedin.com/company/cicon-marketing/"
  ]
};

const jsonLdFaq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How fast do you actually respond?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Within 1 business hour, Monday to Friday, 9am – 6pm ET. Submissions after hours or on weekends get a reply first thing the next business day. No exceptions, no auto-replies pretending to be us."
      }
    },
    {
      "@type": "Question",
      "name": "What's your minimum engagement?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Our smallest engagements start around $1,500/month for focused work like Google Business Profile management or local SEO. Full-service builds — paid ads, SEO, content, creative — typically start at $3,000–$5,000/month. We'd rather under-promise than oversell a retainer you don't need yet."
      }
    },
    {
      "@type": "Question",
      "name": "Do you work with businesses outside the GTA?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Most of our clients are GTA-based because local SEO and Google Business Profile work benefit from us knowing the territory. We do take on remote clients for paid ads, SEO, and content — but if you need physical photo/video production or in-person strategy, GTA-only."
      }
    },
    {
      "@type": "Question",
      "name": "What if I'm already working with another agency?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Two options. We can run a no-strings audit of what they're doing — sometimes the answer is 'they're doing fine, stay put.' Or, if you're already decided to switch, we handle the offboarding so you don't have to fight for assets and access. Either way, no awkwardness — we've been on both sides of that conversation."
      }
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en-CA" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Google Tag Manager -->
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-NH5ZSMKJ');</script>
  <!-- End Google Tag Manager -->

  <!-- Primary Meta -->
  <title>{contactSeoOverrides.seoTitle ?? 'Contact CiCon Marketing | GTA Agency, Richmond Hill ON'}</title>
  <meta name="description" content={contactSeoOverrides.seoDescription ?? 'Reach a senior marketing strategist in Richmond Hill. Serving GTA businesses and dental clinics. Response within 1 business hour, Mon–Fri.'} />
  <link rel="canonical" href={contactSeoOverrides.canonicalOverride ?? 'https://cicon.ca/contact-us/'} />
  {isPreview
    ? <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
    : <meta name="robots" content="index, follow" />
  }

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={contactSeoOverrides.canonicalOverride ?? 'https://cicon.ca/contact-us/'} />
  <meta property="og:title" content={contactSeoOverrides.seoTitle ?? 'Contact CiCon Marketing | GTA Agency, Richmond Hill ON'} />
  <meta property="og:description" content={contactSeoOverrides.seoDescription ?? 'Reach a senior marketing strategist in Richmond Hill. Serving GTA businesses and dental clinics. Same-business-hour response, Mon–Fri.'} />
  <meta property="og:image" content={contactSeoOverrides.ogImageUrl ?? 'https://cicon.ca/logo-cicon.jpg'} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={contactSeoOverrides.seoTitle ?? 'Contact CiCon Marketing | GTA Agency, Richmond Hill ON'} />
  <meta name="twitter:description" content={contactSeoOverrides.seoDescription ?? 'Reach a senior marketing strategist in Richmond Hill. Serving GTA businesses and dental clinics. Same-business-hour response, Mon–Fri.'} />
  <meta name="twitter:image" content={contactSeoOverrides.ogImageUrl ?? 'https://cicon.ca/logo-cicon.jpg'} />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- JSON-LD: ContactPage -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdContactPage)} />
  <!-- JSON-LD: LocalBusiness -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdLocalBusiness)} />
  <!-- JSON-LD: FAQPage -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdFaq)} />

  <style>
    :root {
      --action:    #FFCF00;
      --accent:    #9D833E;
      --shadow:    #212129;
      --alabaster: #E7E7E7;
      --off-white: #FAFAFA;
      --charcoal:  #3A3A3A;
    }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: 'Inter', sans-serif; background: var(--off-white); color: var(--charcoal); }
    h1, h2, h3, h4, h5, h6 { font-family: 'Inter', sans-serif; }

    /* ── Two-column content layout ─────────────── */
    .contact-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 48px;
    }
    @media (min-width: 768px) {
      .contact-grid {
        grid-template-columns: 3fr 2fr;
        gap: 60px;
      }
      /* Trust stack moves to right column on desktop */
      .trust-stack { order: 2; }
      .form-col    { order: 1; }
    }
    /* On mobile: trust stack appears above form */
    @media (max-width: 767px) {
      .trust-stack { order: -1; }
      .form-col    { order: 1; }
    }

    /* ── Trust stack card ──────────────────────── */
    .trust-card {
      background: #fff;
      border-radius: 14px;
      padding: 28px 24px;
      margin-bottom: 20px;
      border: 1px solid var(--alabaster);
    }
    .trust-card:last-child { margin-bottom: 0; }

    /* ── FAQ accordion ─────────────────────────── */
    .faq-item {
      border-bottom: 1px solid var(--alabaster);
    }
    .faq-item:last-child { border-bottom: none; }
    .faq-item summary {
      list-style: none;
      cursor: pointer;
      padding: 20px 0;
      font-size: 16px;
      font-weight: 700;
      font-family: 'Inter', sans-serif;
      color: #212129;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
    }
    .faq-item summary::-webkit-details-marker { display: none; }
    .faq-icon {
      flex-shrink: 0;
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: var(--alabaster);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      font-weight: 700;
      color: var(--accent);
      transition: background .15s, transform .2s;
    }
    details[open] .faq-icon {
      background: rgba(157,131,62,0.15);
      transform: rotate(45deg);
    }
    .faq-answer {
      font-size: 15px;
      line-height: 1.7;
      color: #555;
      padding: 0 0 20px;
    }

    /* ── WhatsApp sticky FAB (mobile only) ─────── */
    .mobile-whatsapp-fab {
      display: none;
    }
    @media (max-width: 767px) {
      .mobile-whatsapp-fab {
        display: flex;
      }
    }

    /* ── Section spacing ───────────────────────── */
    .section-xl { padding: 80px 0; }
    .section-lg { padding: 64px 0; }
    @media (max-width: 640px) {
      .section-xl { padding: 48px 0; }
      .section-lg { padding: 40px 0; }
    }
    .container-xl {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 24px;
    }
    @media (min-width: 640px) {
      .container-xl { padding: 0 32px; }
    }

    /* Hero path buttons */
    .path-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 14px 28px;
      border: 2px solid rgba(255,255,255,0.5);
      border-radius: 10px;
      color: #fff;
      font-size: 15px;
      font-weight: 700;
      font-family: 'Inter', sans-serif;
      text-decoration: none;
      cursor: pointer;
      background: transparent;
      transition: border-color .15s, background .15s;
      white-space: nowrap;
    }
    .path-btn:hover {
      border-color: #FFCF00;
      background: rgba(255,207,0,0.1);
    }
    .path-btn.dental:hover {
      border-color: #FFCF00;
    }
  </style>
</head>

<body style="background:#FAFAFA;">

  <!-- GTM noscript -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NH5ZSMKJ"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

  <Nav />

  <main>

    <!-- ═══════════════════════════════════════
         HERO SECTION
    ═══════════════════════════════════════ -->
    <section style="background:#212129;padding:80px 0 72px;" aria-labelledby="contact-hero-heading">
      <div class="container-xl" style="text-align:center;">

        <p style="font-size:13px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#9D833E;margin:0 0 16px;">
          GTA's Boutique Marketing Partner
        </p>

        <h1
          id="contact-hero-heading"
          style="font-family:'Inter',sans-serif;font-size:clamp(28px,5vw,52px);font-weight:900;color:#fff;line-height:1.1;margin:0 0 20px;max-width:760px;margin-left:auto;margin-right:auto;"
        >
          {contactHero.headline}
        </h1>

        <p style="font-size:clamp(16px,2vw,19px);color:#a0a0b0;max-width:580px;margin:0 auto 36px;line-height:1.6;">
          {contactHero.subheadline}
        </p>

        <!-- Path buttons -->
        <div style="display:flex;flex-wrap:wrap;gap:14px;justify-content:center;">
          <button
            class="path-btn dental"
            onclick="ciconPreselect('dental')"
            aria-label="I run a dental clinic — go to contact form"
          >
            🦷 I run a dental clinic →
          </button>
          <button
            class="path-btn"
            onclick="ciconPreselect('local')"
            aria-label="I run a local business — go to contact form"
          >
            🏢 I run a local business →
          </button>
        </div>

      </div>
    </section>

    <!-- ═══════════════════════════════════════
         MAIN CONTENT: FORM + TRUST STACK
    ═══════════════════════════════════════ -->
    <section class="section-xl" aria-label="Contact form and information">
      <div class="container-xl">
        <div class="contact-grid">

          <!-- Form column -->
          <div class="form-col">
            <ContactForm />
          </div>

          <!-- Trust stack column -->
          <div class="trust-stack">

            <!-- Response guarantee -->
            <div class="trust-card">
              <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;">
                <span style="font-size:22px;" aria-hidden="true">⚡</span>
                <h2 style="font-family:'Inter',sans-serif;font-size:18px;font-weight:800;color:#212129;margin:0;">
                  1 business hour. That's the promise.
                </h2>
              </div>
              <p style="font-size:14px;line-height:1.7;color:#555;margin:0;">
                Every form goes straight to MJ (founder) and Soroush (senior strategist).
                One of us replies inside an hour, Monday to Friday — usually faster.
                No ticketing system. No automated reply.
              </p>
            </div>

            <!-- Call the office -->
            <div class="trust-card">
              <h3 style="font-family:'Inter',sans-serif;font-size:14px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:#9D833E;margin:0 0 12px;">
                Call the office
              </h3>
              <a
                href="tel:+12898071020"
                id="phone-link"
                style="font-size:20px;font-weight:800;color:#212129;text-decoration:none;font-family:'Inter',sans-serif;display:block;margin-bottom:6px;"
                onmouseover="this.style.color='#9D833E'"
                onmouseout="this.style.color='#212129'"
              >
                +1 (289) 807-1020
              </a>
              <p style="font-size:13px;color:#888;margin:0;">Mon–Fri, 9am – 6pm ET</p>
            </div>

            <!-- WhatsApp -->
            <div class="trust-card">
              <h3 style="font-family:'Inter',sans-serif;font-size:14px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:#9D833E;margin:0 0 12px;">
                Prefer messaging?
              </h3>
              <a
                href="https://wa.me/16475840800"
                id="whatsapp-trust-link"
                target="_blank"
                rel="noopener noreferrer"
                style="display:inline-flex;align-items:center;gap:10px;padding:12px 22px;background:#25D366;color:#fff;font-weight:700;font-size:14px;border-radius:10px;text-decoration:none;transition:background .15s;"
                onmouseover="this.style.background='#1ebe5d'"
                onmouseout="this.style.background='#25D366'"
                aria-label="Chat with CiCon Marketing on WhatsApp"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
                Chat on WhatsApp
              </a>
              <p style="font-size:12px;color:#888;margin:10px 0 0;">Reply times same as the form.</p>
            </div>

            <!-- Email -->
            <div class="trust-card">
              <h3 style="font-family:'Inter',sans-serif;font-size:14px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:#9D833E;margin:0 0 10px;">
                Or email directly
              </h3>
              <a
                href="mailto:info@cicon.ca"
                style="font-size:15px;font-weight:600;color:#212129;text-decoration:none;"
                onmouseover="this.style.color='#9D833E'"
                onmouseout="this.style.color='#212129'"
              >info@cicon.ca</a>
            </div>

            <!-- Office address -->
            <div class="trust-card">
              <h3 style="font-family:'Inter',sans-serif;font-size:14px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:#9D833E;margin:0 0 12px;">
                Find us
              </h3>
              <address style="font-style:normal;font-size:14px;line-height:1.7;color:#555;">
                <strong style="color:#212129;">CiCon Marketing</strong><br />
                131 Golf Club Ct<br />
                Richmond Hill, ON L4C 5E1<br />
                Canada
              </address>
              <p style="font-size:13px;color:#888;margin:8px 0 0;">Serving clinics and local businesses across the GTA.</p>
            </div>

          </div><!-- /trust stack -->
        </div><!-- /contact grid -->
      </div>
    </section>

    <!-- ═══════════════════════════════════════
         FAQ SECTION
    ═══════════════════════════════════════ -->
    <section class="section-lg" style="background:#fff;" aria-labelledby="faq-heading">
      <div class="container-xl" style="max-width:860px;">

        <div style="text-align:center;margin-bottom:48px;">
          <p style="font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#9D833E;margin:0 0 10px;">Before you reach out</p>
          <h2
            id="faq-heading"
            style="font-family:'Inter',sans-serif;font-size:clamp(24px,4vw,36px);font-weight:900;color:#212129;margin:0;"
          >
            Quick answers before you reach out
          </h2>
        </div>

        <div style="border-top:1px solid #E7E7E7;">

          {contactFaqs.map((faq) => (
            <details class="faq-item">
              <summary>
                {faq.question}
                <span class="faq-icon" aria-hidden="true">+</span>
              </summary>
              <p class="faq-answer">
                {faq.answer}
              </p>
            </details>
          ))}

        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════
         OFFICE + MAP SECTION
    ═══════════════════════════════════════ -->
    <section class="section-lg" aria-labelledby="office-heading">
      <div class="container-xl" style="max-width:960px;">
        <div style="display:grid;grid-template-columns:1fr;gap:40px;" class="office-grid">

          <div>
            <h2
              id="office-heading"
              style="font-family:'Inter',sans-serif;font-size:22px;font-weight:800;color:#212129;margin:0 0 16px;"
            >
              Our office
            </h2>
            <address style="font-style:normal;font-size:15px;line-height:1.8;color:#555;margin-bottom:16px;">
              <strong style="color:#212129;">CiCon Marketing</strong><br />
              131 Golf Club Ct<br />
              Richmond Hill, ON L4C 5E1<br />
              Canada
            </address>
            <p style="font-size:14px;color:#555;margin:0 0 4px;"><strong style="color:#212129;">Monday–Friday:</strong> 9:00 AM – 6:00 PM ET</p>
            <p style="font-size:14px;color:#555;margin:0 0 20px;"><strong style="color:#212129;">Saturday–Sunday:</strong> Closed</p>
            <a
              href="https://www.google.com/maps/dir/?api=1&destination=131+Golf+Club+Ct,+Richmond+Hill,+ON+L4C+5E1"
              target="_blank"
              rel="noopener noreferrer"
              style="font-size:14px;font-weight:600;color:#9D833E;text-decoration:none;"
              onmouseover="this.style.color='#212129'"
              onmouseout="this.style.color='#9D833E'"
            >
              Get Directions →
            </a>
          </div>

