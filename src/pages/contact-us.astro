  <!-- Page-level GA4 event wiring — runs after load to keep main thread free at paint time -->
  <script is:inline>
    // Hero path-button pre-selection (must be synchronous — called from onclick attribute)
    function ciconPreselect(type) {
      if (typeof gtag === 'function') gtag('event', 'contact_path_select', { path: type });
      window.dispatchEvent(new CustomEvent('cicon:preselect', { detail: { type: type } }));
    }

    // Defer click-event tracking until after load — no user can click before that anyway
    window.addEventListener('load', function () {
      var phoneLink = document.getElementById('phone-link');
      if (phoneLink) phoneLink.addEventListener('click', function () {
        if (typeof gtag === 'function') gtag('event', 'phone_click');
      });

      var waLink = document.getElementById('whatsapp-trust-link');
      if (waLink) waLink.addEventListener('click', function () {
        if (typeof gtag === 'function') gtag('event', 'whatsapp_click');
      });

      var waFab = document.getElementById('mobile-wa-fab');
      if (waFab) waFab.addEventListener('click', function () {
        if (typeof gtag === 'function') gtag('event', 'whatsapp_click');
      });
    }, { once: true });
  </script>

