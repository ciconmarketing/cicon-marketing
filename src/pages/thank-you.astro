---
import '../styles/globals.css';
import Nav    from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getThankYouPage } from '../lib/sanity';

let tyData = {
  headline: "Got it. Now it's our move.",
  paragraph1: "Your submission is sitting in MJ's and Soroush's inboxes right now. One of us will reach out within the next business hour — by phone, email, or whichever you prefer.",
  paragraph2: "In the meantime, if something urgent comes up, message us directly on WhatsApp. Same response window.",
  nurtureLinkLabel: null as string | null,
  nurtureLinkUrl: null as string | null,
};
try {
  const sanity = await getThankYouPage();
  if (sanity?.headline) tyData = { ...tyData, ...sanity };
} catch {}
---

<!DOCTYPE html>
<html lang="en-CA" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="/fonts/fonts.css" />

  <!-- Google Tag Manager (lazy: loads after 3.5 s or first user interaction) -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    window.gtag = gtag;
    (function () {
      function loadGTM() {
        if (window._gtmLoaded) return;
        window._gtmLoaded = true;
        (function(w,d,s,l,i){
          w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});
          var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';
          j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;
          f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','GTM-NH5ZSMKJ');
      }
      setTimeout(loadGTM, 3500);
      ['click','keydown','mousemove','touchstart','scroll'].forEach(function(ev){
        window.addEventListener(ev, loadGTM, {once:true, passive:true});
      });
    })();
  </script>
  <!-- End Google Tag Manager -->
  <!-- Meta Pixel (lazy: fbq stub queues calls immediately; fbevents.js loads after 3.5s or first interaction) -->
  <link rel="preconnect" href="https://connect.facebook.net" crossorigin />
  <script is:inline>
    !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){
    n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
    fbq('init','1299226945517753');
    fbq('track','PageView');
    (function(){
      function loadPixel(){
        if(window._fbqLoaded)return;window._fbqLoaded=true;
        var s=document.createElement('script');s.async=true;
        s.src='https://connect.facebook.net/en_US/fbevents.js';
        document.head.appendChild(s);
      }
      setTimeout(loadPixel,3500);
      ['click','keydown','mousemove','touchstart','scroll'].forEach(function(ev){
        window.addEventListener(ev,loadPixel,{once:true,passive:true});
      });
    })();
  </script>
  <noscript><img height="1" width="1" style="display:none"
  src="https://www.facebook.com/tr?id=1299226945517753&ev=PageView&noscript=1"/></noscript>
  <!-- End Meta Pixel -->

  <title>Thank You | CiCon Marketing</title>
  <meta name="robots" content="noindex, nofollow" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

  <!-- Favicon -->
  <link rel="icon" type="image/png" sizes="120x120" href="/logo-cicon-120.png" />

  <style>
    :root {
      --accent:    #9D833E;
      --shadow:    #212129;
      --alabaster: #E7E7E7;
    }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: 'Inter', sans-serif; background: #FAFAFA; color: #3A3A3A; }
    h1, h2, h3 { font-family: 'Clash Display', 'Inter', sans-serif; }
    .container-xl {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 24px;
    }
  </style>
</head>

<body>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NH5ZSMKJ"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->

  <Nav />

  <main>

    <!-- Hero -->
    <section
      style="background:#212129;padding:100px 0 80px;text-align:center;"
      aria-labelledby="ty-heading"
    >
      <div class="container-xl" style="max-width:680px;">

        <!-- Check icon -->
        <div style="width:64px;height:64px;border-radius:50%;background:rgba(157,131,62,0.15);border:2px solid #9D833E;display:flex;align-items:center;justify-content:center;margin:0 auto 28px;" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#9D833E" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
        </div>

        <h1
          id="ty-heading"
          class="font-heading"
          style="font-size:clamp(28px,5vw,48px);font-weight:900;color:#fff;margin:0 0 20px;line-height:1.1;"
        >
          {tyData.headline}
        </h1>

        <p style="font-size:clamp(16px,2vw,18px);color:#a0a0b0;line-height:1.7;margin:0 0 16px;">
          {tyData.paragraph1}
        </p>

        <p style="font-size:15px;color:#a0a0b0;line-height:1.7;margin:0 0 36px;">
          {tyData.paragraph2}
        </p>

        <a
          href="https://wa.me/16475840800"
          target="_blank"
          rel="noopener noreferrer"
          id="ty-wa-btn"
          style="display:inline-flex;align-items:center;gap:10px;padding:14px 30px;background:#25D366;color:#fff;font-weight:700;font-size:15px;border-radius:12px;text-decoration:none;transition:background .15s;font-family:'Inter',sans-serif;"
          onmouseover="this.style.background='#1ebe5d'"
          onmouseout="this.style.background='#25D366'"
          aria-label="Message CiCon Marketing on WhatsApp"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Message us on WhatsApp
        </a>

        <!-- Divider -->
        <div style="width:48px;height:2px;background:rgba(255,255,255,0.12);margin:44px auto 40px;"></div>

        <!-- While you wait -->
        <div style="margin-bottom:36px;">
          <p style="font-size:14px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:#9D833E;margin:0 0 14px;">
            While you wait
          </p>
            {tyData.nurtureLinkLabel && tyData.nurtureLinkUrl ? (
            <a href={tyData.nurtureLinkUrl} style="font-size:14px;font-weight:600;color:#9D833E;text-decoration:none;display:inline-flex;align-items:center;gap:6px;" onmouseover="this.style.textDecoration='underline'" onmouseout="this.style.textDecoration='none'">
              {tyData.nurtureLinkLabel} →
            </a>
          ) : (
            <p style="font-size:14px;color:#666;font-style:italic;">
              Nurture content link coming soon — update in Sanity Studio.
            </p>
          )}
        </div>

        <a
          href="/"
          style="font-size:14px;font-weight:600;color:#a0a0b0;text-decoration:none;display:inline-flex;align-items:center;gap:6px;transition:color .15s;"
          onmouseover="this.style.color='#fff'"
          onmouseout="this.style.color='#a0a0b0'"
        >
          ← Back to cicon.ca
        </a>

      </div>
    </section>

  </main>

  <Footer />

  <!-- GA4: fire thank_you_view event -->
  <script is:inline>
    if (typeof gtag === 'function') {
      gtag('event', 'thank_you_view');
    }

    // WhatsApp button GA4
    var tyWaBtn = document.getElementById('ty-wa-btn');
    if (tyWaBtn) {
      tyWaBtn.addEventListener('click', function () {
        if (typeof gtag === 'function') gtag('event', 'whatsapp_click', { source: 'thank_you' });
      });
    }
  </script>

  <!-- ═══════════════════════════════════════════════════════════════
       GHL CHAT WIDGET PLACEHOLDER
       Replace this comment with the GoHighLevel chat widget snippet
       provided by MJ. Do not remove this comment until widget is live.
       ═══════════════════════════════════════════════════════════════ -->

</body>
</html>
