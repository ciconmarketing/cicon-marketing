---
/**
 * /areas-served/[slug]/ — city page.
 * Content lives in Sanity (`serviceArea` documents). getStaticPaths fetches
 * every area once, runs the quality gate, and generates a route only for
 * areas with hasDedicatedPage — draft areas are generated too (noindexed,
 * for MJ review) but never linked or sitemapped.
 * Section order: Breadcrumbs → AreaHero → AnswerFirst → AreaContext →
 * AreaServices → AreaProof → ProcessStrip → EeatBlock → FAQ → NearbyAreas →
 * AreaReviews → FinalCta.
 */
// Self-hosted Inter (weight axis only, no italics — none used on this page).
// Replaces a Google Fonts CDN <link> (2 preconnects + a render-blocking
// stylesheet fetch) with an already-installed local package.
import '@fontsource-variable/inter/wght.css'
import { getServiceAreas } from '../../lib/sanity'
import { validateAreaPages, getBuildableAreas } from '../../lib/areas-served'
import { ORG_CICON, PERSON_MAJID, WEBSITE_CICON } from '../../lib/schema-constants'
import { toAbsoluteUrl } from '../../lib/url'
import Nav             from '../../components/Nav.astro'
import Footer          from '../../components/Footer.astro'
import AreaBreadcrumbs from '../../components/areas/AreaBreadcrumbs.astro'
import AreaHero        from '../../components/areas/AreaHero.astro'
import AnswerFirst     from '../../components/areas/AnswerFirst.astro'
import AreaContext     from '../../components/areas/AreaContext.astro'
import AreaServices    from '../../components/areas/AreaServices.astro'
import AreaProof       from '../../components/areas/AreaProof.astro'
import NearbyAreas     from '../../components/areas/NearbyAreas.astro'
import AreaAnalytics   from '../../components/areas/AreaAnalytics.astro'
import ProcessStrip    from '../../components/services/ProcessStrip.astro'
import EeatBlock       from '../../components/services/EeatBlock.astro'
import ServiceFaq      from '../../components/services/ServiceFaq.astro'
import FinalCta        from '../../components/services/FinalCta.astro'
import AreaReviews     from '../../components/areas/AreaReviews.astro'

export async function getStaticPaths() {
  const areas = await getServiceAreas()
  validateAreaPages(areas) // quality gate — throws at build time on any violation
  return getBuildableAreas(areas).map((page) => ({ params: { slug: page.slug }, props: { page } }))
}

const { page } = Astro.props

const isPreview = import.meta.env.VERCEL_ENV !== 'production'
const canonicalUrl = toAbsoluteUrl(page.canonical, `https://cicon.ca/areas-served/${page.slug}/`)
// Draft/non-indexable pages are reviewable on the live URL but never indexed.
const robots = isPreview || !page.indexable
  ? 'noindex, nofollow, noarchive, nosnippet'
  : 'index, follow'

const disclosure =
  page.slug === 'richmond-hill'
    ? 'CiCon Marketing is headquartered at 131 Golf Club Ct, Richmond Hill, ON L4C 5E1 — this is our home market.'
    : `Based in Richmond Hill and serving businesses throughout ${page.cityName}. We work remotely and on location — no ${page.cityName} office, and we won't pretend otherwise.`

// ── Schema.org ────────────────────────────────────────────────────────────────
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    ORG_CICON,
    PERSON_MAJID,
    WEBSITE_CICON,
    {
      '@type': 'Service',
      '@id': `${canonicalUrl}#service`,
      name: `Digital Marketing Services in ${page.cityName}`,
      description: page.metaDescription,
      serviceType: 'Digital marketing',
      provider: { '@id': 'https://cicon.ca/#organization' },
      areaServed: { '@type': 'City', name: page.cityName },
      offers: {
        '@type': 'Offer',
        name: 'Chat on WhatsApp',
        price: 0,
        priceCurrency: 'CAD',
        description: 'Free WhatsApp consultation with our senior strategist',
      },
    },
    ...(page.faqs?.length
      ? [{
          '@type': 'FAQPage',
          '@id': `${canonicalUrl}#faq`,
          mainEntity: page.faqs.map((faq: { question: string; answer: string }) => ({
            '@type': 'Question',
            name: faq.question,
            acceptedAnswer: { '@type': 'Answer', text: faq.answer },
          })),
        }]
      : []),
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://cicon.ca/' },
        { '@type': 'ListItem', position: 2, name: 'Areas Served', item: 'https://cicon.ca/areas-served/' },
        { '@type': 'ListItem', position: 3, name: page.cityName, item: canonicalUrl },
      ],
    },
  ],
}
---

<!DOCTYPE html>
<html lang="en-CA">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="/fonts/fonts.css" />
  <title>{page.metaTitle}</title>
  <meta name="description" content={page.metaDescription} />
  <link rel="canonical" href={canonicalUrl} />
  <meta name="robots" content={robots} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={page.metaTitle} />
  <meta property="og:description" content={page.metaDescription} />
  <meta property="og:image" content={page.ogImageUrl ?? 'https://cicon.ca/logo-cicon.jpg'} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={page.metaTitle} />
  <meta name="twitter:description" content={page.metaDescription} />
  <meta name="twitter:image" content={page.ogImageUrl ?? 'https://cicon.ca/logo-cicon.jpg'} />

  <!-- Favicon -->
  <link rel="icon" type="image/png" sizes="120x120" href="/logo-cicon-120.png" />

  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- Brand tokens -->
  <style>
    :root {
      --action:    #FFCF00;
      --accent:    #9D833E;
      /* Darker read of --accent for small text on light backgrounds — #9D833E
         only clears ~3.5:1 there (WCAG AA needs 4.5:1 for normal text).
         --accent itself is unchanged and still used for dark-bg text,
         borders, and decorative (aria-hidden) glyphs. */
      --accent-text: #7A6329;
      /* Lighter read of --accent for small text on --shadow backgrounds —
         #9D833E clears only ~4.37:1 on #212129 (just under the 4.5:1 AA
         floor); this variant clears ~5:1. Not needed on darker surfaces
         (e.g. the #1a1a20 bio card), where --accent already passes. */
      --accent-dark-text: #A68F51;
      --shadow:    #212129;
      --alabaster: #E7E7E7;
      --off-white: #FAFAFA;
      --charcoal:  #3A3A3A;
      --black:     #000;
    }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: 'Inter Variable', 'Inter', sans-serif; background: var(--off-white); color: var(--charcoal); }
    h1, h2, h3, h4, h5, h6 { font-family: 'Clash Display', 'Inter Variable', 'Inter', sans-serif; }
    details > summary { list-style: none; }
    details > summary::-webkit-details-marker { display: none; }
  </style>

  <!-- Google Tag Manager (lazy: loads after 3.5 s or first user interaction) -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    window.gtag = gtag;
    (function () {
      function loadGTM() {
        if (window._gtmLoaded) return;
        window._gtmLoaded = true;
        (function(w,d,s,l,i){
          w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});
          var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';
          j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;
          f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','GTM-NH5ZSMKJ');
      }
      setTimeout(loadGTM, 3500);
      ['click','keydown','mousemove','touchstart','scroll'].forEach(function(ev){
        window.addEventListener(ev, loadGTM, {once:true, passive:true});
      });
    })();
  </script>
  <!-- End Google Tag Manager -->
  <!-- Meta Pixel (lazy: fbq stub queues calls immediately; fbevents.js loads after 3.5s or first interaction) -->
  <link rel="preconnect" href="https://connect.facebook.net" crossorigin />
  <script is:inline>
    !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){
    n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
    fbq('init','1299226945517753');
    fbq('track','PageView');
    (function(){
      function loadPixel(){
        if(window._fbqLoaded)return;window._fbqLoaded=true;
        var s=document.createElement('script');s.async=true;
        s.src='https://connect.facebook.net/en_US/fbevents.js';
        document.head.appendChild(s);
      }
      setTimeout(loadPixel,3500);
      ['click','keydown','mousemove','touchstart','scroll'].forEach(function(ev){
        window.addEventListener(ev,loadPixel,{once:true,passive:true});
      });
    })();
  </script>
  <noscript><img height="1" width="1" style="display:none"
  src="https://www.facebook.com/tr?id=1299226945517753&ev=PageView&noscript=1"/></noscript>
  <!-- End Meta Pixel -->
</head>

<body>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NH5ZSMKJ"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->

  <Nav />

  <main>

  <AreaBreadcrumbs crumbs={[
    { label: 'Home', href: '/' },
    { label: 'Areas Served', href: '/areas-served/' },
    { label: page.cityName },
  ]} />

  <div style="height:16px"></div>

  <AreaHero
    eyebrow={page.eyebrow}
    headline={page.h1}
    valueProp={(page.summary ?? '').split('. ').slice(0, 2).join('. ').replace(/\.+$/, '') + '.'}
    disclosure={disclosure}
    trackSource={page.slug}
  />

  <AnswerFirst summary={page.summary} />

  <AreaContext
    cityName={page.cityName}
    paragraphs={page.localContext ?? []}
    industries={page.bestFitIndustries ?? []}
  />

  <AreaServices cityName={page.cityName} services={page.featuredServices ?? []} trackSource={page.slug} />

  <AreaProof cityName={page.cityName} proof={page.localProof ?? []} />

  <ProcessStrip />

  <EeatBlock />

  <ServiceFaq faqs={page.faqs ?? []} pageUrl={canonicalUrl} />

  <NearbyAreas cityName={page.cityName} nearbyAreas={page.nearbyAreas ?? []} />

  <AreaReviews />

  <FinalCta
    headline={`Ready to grow in ${page.cityName}?`}
    body={`Start a WhatsApp conversation. We'll audit your current marketing, tell you honestly whether ${page.cityName} search can produce the leads you need, and map the realistic path — no fluff, no hard sell.`}
  />

  </main>

  <Footer />

  <AreaAnalytics pageSource={page.slug} />
</body>
</html>
