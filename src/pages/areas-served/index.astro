---
/**
 * /areas-served/ — Areas Served hub.
 * Content lives in Sanity (`areasServedHub` singleton, referencing
 * `serviceArea` documents by group — see sanity/schemas/areasServedHub.ts).
 * Groups CiCon's real operating footprint (Richmond Hill base + GTA markets),
 * links only to published city pages, and represents everything else as
 * honest coverage text. Useful standalone even with zero city pages.
 */
// Self-hosted Inter (weight axis only, no italics — none used on this page).
// Replaces a Google Fonts CDN <link> (2 preconnects + a render-blocking
// stylesheet fetch) with an already-installed local package.
import '@fontsource-variable/inter/wght.css'
import { getAreasServedHub, getServiceAreas } from '../../lib/sanity'
import { getPublishedAreas, validateAreaPages } from '../../lib/areas-served'
import { ORG_CICON, PERSON_MAJID, WEBSITE_CICON } from '../../lib/schema-constants'
import Nav             from '../../components/Nav.astro'
import Footer          from '../../components/Footer.astro'
import AreaBreadcrumbs from '../../components/areas/AreaBreadcrumbs.astro'
import AreaHero        from '../../components/areas/AreaHero.astro'
import AnswerFirst     from '../../components/areas/AnswerFirst.astro'
import CityGroups      from '../../components/areas/CityGroups.astro'
import type { CityGroup } from '../../components/areas/CityGroups.astro'
import AreaServices    from '../../components/areas/AreaServices.astro'
import AreaAnalytics   from '../../components/areas/AreaAnalytics.astro'
import ProcessStrip    from '../../components/services/ProcessStrip.astro'
import EeatBlock       from '../../components/services/EeatBlock.astro'
import ServiceFaq      from '../../components/services/ServiceFaq.astro'
import FinalCta        from '../../components/services/FinalCta.astro'
import AreaReviews     from '../../components/areas/AreaReviews.astro'

const [hub, areas] = await Promise.all([getAreasServedHub(), getServiceAreas()])
validateAreaPages(areas)

const isPreview = import.meta.env.VERCEL_ENV !== 'production'
const canonicalUrl = hub?.canonicalOverride ?? 'https://cicon.ca/areas-served/'

// Sane fallbacks only in the unlikely event the Sanity fetch fails at build
// time — the live content is always the Sanity singleton, never this.
const TITLE = hub?.seoTitle ?? 'Digital Marketing Agency for Richmond Hill & the GTA | CiCon'
const META_DESCRIPTION =
  hub?.seoDescription ??
  'CiCon Marketing serves Richmond Hill, York Region, and selected GTA markets with senior-led local SEO, Google Ads, and dental marketing. Chat on WhatsApp.'
const HERO_EYEBROW = hub?.heroEyebrow ?? 'Richmond Hill Based · Serving the GTA'
const HERO_HEADLINE = hub?.heroHeadline ?? 'Digital Marketing Across Richmond Hill and the Greater Toronto Area'
const HERO_SUBHEADLINE =
  hub?.heroSubheadline ??
  'CiCon Marketing builds local SEO, paid advertising, and lead systems for businesses and dental clinics across York Region, Toronto, and selected GTA markets — senior-run, boutique, and honest about where we can actually win.'
const SUMMARY =
  hub?.answerFirstIntro ??
  'CiCon Marketing is a Richmond Hill–based digital marketing agency serving businesses and dental clinics across York Region, Toronto, and selected GTA markets. We work remotely and on location, with a senior strategist on every account. If your market is not a genuine fit, we will say so.'
const SUPPORTING_SECTIONS = hub?.supportingSections ?? []
const HUB_SERVICES = hub?.featuredServices ?? []
const HUB_FAQS = hub?.faqs ?? []
const FINAL_CTA = hub?.finalCta ?? {
  headline: "Tell us your market. We'll tell you the truth.",
  body: "Start a WhatsApp conversation. We'll look at your city, your competition, and your current visibility — and give you an honest read on what it takes to win there.",
}

// ── Build the grouped card data straight from the Sanity singleton ──────────
// Linked card only when the target area is published + indexable + has a page.
const groups: CityGroup[] = (hub?.geographicGroups ?? []).map((g) => ({
  heading: g.heading,
  note: g.note,
  cards: g.areas.map((a) => ({
    name: a.cityName,
    line: a.hubCardLine,
    ...(a.hasDedicatedPage && a.status === 'published' && a.indexable
      ? { href: `/areas-served/${a.slug}/` }
      : {}),
  })),
}))

// ── Schema.org ────────────────────────────────────────────────────────────────
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    ORG_CICON,
    PERSON_MAJID,
    WEBSITE_CICON,
    {
      '@type': 'CollectionPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: TITLE,
      description: META_DESCRIPTION,
      isPartOf: { '@id': 'https://cicon.ca/#website' },
      about: { '@id': 'https://cicon.ca/#organization' },
      inLanguage: 'en-CA',
    },
    ...(HUB_FAQS.length
      ? [{
          '@type': 'FAQPage',
          '@id': `${canonicalUrl}#faq`,
          mainEntity: HUB_FAQS.map((faq) => ({
            '@type': 'Question',
            name: faq.question,
            acceptedAnswer: { '@type': 'Answer', text: faq.answer },
          })),
        }]
      : []),
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://cicon.ca/' },
        { '@type': 'ListItem', position: 2, name: 'Areas Served', item: canonicalUrl },
      ],
    },
  ],
}

const publishedCount = getPublishedAreas(areas).length
---

<!DOCTYPE html>
<html lang="en-CA">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="/fonts/fonts.css" />
  <title>{TITLE}</title>
  <meta name="description" content={META_DESCRIPTION} />
  <link rel="canonical" href={canonicalUrl} />
  {isPreview
    ? <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
    : <meta name="robots" content="index, follow" />
  }

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={TITLE} />
  <meta property="og:description" content={META_DESCRIPTION} />
  <meta property="og:image" content={hub?.ogImageUrl ?? 'https://cicon.ca/logo-cicon.jpg'} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={TITLE} />
  <meta name="twitter:description" content={META_DESCRIPTION} />
  <meta name="twitter:image" content={hub?.ogImageUrl ?? 'https://cicon.ca/logo-cicon.jpg'} />

  <!-- Favicon -->
  <link rel="icon" type="image/png" sizes="120x120" href="/logo-cicon-120.png" />

  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- Brand tokens -->
  <style>
    :root {
      --action:    #FFCF00;
      --accent:    #9D833E;
      /* Darker read of --accent for small text on light backgrounds — #9D833E
         only clears ~3.5:1 there (WCAG AA needs 4.5:1 for normal text).
         --accent itself is unchanged and still used for dark-bg text,
         borders, and decorative (aria-hidden) glyphs. */
      --accent-text: #7A6329;
      /* Lighter read of --accent for small text on --shadow backgrounds —
         #9D833E clears only ~4.37:1 on #212129 (just under the 4.5:1 AA
         floor); this variant clears ~5:1. Not needed on darker surfaces
         (e.g. the #1a1a20 bio card), where --accent already passes. */
      --accent-dark-text: #A68F51;
      --shadow:    #212129;
      --alabaster: #E7E7E7;
      --off-white: #FAFAFA;
      --charcoal:  #3A3A3A;
      --black:     #000;
    }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: 'Inter Variable', 'Inter', sans-serif; background: var(--off-white); color: var(--charcoal); }
    h1, h2, h3, h4, h5, h6 { font-family: 'Clash Display', 'Inter Variable', 'Inter', sans-serif; }
    details > summary { list-style: none; }
    details > summary::-webkit-details-marker { display: none; }
  </style>

  <!-- Google Tag Manager (lazy: loads after 3.5 s or first user interaction) -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    window.gtag = gtag;
    (function () {
      function loadGTM() {
        if (window._gtmLoaded) return;
        window._gtmLoaded = true;
        (function(w,d,s,l,i){
          w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});
          var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';
          j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;
          f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','GTM-NH5ZSMKJ');
      }
      setTimeout(loadGTM, 3500);
      ['click','keydown','mousemove','touchstart','scroll'].forEach(function(ev){
        window.addEventListener(ev, loadGTM, {once:true, passive:true});
      });
    })();
  </script>
  <!-- End Google Tag Manager -->
  <!-- Meta Pixel (lazy: fbq stub queues calls immediately; fbevents.js loads after 3.5s or first interaction) -->
  <link rel="preconnect" href="https://connect.facebook.net" crossorigin />
  <script is:inline>
    !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){
    n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
    fbq('init','1299226945517753');
    fbq('track','PageView');
    (function(){
      function loadPixel(){
        if(window._fbqLoaded)return;window._fbqLoaded=true;
        var s=document.createElement('script');s.async=true;
        s.src='https://connect.facebook.net/en_US/fbevents.js';
        document.head.appendChild(s);
      }
      setTimeout(loadPixel,3500);
      ['click','keydown','mousemove','touchstart','scroll'].forEach(function(ev){
        window.addEventListener(ev,loadPixel,{once:true,passive:true});
      });
    })();
  </script>
  <noscript><img height="1" width="1" style="display:none"
  src="https://www.facebook.com/tr?id=1299226945517753&ev=PageView&noscript=1"/></noscript>
  <!-- End Meta Pixel -->
</head>

<body>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NH5ZSMKJ"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->

  <Nav />

  <main>

  <AreaBreadcrumbs crumbs={[
    { label: 'Home', href: '/' },
    { label: 'Areas Served' },
  ]} />

  <div style="height:16px"></div>

  <AreaHero
    eyebrow={HERO_EYEBROW}
    headline={HERO_HEADLINE}
    valueProp={HERO_SUBHEADLINE}
    disclosure="One office: 131 Golf Club Ct, Richmond Hill. Everywhere else we serve remotely and on location — no satellite-office theatre."
    trackSource="hub"
  />

  <!-- Trust strip -->
  <section style="background:var(--shadow);padding:0 0 48px">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap gap-x-8 gap-y-2 text-sm" style="color:#888">
        {[
          '✓ Senior strategist on every account',
          '✓ Boutique client roster',
          '✓ 14+ years in GTA markets',
          '✓ Transparent monthly reporting',
        ].map((t) => <span>{t}</span>)}
      </div>
    </div>
  </section>

  <AnswerFirst summary={SUMMARY} />

  <CityGroups groups={groups} />

  {SUPPORTING_SECTIONS.length > 0 && (
    <section class="py-20" style="background:#fff">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-2xl mb-12">
          <div class="flex items-center gap-2 mb-3">
            <span class="h-[1px] w-8" style="background:var(--accent)"></span>
            <span class="text-xs font-semibold tracking-widest uppercase" style="color:var(--accent-text)">Why Location Matters</span>
          </div>
          <h2 class="font-heading text-3xl font-extrabold" style="color:var(--black)">
            The GTA is not one market
          </h2>
          <p class="text-base mt-3" style="color:var(--charcoal)">
            A playbook that wins in downtown Toronto loses in Aurora. Here is what actually changes from city to city — and why it changes what we build.
          </p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {SUPPORTING_SECTIONS.map((item) => (
            <div class="rounded-2xl border p-6" style="border-color:var(--alabaster);background:var(--off-white)">
              <div class="font-heading text-lg font-bold mb-2" style="color:var(--black)">{item.heading}</div>
              <p class="text-sm leading-relaxed m-0" style="color:var(--charcoal)">{item.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <AreaServices cityName="GTA" services={HUB_SERVICES} trackSource="hub" />

  <ProcessStrip />

  <EeatBlock
    headline="One strategist, one standard, every market"
    body={`Every CiCon account — whether the business is in Richmond Hill or Pickering — is run by Majid, our senior strategist with 14+ years in performance marketing. No junior account managers, no rotating points of contact, no market too small to get the real playbook.\n\nWe currently maintain ${publishedCount} dedicated city page${publishedCount === 1 ? '' : 's'} and add more only when we can offer genuinely local substance — not swapped city names.`}
  />

  <ServiceFaq faqs={HUB_FAQS} pageUrl={canonicalUrl} />

  <AreaReviews />

  <FinalCta
    headline={FINAL_CTA.headline}
    body={FINAL_CTA.body}
  />

  </main>

  <Footer />

  <AreaAnalytics pageSource="hub" />
</body>
</html>
