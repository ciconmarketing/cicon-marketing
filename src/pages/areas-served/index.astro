---
/**
 * /areas-served/ — Areas Served hub.
 * Groups CiCon's real operating footprint (Richmond Hill base + GTA markets),
 * links only to published city pages, and represents everything else as
 * honest coverage text. Useful standalone even with zero city pages.
 */
import { AREA_PAGES, COVERAGE_AREAS, getPublishedAreas, validateAreaPages } from '../../lib/areas-served'
import { ORG_CICON, PERSON_MAJID, WEBSITE_CICON } from '../../lib/schema-constants'
import Nav             from '../../components/Nav.astro'
import Footer          from '../../components/Footer.astro'
import AreaBreadcrumbs from '../../components/areas/AreaBreadcrumbs.astro'
import AreaHero        from '../../components/areas/AreaHero.astro'
import AnswerFirst     from '../../components/areas/AnswerFirst.astro'
import CityGroups      from '../../components/areas/CityGroups.astro'
import type { CityGroup } from '../../components/areas/CityGroups.astro'
import AreaServices    from '../../components/areas/AreaServices.astro'
import AreaAnalytics   from '../../components/areas/AreaAnalytics.astro'
import ProcessStrip    from '../../components/services/ProcessStrip.astro'
import EeatBlock       from '../../components/services/EeatBlock.astro'
import ServiceFaq      from '../../components/services/ServiceFaq.astro'
import FinalCta        from '../../components/services/FinalCta.astro'
import GoogleReviews   from '../../components/react/GoogleReviews.tsx'

validateAreaPages()

const isPreview = import.meta.env.VERCEL_ENV !== 'production'
const canonicalUrl = 'https://cicon.ca/areas-served/'

const TITLE = 'Digital Marketing Agency for Richmond Hill & the GTA | CiCon'
const META_DESCRIPTION =
  'CiCon Marketing serves Richmond Hill, York Region, and selected GTA markets with senior-led local SEO, Google Ads, and dental marketing. Chat on WhatsApp.'

const SUMMARY =
  'CiCon Marketing is a Richmond Hill–based digital marketing agency serving businesses and dental clinics across York Region, Toronto, and selected GTA markets — including Markham, Vaughan, Thornhill, Aurora, Newmarket, North York, and surrounding communities. We work remotely and on location, with a senior strategist on every account. If your market is not a genuine fit, we will say so.'

// ── Build the grouped card data ──────────────────────────────────────────────
// Linked card only when the target page is published + indexable.
function cardFor(slug: string, fallbackLine: string) {
  const p = AREA_PAGES.find((x) => x.slug === slug)
  if (!p) return { name: slug, line: fallbackLine }
  const linked = p.status === 'published' && p.indexable
  return {
    name: p.cityName,
    line: fallbackLine,
    ...(linked ? { href: `/areas-served/${p.slug}/` } : {}),
  }
}
function coverage(name: string) {
  const c = COVERAGE_AREAS.find((x) => x.name === name)
  return { name, line: c?.line ?? '' }
}

const groups: CityGroup[] = [
  {
    heading: 'Home market',
    note: 'Where CiCon is headquartered — our own Google Business Profile competes here.',
    cards: [cardFor('richmond-hill', 'Our home base. Local SEO, Google Ads, and dental marketing with our office minutes away.')],
  },
  {
    heading: 'York Region',
    cards: [
      cardFor('vaughan', 'Contractors, showrooms, and clinics in one of the GTA’s most competitive paid-search markets.'),
      cardFor('markham', 'Showrooms, home improvement, professional services, and dental — with on-location media production nearby.'),
      cardFor('thornhill', 'Clinics and local services across the community spanning Vaughan and Markham.'),
      cardFor('aurora', 'Premium home services and clinics — qualified leads over vanity traffic.'),
      cardFor('newmarket', 'Northern York Region trades, clinics, and professional services.'),
      coverage('King'),
      coverage('Whitchurch–Stouffville'),
      coverage('East Gwillimbury'),
    ],
  },
  {
    heading: 'Toronto markets',
    note: 'North York, Scarborough, and Etobicoke are distinct search markets within the City of Toronto — we treat them that way.',
    cards: [
      cardFor('north-york', 'Dense clinic and professional-service competition along the Yonge corridor.'),
      coverage('Toronto'),
      coverage('Scarborough'),
      coverage('Etobicoke'),
    ],
  },
  {
    heading: 'Eastern GTA · Durham corridor',
    cards: [coverage('Pickering')],
  },
  {
    heading: 'Northwest GTA',
    cards: [coverage('Bolton')],
  },
  {
    heading: 'Extended western GTA coverage',
    note: 'Served for paid advertising, SEO, and remote-friendly engagements where the fit is genuine.',
    cards: [coverage('Mississauga')],
  },
]

// ── Services across the GTA (canonical service pages) ────────────────────────
const HUB_SERVICES = [
  { slug: 'local-seo-optimization', title: 'Local SEO', angle: 'Google Maps and local rankings across your real service area.' },
  { slug: 'ai-seo-and-seo', title: 'AI SEO', angle: 'Visibility when GTA buyers ask Google AI, ChatGPT, or Perplexity who to hire.' },
  { slug: 'paid-advertising-services', title: 'Paid Advertising', angle: 'Google, Meta, and Microsoft Ads tuned to GTA cost-per-click realities.' },
  { slug: 'dental-marketing-services', title: 'Dental Marketing', angle: 'Our flagship specialization — patient acquisition for GTA clinics.' },
  { slug: 'website-development', title: 'Website Development', angle: 'Fast, conversion-first sites that turn local traffic into inquiries.' },
  { slug: 'crm-integration', title: 'CRM Integration', angle: 'Follow-up systems so the leads you pay for actually get called.' },
]

const HUB_FAQS = [
  {
    question: 'Which GTA cities does CiCon Marketing serve?',
    answer:
      'We serve Richmond Hill (our home base), Markham, Vaughan, Thornhill, Aurora, Newmarket, King, Whitchurch–Stouffville, and East Gwillimbury in York Region; North York, Scarborough, Etobicoke, and the wider City of Toronto; plus Pickering, Bolton, and Mississauga where the engagement is a genuine fit.',
  },
  {
    question: 'Is CiCon Marketing located in Richmond Hill?',
    answer:
      'Yes — our office is at 131 Golf Club Ct, Richmond Hill, ON L4C 5E1. We do not have offices in other cities, and our city pages never claim otherwise.',
  },
  {
    question: 'Do you work with businesses outside Richmond Hill?',
    answer:
      'Constantly. Most of our clients are spread across York Region and Toronto. Local SEO and Google Business Profile work benefit from local knowledge; paid advertising, SEO, content, and CRM work run well remotely across the GTA and beyond.',
  },
  {
    question: 'Can CiCon manage marketing for multiple locations?',
    answer:
      'Yes. Multi-location businesses get a per-location Google Business Profile strategy, location-specific tracking, and consolidated reporting, so you can see which location produces which leads.',
  },
  {
    question: 'Do you provide on-site photography and video across the GTA?',
    answer:
      'Yes — media production is a core service, and we shoot on location across the GTA. Practical travel radius from Richmond Hill covers York Region and most of Toronto comfortably; for farther markets we confirm logistics before committing.',
  },
  {
    question: 'Can CiCon improve Google Maps rankings in multiple service areas?',
    answer:
      'Often — within honest limits. Maps visibility depends on proximity, relevance, and prominence; no agency controls proximity. We maximize the visibility that is realistically available through profile discipline, reviews, categories, and local content, and we will tell you upfront when a target is not winnable.',
  },
]

// ── Schema.org ────────────────────────────────────────────────────────────────
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    ORG_CICON,
    PERSON_MAJID,
    WEBSITE_CICON,
    {
      '@type': 'CollectionPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: TITLE,
      description: META_DESCRIPTION,
      isPartOf: { '@id': 'https://cicon.ca/#website' },
      about: { '@id': 'https://cicon.ca/#organization' },
      inLanguage: 'en-CA',
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonicalUrl}#faq`,
      mainEntity: HUB_FAQS.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://cicon.ca/' },
        { '@type': 'ListItem', position: 2, name: 'Areas Served', item: canonicalUrl },
      ],
    },
  ],
}

const publishedCount = getPublishedAreas().length
---

<!DOCTYPE html>
<html lang="en-CA">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="/fonts/fonts.css" />
  <title>{TITLE}</title>
  <meta name="description" content={META_DESCRIPTION} />
  <link rel="canonical" href={canonicalUrl} />
  {isPreview
    ? <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
    : <meta name="robots" content="index, follow" />
  }

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={TITLE} />
  <meta property="og:description" content={META_DESCRIPTION} />
  <meta property="og:image" content="https://cicon.ca/logo-cicon.jpg" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={TITLE} />
  <meta name="twitter:description" content={META_DESCRIPTION} />
  <meta name="twitter:image" content="https://cicon.ca/logo-cicon.jpg" />

  <!-- Favicon -->
  <link rel="icon" type="image/png" sizes="120x120" href="/logo-cicon-120.png" />

  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- Brand tokens -->
  <style>
    :root {
      --action:    #FFCF00;
      --accent:    #9D833E;
      --shadow:    #212129;
      --alabaster: #E7E7E7;
      --off-white: #FAFAFA;
      --charcoal:  #3A3A3A;
      --black:     #000;
    }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: 'Inter', sans-serif; background: var(--off-white); color: var(--charcoal); }
    h1, h2, h3, h4, h5, h6 { font-family: 'Clash Display', 'Inter', sans-serif; }
    details > summary { list-style: none; }
    details > summary::-webkit-details-marker { display: none; }
  </style>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

  <!-- Google Tag Manager (lazy: loads after 3.5 s or first user interaction) -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    window.gtag = gtag;
    (function () {
      function loadGTM() {
        if (window._gtmLoaded) return;
        window._gtmLoaded = true;
        (function(w,d,s,l,i){
          w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});
          var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';
          j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;
          f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','GTM-NH5ZSMKJ');
      }
      setTimeout(loadGTM, 3500);
      ['click','keydown','mousemove','touchstart','scroll'].forEach(function(ev){
        window.addEventListener(ev, loadGTM, {once:true, passive:true});
      });
    })();
  </script>
  <!-- End Google Tag Manager -->
  <!-- Meta Pixel (lazy: fbq stub queues calls immediately; fbevents.js loads after 3.5s or first interaction) -->
  <link rel="preconnect" href="https://connect.facebook.net" crossorigin />
  <script is:inline>
    !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){
    n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
    fbq('init','1299226945517753');
    fbq('track','PageView');
    (function(){
      function loadPixel(){
        if(window._fbqLoaded)return;window._fbqLoaded=true;
        var s=document.createElement('script');s.async=true;
        s.src='https://connect.facebook.net/en_US/fbevents.js';
        document.head.appendChild(s);
      }
      setTimeout(loadPixel,3500);
      ['click','keydown','mousemove','touchstart','scroll'].forEach(function(ev){
        window.addEventListener(ev,loadPixel,{once:true,passive:true});
      });
    })();
  </script>
  <noscript><img height="1" width="1" style="display:none"
  src="https://www.facebook.com/tr?id=1299226945517753&ev=PageView&noscript=1"/></noscript>
  <!-- End Meta Pixel -->
</head>

<body>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NH5ZSMKJ"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->

  <Nav />

  <AreaBreadcrumbs crumbs={[
    { label: 'Home', href: '/' },
    { label: 'Areas Served' },
  ]} />

  <div style="height:16px"></div>

  <AreaHero
    eyebrow="Richmond Hill Based · Serving the GTA"
    headline="Digital Marketing Across Richmond Hill and the Greater Toronto Area"
    valueProp="CiCon Marketing builds local SEO, paid advertising, and lead systems for businesses and dental clinics across York Region, Toronto, and selected GTA markets — senior-run, boutique, and honest about where we can actually win."
    disclosure="One office: 131 Golf Club Ct, Richmond Hill. Everywhere else we serve remotely and on location — no satellite-office theatre."
    trackSource="hub"
  />

  <!-- Trust strip -->
  <section style="background:var(--shadow);padding:0 0 48px">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap gap-x-8 gap-y-2 text-sm" style="color:#888">
        {[
          '✓ Senior strategist on every account',
          '✓ Boutique client roster',
          '✓ 14+ years in GTA markets',
          '✓ Transparent monthly reporting',
        ].map((t) => <span>{t}</span>)}
      </div>
    </div>
  </section>

  <AnswerFirst summary={SUMMARY} />

  <CityGroups groups={groups} />

  <!-- Why local market knowledge matters -->
  <section class="py-20" style="background:#fff">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-12">
        <div class="flex items-center gap-2 mb-3">
          <span class="h-[1px] w-8" style="background:var(--accent)"></span>
          <span class="text-xs font-semibold tracking-widest uppercase" style="color:var(--accent)">Why Location Matters</span>
        </div>
        <h2 class="font-heading text-3xl font-extrabold" style="color:var(--black)">
          The GTA is not one market
        </h2>
        <p class="text-base mt-3" style="color:var(--charcoal)">
          A playbook that wins in downtown Toronto loses in Aurora. Here is what actually changes from city to city — and why it changes what we build.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { t: 'Search behaviour', d: 'Suburban markets search "near me" and neighbourhood names; district markets like North York behave differently from "Toronto" queries. Targeting follows behaviour, not municipal lines.' },
          { t: 'Competition & CPC', d: 'Vaughan trades keywords cost multiples of the same click in Newmarket. Budget strategy has to respect each market’s auction, or the spend evaporates.' },
          { t: 'Maps visibility', d: 'Google Maps weighs proximity heavily. Where you can realistically rank decides where paid coverage must fill the gap — pretending otherwise wastes money.' },
          { t: 'Industry mix', d: 'Showrooms cluster in Markham, trades in Vaughan and Bolton, clinics along the Yonge corridor. The dominant local industries shape which services matter most.' },
        ].map((item) => (
          <div class="rounded-2xl border p-6" style="border-color:var(--alabaster);background:var(--off-white)">
            <div class="font-heading text-lg font-bold mb-2" style="color:var(--black)">{item.t}</div>
            <p class="text-sm leading-relaxed m-0" style="color:var(--charcoal)">{item.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <AreaServices cityName="GTA" services={HUB_SERVICES} trackSource="hub" />

  <ProcessStrip />

  <EeatBlock
    headline="One strategist, one standard, every market"
    body={`Every CiCon account — whether the business is in Richmond Hill or Pickering — is run by Majid, our senior strategist with 14+ years in performance marketing. No junior account managers, no rotating points of contact, no market too small to get the real playbook.\n\nWe currently maintain ${publishedCount} dedicated city page${publishedCount === 1 ? '' : 's'} and add more only when we can offer genuinely local substance — not swapped city names.`}
  />

  <ServiceFaq faqs={HUB_FAQS} pageUrl={canonicalUrl} />

  <GoogleReviews client:visible />

  <FinalCta
    headline="Tell us your market. We'll tell you the truth."
    body="Start a WhatsApp conversation. We'll look at your city, your competition, and your current visibility — and give you an honest read on what it takes to win there."
  />

  <Footer />

  <AreaAnalytics pageSource="hub" />
</body>
</html>
