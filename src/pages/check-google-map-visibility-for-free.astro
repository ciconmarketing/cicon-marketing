---
/**
 * /check-google-map-visibility-for-free/
 * Lead-magnet page: free local SEO heat-map scanner → manual audit CTA
 * 7 sections per brief: Hero → Localo widget → Results explainer →
 * Lead form (ContactForm) → Social proof (GoogleReviews) → FAQ → Final CTA
 */
import Nav            from '../components/Nav.astro';
import Footer         from '../components/Footer.astro';
import ContactForm    from '../components/contact/ContactForm.astro';
// Static, zero-hydration reviews. The React GoogleReviews island pulled
// React + framer-motion + Radix (349 KB raw / 112 KB gzip) onto this route for
// a testimonial carousel; this renders the same 8 GBP reviews with the same
// 7s rotation and dot nav from ~1 KB of inline JS.
import AreaReviews    from '../components/areas/AreaReviews.astro';
import LocalVisibilityScan from '../components/mapcheck/LocalVisibilityScan.astro';
import RankingByLocation   from '../components/mapcheck/RankingByLocation.astro';
import { ORG_CICON, WEBSITE_CICON } from '../lib/schema-constants';
import '../styles/globals.css';
import { getFreeMapCheckPage } from '../lib/sanity';

const isPreview    = import.meta.env.VERCEL_ENV !== 'production';
const canonicalUrl = 'https://cicon.ca/check-google-map-visibility-for-free/';

// ── FAQ data ───────────────────────────────────────────────────────────────────
const faqs = [
  {
    question: 'Is this map check really free?',
    answer:   'Yes, 100%. There is no cost to run the scan. If you request the follow-up manual audit and 90-day roadmap from our team, that initial consultation is also free.',
  },
  {
    question: 'Why do my search results look different when I check on my phone at the office?',
    answer:   'Google personalizes search results based on a user\'s exact location and search history. If you frequently search for your own business while standing at your business, Google learns to show it to you. This tool bypasses that bias to show you what an average customer sees from different points across the city.',
  },
  {
    question: 'My map shows a lot of red and orange—is it too late to fix?',
    answer:   'Absolutely not. In fact, that\'s why we built this tool. Red and orange simply mean your competitors are currently out-optimizing you. Knowing where you are losing is the first step. By optimizing your Google Business Profile, gathering reviews, and improving local relevance, you can expand your "Green Zone."',
  },
  {
    question: 'What happens after I fill out the form for the "Dominance Strategy"?',
    answer:   'We don\'t just send you a generic automated PDF. One of our local SEO specialists will manually review your heat map results, analyze your top three nearest competitors, and draft a specific 90-day roadmap with actionable steps. We will then email you to schedule a brief 15-minute call to review those findings together.',
    answerHtml: true,  // flag — rendered as HTML below so the internal link works
  },
];

// ── JSON-LD ────────────────────────────────────────────────────────────────────
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    ORG_CICON,
    WEBSITE_CICON,
    {
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: 'Free Google Maps Visibility Check | Local Ranking Heat Map',
      description: 'Is your business invisible on Google Maps? Use our free local ranking tool to see exactly where you rank. Get a real-time heat map today.',
      isPartOf: { '@id': 'https://cicon.ca/#website' },
      breadcrumb: { '@id': `${canonicalUrl}#breadcrumb` },
      inLanguage: 'en-CA',
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home',               item: 'https://cicon.ca/' },
        { '@type': 'ListItem', position: 2, name: 'Check Your Ranking', item: canonicalUrl },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonicalUrl}#faq`,
      mainEntity: faqs.map(f => ({
        '@type': 'Question',
        name:  f.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: f.answer,
        },
      })),
    },
  ],
};

// ── Sanity-driven content with hardcoded fallbacks ────────────────────────────
let mapCheckData = {
  hero: {
    headline: 'Check Your Google Map Visibility for Free',
    badge: 'Free Local SEO Tool',
    subheadline: "Check Your Google Map Visibility for Free and discover the truth about your local reach. Most businesses think they're #1 because they see themselves at the top when searching from their own office, but their customers often see something completely different.",
    description: 'Don\'t let a "false positive" search result cost you sales. Enter your business name below to get a real-time heat map of your local rankings and see exactly how you appear to customers across every corner of your city.',
    heroImage: null as { asset?: { url?: string }; alt?: string } | null,
  },
  faqs: faqs,
  finalCta: {
    headline: 'Ready to grow with a boutique marketing partner?',
    body: null as string | null,
  },
};
try {
  const sanity = await getFreeMapCheckPage();
  if (sanity?.hero?.headline) {
    mapCheckData = {
      ...mapCheckData,
      hero: { ...mapCheckData.hero, ...sanity.hero },
      faqs: sanity.faqs?.length ? sanity.faqs : faqs,
      finalCta: sanity.finalCta ?? mapCheckData.finalCta,
    };
  }
} catch {}

// Still read from Sanity — the hero visual is now the animated scanner, but
// this image continues to drive og:image / twitter:image below.
const heroImageUrl = mapCheckData.hero.heroImage?.asset?.url ?? null;
---

<!DOCTYPE html>
<html lang="en-CA">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="/fonts/fonts.css" />

  <!-- Resource hints for GTM/GA4 -->
  <link rel="preconnect" href="https://www.googletagmanager.com" />
  <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
  <link rel="preconnect" href="https://www.google-analytics.com" crossorigin />

  <!-- Lazy GTM: fires after 3.5 s or first user interaction -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    window.gtag = gtag;
    (function () {
      function loadGTM() {
        if (window._gtmLoaded) return;
        window._gtmLoaded = true;
        (function(w,d,s,l,i){
          w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});
          var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';
          j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;
          f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','GTM-NH5ZSMKJ');
      }
      setTimeout(loadGTM, 3500);
      ['click','keydown','mousemove','touchstart','scroll'].forEach(function(ev){
        window.addEventListener(ev, loadGTM, {once:true, passive:true});
      });
    })();
  </script>

  <!-- Meta Pixel (lazy: fbq stub queues calls immediately; fbevents.js loads after 3.5s or first interaction) -->
  <link rel="preconnect" href="https://connect.facebook.net" crossorigin />
  <script is:inline>
    !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){
    n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
    fbq('init','1299226945517753');
    fbq('track','PageView');
    (function(){
      function loadPixel(){
        if(window._fbqLoaded)return;window._fbqLoaded=true;
        var s=document.createElement('script');s.async=true;
        s.src='https://connect.facebook.net/en_US/fbevents.js';
        document.head.appendChild(s);
      }
      setTimeout(loadPixel,3500);
      ['click','keydown','mousemove','touchstart','scroll'].forEach(function(ev){
        window.addEventListener(ev,loadPixel,{once:true,passive:true});
      });
    })();
  </script>
  <noscript><img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=1299226945517753&ev=PageView&noscript=1" alt="" /></noscript>
  <!-- End Meta Pixel -->

  <!-- Primary meta — preserve exact SEO copy -->
  <title>Free Google Maps Visibility Check | Local Ranking Heat Map</title>
  <meta name="description" content="Is your business invisible on Google Maps? Use our free local ranking tool to see exactly where you rank. Get a real-time heat map today." />
  <link rel="canonical" href={canonicalUrl} />
  {isPreview
    ? <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
    : <meta name="robots" content="index, follow" />
  }

  <!-- Open Graph -->
  <meta property="og:type"        content="website" />
  <meta property="og:url"         content={canonicalUrl} />
  <meta property="og:title"       content="Free Google Maps Visibility Check | Local Ranking Heat Map" />
  <meta property="og:description" content="Is your business invisible on Google Maps? Use our free local ranking tool to see exactly where you rank. Get a real-time heat map today." />
  <meta property="og:image"       content={heroImageUrl ?? 'https://cicon.ca/logo-cicon.jpg'} />
  <meta name="twitter:card"       content="summary_large_image" />
  <meta name="twitter:title"      content="Free Google Maps Visibility Check | Local Ranking Heat Map" />
  <meta name="twitter:description" content="Is your business invisible on Google Maps? Use our free local ranking tool to see exactly where you rank. Get a real-time heat map today." />
  <meta name="twitter:image"      content={heroImageUrl ?? 'https://cicon.ca/logo-cicon.jpg'} />

  <!-- JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- Favicon -->
  <link rel="icon" type="image/png" sizes="120x120" href="/logo-cicon-120.png" />

  <!-- Fonts: self-hosted via @fontsource-variable/inter in globals.css (no CDN, no render-block) -->

  <!-- Brand tokens -->
  <style>
    :root {
      --action:    #FFCF00;
      --accent:    #9D833E;
      --shadow:    #212129;
      --alabaster: #E7E7E7;
      --off-white: #FAFAFA;
      --charcoal:  #3A3A3A;
      --wa-bright: #25D366;
      --wa-deep:   #128C7E;
      --wa-bright-h: #1FB855;
      --wa-deep-h:   #0E6E63;
    }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: 'Inter', sans-serif; background: var(--off-white); color: var(--charcoal); }
    h1,h2,h3,h4,h5,h6 { font-family: 'Clash Display', 'Inter', sans-serif; }
    details > summary { list-style: none; cursor: pointer; }
    details > summary::-webkit-details-marker { display: none; }
  </style>
</head>

<body>
  <!-- GTM noscript -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NH5ZSMKJ"
  height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>

  <Nav />

  <!-- Wraps the page's primary content so the document exposes a `main`
       landmark. Purely semantic — no styling attached, so nothing moves. -->
  <main id="main">

  <!-- ══════════════════════════════════════════════════════════════════════
       SECTION 1 — HERO
       ═════════════════════════════════════════════════════════════════════ -->
  <!-- Vertical padding is deliberately generous on desktop so the animated
       scanner (vertically centred against the taller copy column) isn't tight
       against the nav above or the tool section below. Mobile keeps the
       original rhythm — see the media query under this section. -->
  <section
    aria-labelledby="page-h1"
    class="hero-section"
    style="background:var(--shadow);padding:112px 0 100px;overflow:hidden;"
  >
    <div class="container-xl">
      <!-- minmax(0,…) rather than a bare 1fr: a bare 1fr floors each track at
           its item's min-content, which let the scanner widen its own column
           and squeeze the copy to ~120px on tablets.
           The 1.45 bias keeps the scanner ~690px at desktop, which is the
           width its map needs to hold the approved 16:9 proportions without
           the metrics rail stretching it square. -->
      <div class="hero-grid" style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.45fr);gap:56px;align-items:center;">

        <!-- Left: copy -->
        <div>
          <p style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.15em;color:var(--action);margin:0 0 16px;">
            {mapCheckData.hero.badge}
          </p>
          <h1
            id="page-h1"
            class="font-heading"
            style="font-size:clamp(1.9rem,3.8vw,3rem);font-weight:900;color:#fff;line-height:1.1;letter-spacing:-0.02em;margin:0 0 24px;"
          >
            {mapCheckData.hero.headline}
          </h1>

          <p style="font-size:1.05rem;line-height:1.72;color:rgba(255,255,255,0.75);margin:0 0 16px;">
            {mapCheckData.hero.subheadline}
          </p>

          <p style="font-size:1.05rem;line-height:1.72;color:rgba(255,255,255,0.75);margin:0;">
            {mapCheckData.hero.description}
          </p>
        </div>

        <!-- Right: animated Local Visibility Scan.
             Server-rendered SVG/CSS — no image request, so the hero's LCP
             candidate stays the H1 text. The Sanity hero image is still read
             above and still drives og:image / twitter:image unchanged. -->
        <div style="display:flex;align-items:center;justify-content:center;">
          <LocalVisibilityScan />
        </div>

      </div>
    </div>
  </section>

  <style>
    /* Below ~1024px two columns leave neither the copy nor the scanner enough
       room, so stack them and let each use the full width. */
    @media (max-width: 1023px) {
      .hero-grid { grid-template-columns: minmax(0, 1fr) !important; gap: 40px !important; }
      .hero-section { padding: 88px 0 80px !important; }
    }
    @media (max-width: 767px) {
      .hero-grid { gap: 32px !important; }
      /* stacked layout — keep the original mobile rhythm */
      .hero-section { padding: 72px 0 64px !important; }
    }
  </style>


  <!-- ══════════════════════════════════════════════════════════════════════
       SECTION 2 — LOCALO HEAT MAP WIDGET
       ═════════════════════════════════════════════════════════════════════ -->
  <section
    aria-label="Local SEO ranking heat map scanner"
    style="padding:56px 0;background:#fff;"
  >
    <div class="container-xl">
      <div
        style="max-width:900px;margin:0 auto;background:var(--off-white);border-radius:20px;padding:8px;border:1px solid var(--alabaster);overflow:hidden;"
      >
        <!-- Localo Local Rank Checker widget.
             is:inline prevents Astro from hoisting/bundling these, which would
             break the window.LOCALO_FREE_TOOL global assignment. The config
             MUST exist before freetool.js runs, so it stays inline and eager —
             it's three lines and no network cost.

             freetool.js itself is injected only once the tool nears the
             viewport. It pulls in reCAPTCHA and its own bundle (the bulk of
             this page's network payload) and prompts for geolocation on init,
             so loading it on page load spent all of that — and showed a
             location permission prompt — before the visitor had scrolled to
             the tool at all. Token, container, search, analysis and results
             behaviour are untouched; only the moment of loading changed. -->
        <script is:inline>
          window.LOCALO_FREE_TOOL = {
            container: "#free-tool",
            token: "fZbYFB16Tex919WferyoqZSqjwJGcutPy265taFBWno"
          };
        </script>

        <div id="free-tool" role="region" aria-label="Google Maps ranking heat map scanner" aria-busy="true">Loading...</div>

        <!-- Colour-only override on the widget's own "Powered by Localo"
             credit line, which ships at #999 on #fafafa (2.7:1). We can't edit
             their markup; this just darkens the text to clear AA. If Localo
             renames the class the rule simply stops applying — nothing breaks. -->
        <style is:global>
          #free-tool .localo-free-tool-credits,
          #free-tool .localo-free-tool-credits a { color: #6B6459 !important; }
        </style>

        <script is:inline>
          (function () {
            var host = document.getElementById('free-tool');
            if (!host) return;
            var loaded = false;

            function load() {
              if (loaded) return;
              loaded = true;
              var s = document.createElement('script');
              s.src = 'https://jstools.localo.app/scripts/freetool.js';
              s.async = true;
              s.onload = function () { host.setAttribute('aria-busy', 'false'); };
              document.head.appendChild(s);

              // The widget injects its own iframes (incl. reCAPTCHA) with no
              // title, which fails the frame-title audit. We can't change their
              // markup, but we can label frames as they appear.
              var mo = new MutationObserver(function () {
                var frames = document.querySelectorAll('#free-tool iframe:not([title])');
                for (var i = 0; i < frames.length; i++) {
                  frames[i].setAttribute('title', 'Google Maps ranking heat map scanner');
                }
              });
              mo.observe(host, { childList: true, subtree: true });
              setTimeout(function () { mo.disconnect(); }, 30000);
            }

            if (!('IntersectionObserver' in window)) { load(); return; }

            // 250px of runway: enough that the widget is fetching before it
            // scrolls into view, but not so much that it fires at rest on a
            // phone, where the tool already sits only ~300px below the fold.
            function observeViewport() {
              var io = new IntersectionObserver(function (entries) {
                if (entries[0].isIntersecting) { io.disconnect(); load(); }
              }, { rootMargin: '250px 0px' });
              io.observe(host);
            }

            // Is the tool already within the observer's margin right now? On a
            // phone it sits ~370px below the fold, so this is false and the
            // viewport path below runs exactly as before — mobile behaviour is
            // deliberately untouched. On a desktop viewport it is true, which
            // previously meant the whole Localo + reCAPTCHA stack (~2.3 MB)
            // downloaded and executed during initial load purely because the
            // widget happened to be on screen. There, wait for intent instead.
            var box = host.getBoundingClientRect();
            var alreadyInView = box.top < window.innerHeight + 250 && box.bottom > -250;
            if (!alreadyInView) { observeViewport(); return; }

            // ── Intent-activated path (tool visible at load) ────────────────
            // Reserve the widget's rendered height so activating it doesn't
            // shift the page, and give the region a real button so it is
            // keyboard-reachable and announced properly.
            host.style.minHeight = host.offsetHeight > 380 ? '' : '391px';
            host.setAttribute('aria-busy', 'false');
            host.innerHTML =
              '<button type="button" class="ft-start" ' +
              'aria-label="Load the Google Maps ranking scanner">' +
              '<span class="ft-start-icon" aria-hidden="true">▶</span>' +
              '<span class="ft-start-text">Click to load the scanner</span>' +
              '</button>';

            var btn = host.querySelector('.ft-start');
            var started = false;

            function activate() {
              if (started) return;
              started = true;
              host.innerHTML = '<p class="ft-loading" role="status">Loading the scanner…</p>';
              host.setAttribute('aria-busy', 'true');
              load();
              // Hand the visitor straight into the tool so the click that
              // started it doesn't have to be repeated once it renders.
              var tries = 0;
              var focusTimer = setInterval(function () {
                var field = host.querySelector('input, [contenteditable="true"], button');
                if (field) { clearInterval(focusTimer); try { field.focus({ preventScroll: true }); } catch (e) {} }
                else if (++tries > 60) { clearInterval(focusTimer); }
              }, 250);
            }

            // Pointer entering the card is the earliest honest signal of
            // intent — it typically precedes the click by a few hundred ms, so
            // the bundle is already in flight by the time they reach the field.
            ['pointerenter', 'pointerdown', 'focusin', 'keydown', 'touchstart'].forEach(function (ev) {
              host.addEventListener(ev, activate, { once: true, passive: true });
            });
            if (btn) btn.addEventListener('click', activate, { once: true });
          })();
        </script>

        <style is:global>
          /* Pre-activation shell. Only ever rendered on viewports where the
             tool is already on screen at load; the phone path never sees it. */
          #free-tool .ft-start {
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            gap: 10px; width: 100%; min-height: 391px; padding: 24px;
            background: transparent; border: 1px dashed var(--alabaster); border-radius: 16px;
            cursor: pointer; font: inherit; color: var(--charcoal);
            transition: border-color .18s ease, background .18s ease;
          }
          #free-tool .ft-start:hover,
          #free-tool .ft-start:focus-visible { border-color: var(--accent); background: rgba(157,131,62,0.04); }
          #free-tool .ft-start-icon {
            display: flex; align-items: center; justify-content: center;
            width: 44px; height: 44px; border-radius: 50%;
            background: var(--shadow); color: #fff; font-size: 15px; padding-left: 3px;
          }
          #free-tool .ft-start-text { font-size: 0.95rem; font-weight: 600; }
          #free-tool .ft-loading {
            display: flex; align-items: center; justify-content: center;
            min-height: 391px; margin: 0; font-size: 0.95rem; color: var(--charcoal);
          }
        </style>
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════════════════
       SECTION 2b — BRIDGE → EDUCATIONAL ANIMATION
       Deliberately quiet: one line, no heading, no CTA. Its only job is to
       carry the visitor from "here is my result" to "but ranking depends on
       where the search happens" before the animation explains why.
       ═════════════════════════════════════════════════════════════════════ -->
  <div class="mapcheck-bridge">
    <div class="container-xl" style="max-width:800px;">
      <div style="display:flex;align-items:center;gap:14px;">
        <span aria-hidden="true" class="mapcheck-bridge-rule"></span>
        <p style="margin:0;font-size:0.95rem;line-height:1.6;color:rgba(58,58,58,0.72);">
          One pin is one opinion. Here is what the same search looks like from across your service area.
        </p>
      </div>
    </div>
  </div>

  <RankingByLocation />


  <!-- ══════════════════════════════════════════════════════════════════════
       SECTION 3 — RESULTS EXPLAINER
       ═════════════════════════════════════════════════════════════════════ -->
  <section
    aria-labelledby="results-h2"
    style="padding:72px 0;background:var(--off-white);"
  >
    <div class="container-xl" style="max-width:800px;">

      <h2
        id="results-h2"
        class="font-heading"
        style="font-size:clamp(1.6rem,3vw,2.25rem);font-weight:900;color:#000;letter-spacing:-0.02em;line-height:1.15;margin:0 0 20px;"
      >
        Did you see Red or Orange dots?
      </h2>

      <p style="font-size:1.2rem;font-weight:700;color:var(--shadow);line-height:1.4;margin:0 0 40px;">
        If you aren't in the Top 3, you are losing 75% of local mobile clicks.
      </p>

      <div class="explainer-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:24px;">

        <!-- Red -->
        <div style="background:#fff;border:1px solid #fecaca;border-left:4px solid #DC2626;border-radius:12px;padding:28px 24px;">
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:14px;">
            <span
              style="width:18px;height:18px;border-radius:50%;background:#DC2626;flex-shrink:0;display:inline-block;"
              aria-hidden="true"
            ></span>
            <h3 class="font-heading" style="font-size:1.05rem;font-weight:800;color:#DC2626;margin:0;">Red Dots</h3>
          </div>
          <p style="font-size:0.97rem;line-height:1.65;color:var(--charcoal);margin:0;">
            Your business is buried on page 2 or 3. Customers can't find you. You're effectively invisible to anyone not searching from directly outside your door.
          </p>
        </div>

        <!-- Orange -->
        <div style="background:#fff;border:1px solid #fed7aa;border-left:4px solid #EA580C;border-radius:12px;padding:28px 24px;">
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:14px;">
            <span
              style="width:18px;height:18px;border-radius:50%;background:#EA580C;flex-shrink:0;display:inline-block;"
              aria-hidden="true"
            ></span>
            <!-- Heading text only: #EA580C is 3.56:1 on white, under AA. The
                 dot swatch, border and card keep the original orange — only
                 this small bold label darkens to clear 4.5:1. -->
            <h3 class="font-heading" style="font-size:1.05rem;font-weight:800;color:#C44405;margin:0;">Orange Dots</h3>
          </div>
          <p style="font-size:0.97rem;line-height:1.65;color:var(--charcoal);margin:0;">
            You're close, but a competitor is currently taking your leads. Positions 4–10 capture a fraction of the clicks that positions 1–3 do. Close is not close enough.
          </p>
        </div>

      </div>
    </div>
  </section>

  <style>
    @media (max-width: 599px) {
      .explainer-grid { grid-template-columns: 1fr !important; }
    }

    /* The bridge line has to read as the lead-in to the animation below it,
       not as its own little section. It sits tight under the tool (the tool
       section's own bottom padding is pulled back here) and close above the
       educational block. */
    .mapcheck-bridge {
      background: #fff;
      padding: 0 0 18px;
      margin-top: -34px;
    }
    .mapcheck-bridge-rule {
      flex: none;
      width: 1px;
      height: 30px;
      background: linear-gradient(to bottom, transparent, var(--alabaster));
    }
    @media (max-width: 767px) {
      .mapcheck-bridge { padding-bottom: 14px; margin-top: -26px; }
    }
  </style>


  <!-- ══════════════════════════════════════════════════════════════════════
       SECTION 4 — LEAD CAPTURE FORM
       ═════════════════════════════════════════════════════════════════════ -->
  <section
    id="audit-form"
    aria-labelledby="audit-h2"
    style="padding:80px 0;background:#fff;scroll-margin-top:80px;"
  >
    <div class="container-xl">

      <div style="max-width:680px;margin:0 auto;">
        <p style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.15em;color:var(--accent);margin:0 0 14px;">
          Free audit — no strings
        </p>
        <h2
          id="audit-h2"
          class="font-heading"
          style="font-size:clamp(1.6rem,3vw,2.25rem);font-weight:900;color:#000;letter-spacing:-0.02em;line-height:1.15;margin:0 0 16px;"
        >
          Get Your Full "Local Dominance" Strategy Audit
        </h2>
        <p style="font-size:1.05rem;line-height:1.7;color:rgba(58,58,58,0.8);margin:0 0 36px;">
          The scan above shows <em>where</em> you are. Our team will show you <em>how</em> to fix it. Fill out the form below to receive a manual audit of your top 3 competitors and a 90-day growth roadmap.
        </p>
      </div>

      <!-- Reuse ContactForm exactly — source tagged, submit label overridden -->
      <div style="max-width:680px;margin:0 auto;">
        <ContactForm
          source="Google Map Visibility Audit"
          submitLabel="Get My Free Audit"
        />
      </div>

    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════════════════
       SECTION 5 — SOCIAL PROOF (Home page GoogleReviews — unchanged)
       ═════════════════════════════════════════════════════════════════════ -->
  <AreaReviews />


  <!-- ══════════════════════════════════════════════════════════════════════
       SECTION 6 — FAQ
       ═════════════════════════════════════════════════════════════════════ -->
  <section
    aria-labelledby="faq-h2"
    style="padding:88px 0;background:#fff;"
  >
    <div class="container-xl" style="max-width:800px;">
      <p style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.15em;color:var(--accent);margin:0 0 14px;">
        FAQ
      </p>
      <h2
        id="faq-h2"
        class="font-heading"
        style="font-size:clamp(1.6rem,3vw,2.25rem);font-weight:900;color:#000;letter-spacing:-0.02em;line-height:1.15;margin:0 0 44px;"
      >
        Frequently Asked Questions
      </h2>

      <!-- No role="list"/role="listitem": `listitem` is not a permitted role on
           <details>, which broke the accessibility tree. <details>/<summary>
           already expose the correct disclosure semantics on their own, and
           they also manage their own expanded state — so no hardcoded
           aria-expanded either (it was always reporting "false", even when the
           answer was open). -->
      <div style="display:flex;flex-direction:column;gap:8px;">

        {mapCheckData.faqs.map((faq: { question: string; answer: string }) => (
          <details style="background:var(--off-white);border:1px solid var(--alabaster);border-radius:12px;overflow:hidden;">
            <summary
              style="display:flex;align-items:center;justify-content:space-between;gap:16px;padding:22px 24px;font-size:1rem;font-weight:700;color:#000;line-height:1.4;"
            >
              <span>{faq.question}</span>
              <svg class="faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" style="flex-shrink:0;color:var(--accent);transition:transform .25s ease;">
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </summary>
            <div style="padding:0 24px 22px;border-top:1px solid var(--alabaster);">
              <p style="font-size:0.97rem;line-height:1.72;color:rgba(58,58,58,0.85);margin:16px 0 0;">
                {faq.answer}
              </p>
            </div>
          </details>
        ))}

      </div>
    </div>
  </section>

  <style>
    details[open] > summary .faq-chevron { transform: rotate(180deg); }
    details > summary:focus-visible { outline: 2px solid var(--action); outline-offset: -2px; border-radius: 12px; }
  </style>


  <!-- ══════════════════════════════════════════════════════════════════════
       SECTION 7 — FINAL CTA
       ═════════════════════════════════════════════════════════════════════ -->
  <section
    aria-labelledby="final-cta-h2"
    style="padding:88px 0;background:var(--shadow);text-align:center;"
  >
    <div class="container-xl" style="max-width:640px;">

      <p style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.15em;color:var(--action);margin:0 0 16px;">
        Boutique. GTA. Results.
      </p>
      <h2
        id="final-cta-h2"
        class="font-heading"
        style="font-size:clamp(1.75rem,3.5vw,2.75rem);font-weight:900;color:#fff;letter-spacing:-0.025em;line-height:1.1;margin:0 0 32px;"
      >
        {mapCheckData.finalCta.headline}
      </h2>

      <div class="cta-buttons" style="display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:14px;">

        <!-- WhatsApp CTA -->
        <a
          href="https://wa.me/16475840800"
          target="_blank"
          rel="noopener noreferrer"
          data-event="whatsapp_click"
          style="display:inline-flex;align-items:center;gap:10px;padding:15px 32px;background:var(--wa-bright);color:#10231A;font-weight:700;font-size:15px;border-radius:12px;text-decoration:none;transition:background .15s;"
          onmouseover="this.style.background='var(--wa-bright-h)'"
          onmouseout="this.style.background='var(--wa-bright)'"
          aria-label="Chat on WhatsApp with CiCon Marketing"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Chat on WhatsApp
        </a>

        <!-- Secondary: Contact Us -->
        <a
          href="/contact-us/"
          style="display:inline-flex;align-items:center;gap:8px;padding:15px 32px;border:2px solid rgba(255,255,255,0.3);color:#fff;font-weight:600;font-size:15px;border-radius:12px;text-decoration:none;transition:border-color .15s,background .15s;"
          onmouseover="this.style.borderColor='rgba(255,255,255,0.7)';this.style.background='rgba(255,255,255,0.07)'"
          onmouseout="this.style.borderColor='rgba(255,255,255,0.3)';this.style.background='transparent'"
        >
          Contact Us
        </a>

      </div>

    </div>
  </section>

  <style>
    @media (max-width: 479px) {
      .cta-buttons { flex-direction: column; align-items: stretch !important; }
      .cta-buttons a { justify-content: center; }
    }
  </style>


  </main>

  <Footer />

</body>
</html>
