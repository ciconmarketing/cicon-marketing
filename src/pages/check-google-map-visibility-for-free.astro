---
/**
 * /check-google-map-visibility-for-free/
 * Lead-magnet page: free local SEO heat-map scanner → manual audit CTA
 * 7 sections per brief: Hero → Localo widget → Results explainer →
 * Lead form (ContactForm) → Social proof (GoogleReviews) → FAQ → Final CTA
 */
import Nav            from '../components/Nav.astro';
import Footer         from '../components/Footer.astro';
import ContactForm    from '../components/contact/ContactForm.astro';
import GoogleReviews  from '../components/react/GoogleReviews.tsx';
import { ORG_CICON, WEBSITE_CICON } from '../lib/schema-constants';
import '../styles/globals.css';

const isPreview    = import.meta.env.VERCEL_ENV !== 'production';
const canonicalUrl = 'https://cicon.ca/check-google-map-visibility-for-free/';

// ── FAQ data ───────────────────────────────────────────────────────────────────
const faqs = [
  {
    question: 'Is this map check really free?',
    answer:   'Yes, 100%. There is no cost to run the scan. If you request the follow-up manual audit and 90-day roadmap from our team, that initial consultation is also free.',
  },
  {
    question: 'Why do my search results look different when I check on my phone at the office?',
    answer:   'Google personalizes search results based on a user\'s exact location and search history. If you frequently search for your own business while standing at your business, Google learns to show it to you. This tool bypasses that bias to show you what an average customer sees from different points across the city.',
  },
  {
    question: 'My map shows a lot of red and orange—is it too late to fix?',
    answer:   'Absolutely not. In fact, that\'s why we built this tool. Red and orange simply mean your competitors are currently out-optimizing you. Knowing where you are losing is the first step. By optimizing your Google Business Profile, gathering reviews, and improving local relevance, you can expand your "Green Zone."',
  },
  {
    question: 'What happens after I fill out the form for the "Dominance Strategy"?',
    answer:   'We don\'t just send you a generic automated PDF. One of our local SEO specialists will manually review your heat map results, analyze your top three nearest competitors, and draft a specific 90-day roadmap with actionable steps. We will then email you to schedule a brief 15-minute call to review those findings together.',
    answerHtml: true,  // flag — rendered as HTML below so the internal link works
  },
];

// ── JSON-LD ────────────────────────────────────────────────────────────────────
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    ORG_CICON,
    WEBSITE_CICON,
    {
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: 'Free Google Maps Visibility Check | Local Ranking Heat Map',
      description: 'Is your business invisible on Google Maps? Use our free local ranking tool to see exactly where you rank. Get a real-time heat map today.',
      isPartOf: { '@id': 'https://cicon.ca/#website' },
      breadcrumb: { '@id': `${canonicalUrl}#breadcrumb` },
      inLanguage: 'en-CA',
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home',               item: 'https://cicon.ca/' },
        { '@type': 'ListItem', position: 2, name: 'Check Your Ranking', item: canonicalUrl },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonicalUrl}#faq`,
      mainEntity: faqs.map(f => ({
        '@type': 'Question',
        name:  f.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: f.answer,
        },
      })),
    },
  ],
};
---

<!DOCTYPE html>
<html lang="en-CA">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Google Tag Manager -->
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-NH5ZSMKJ');</script>
  <!-- End Google Tag Manager -->

  <!-- Facebook Pixel -->
  <script is:inline>
  !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
  n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
  n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
  t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
  document,'script','https://connect.facebook.net/en_US/fbevents.js');
  fbq('init','1299226945517753');
  fbq('track','PageView');
  </script>
  <noscript><img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=1299226945517753&ev=PageView&noscript=1" alt="" /></noscript>
  <!-- End Facebook Pixel -->

  <!-- Primary meta — preserve exact SEO copy -->
  <title>Free Google Maps Visibility Check | Local Ranking Heat Map</title>
  <meta name="description" content="Is your business invisible on Google Maps? Use our free local ranking tool to see exactly where you rank. Get a real-time heat map today." />
  <link rel="canonical" href={canonicalUrl} />
  {isPreview
    ? <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
    : <meta name="robots" content="index, follow" />
  }

  <!-- Open Graph — OG image stays as Google-Map-Visibility-for-Free-3-3.jpg (not used on page) -->
  <meta property="og:type"        content="website" />
  <meta property="og:url"         content={canonicalUrl} />
  <meta property="og:title"       content="Free Google Maps Visibility Check | Local Ranking Heat Map" />
  <meta property="og:description" content="Is your business invisible on Google Maps? Use our free local ranking tool to see exactly where you rank. Get a real-time heat map today." />
  <meta property="og:image"       content="https://cicon.ca/wp-content/uploads/2026/03/Google-Map-Visibility-for-Free-3-3.jpg" />
  <meta name="twitter:card"       content="summary_large_image" />
  <meta name="twitter:title"      content="Free Google Maps Visibility Check | Local Ranking Heat Map" />
  <meta name="twitter:description" content="Is your business invisible on Google Maps? Use our free local ranking tool to see exactly where you rank. Get a real-time heat map today." />
  <meta name="twitter:image"      content="https://cicon.ca/wp-content/uploads/2026/03/Google-Map-Visibility-for-Free-3-3.jpg" />

  <!-- JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

  <!-- Brand tokens -->
  <style>
    :root {
      --action:    #FFCF00;
      --accent:    #9D833E;
      --shadow:    #212129;
      --alabaster: #E7E7E7;
      --off-white: #FAFAFA;
      --charcoal:  #3A3A3A;
      --wa-bright: #25D366;
      --wa-deep:   #128C7E;
      --wa-bright-h: #1FB855;
      --wa-deep-h:   #0E6E63;
    }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: 'Inter', sans-serif; background: var(--off-white); color: var(--charcoal); }
    h1,h2,h3,h4,h5,h6 { font-family: 'Inter', sans-serif; }
    details > summary { list-style: none; cursor: pointer; }
    details > summary::-webkit-details-marker { display: none; }
  </style>
</head>

<body>
  <!-- GTM noscript -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NH5ZSMKJ"
  height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>

  <Nav />

  <!-- ══════════════════════════════════════════════════════════════════════
       SECTION 1 — HERO
       ═════════════════════════════════════════════════════════════════════ -->
  <section
    aria-labelledby="page-h1"
    style="background:var(--shadow);padding:80px 0 72px;overflow:hidden;"
  >
    <div class="container-xl">
      <div class="hero-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center;">

        <!-- Left: copy -->
        <div>
          <p style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.15em;color:var(--action);margin:0 0 16px;">
            Free Local SEO Tool
          </p>
          <h1
            id="page-h1"
            style="font-size:clamp(1.9rem,3.8vw,3rem);font-weight:900;color:#fff;line-height:1.1;letter-spacing:-0.02em;margin:0 0 24px;"
          >
            Check Your Google Map Visibility for Free
          </h1>

          <p style="font-size:1.05rem;line-height:1.72;color:rgba(255,255,255,0.75);margin:0 0 16px;">
            Check Your Google Map Visibility for Free and discover the truth about your local reach. Most businesses think they're #1 because they see themselves at the top when searching from their own office, but their customers often see something completely different.
          </p>

          <p style="font-size:1.05rem;line-height:1.72;color:rgba(255,255,255,0.75);margin:0;">
            Don't let a "false positive" search result cost you sales. Enter your business name below to get a real-time heat map of your local rankings and see exactly how you appear to customers across every corner of your city.
          </p>
        </div>

        <!-- Right: illustration -->
        <div style="display:flex;align-items:center;justify-content:center;">
          <!--
            TODO: Copy image to public/images/google-maps-visibility-heat-map-audit.jpg
            Source: https://cicon.ca/wp-content/uploads/2026/03/google-maps-visibility-heat-map-audit-1-768x355.jpg
          -->
          <img
            src="/wp-content/uploads/2026/03/google-maps-visibility-heat-map-audit-1-768x355.jpg"
            alt="Dashboard interface of a local SEO rank tracking tool showing a geographical Position Map with circular heat map markers in green and orange, indicating search ranking positions across a city area."
            width="768"
            height="355"
            loading="eager"
            fetchpriority="high"
            style="width:100%;height:auto;border-radius:12px;box-shadow:0 24px 48px rgba(0,0,0,0.3);"
          />
        </div>

      </div>
    </div>
  </section>

  <style>
    @media (max-width: 767px) {
      .hero-grid { grid-template-columns: 1fr !important; gap: 32px !important; }
    }
  </style>


  <!-- ══════════════════════════════════════════════════════════════════════
       SECTION 2 — LOCALO HEAT MAP WIDGET
       ═════════════════════════════════════════════════════════════════════ -->
  <section
    aria-label="Local SEO ranking heat map scanner"
    style="padding:56px 0;background:#fff;"
  >
    <div class="container-xl">
      <div
        style="max-width:900px;margin:0 auto;background:var(--off-white);border-radius:20px;padding:8px;border:1px solid var(--alabaster);overflow:hidden;"
      >
        <!--
          Localo public scanner widget — pulled from live page
          src: https://app.localo.com/_demo/place-import
          Original embed: <div id="free-tool"> containing an iframe
        -->
        <iframe
          src="https://app.localo.com/_demo/place-import"
          allow="geolocation"
          loading="lazy"
          title="Free Google Maps local ranking heat map scanner — enter your business name to see your visibility"
          style="border:none;height:400px;width:100%;border-radius:16px;min-height:200px;display:block;"
        ></iframe>
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════════════════
       SECTION 3 — RESULTS EXPLAINER
       ═════════════════════════════════════════════════════════════════════ -->
  <section
    aria-labelledby="results-h2"
    style="padding:72px 0;background:var(--off-white);"
  >
    <div class="container-xl" style="max-width:800px;">

      <h2
        id="results-h2"
        style="font-size:clamp(1.6rem,3vw,2.25rem);font-weight:900;color:#000;letter-spacing:-0.02em;line-height:1.15;margin:0 0 20px;"
      >
        Did you see Red or Orange dots?
      </h2>

      <p style="font-size:1.2rem;font-weight:700;color:var(--shadow);line-height:1.4;margin:0 0 40px;">
        If you aren't in the Top 3, you are losing 75% of local mobile clicks.
      </p>

      <div class="explainer-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:24px;">

        <!-- Red -->
        <div style="background:#fff;border:1px solid #fecaca;border-left:4px solid #DC2626;border-radius:12px;padding:28px 24px;">
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:14px;">
            <span
              style="width:18px;height:18px;border-radius:50%;background:#DC2626;flex-shrink:0;display:inline-block;"
              aria-hidden="true"
            ></span>
            <h3 style="font-size:1.05rem;font-weight:800;color:#DC2626;margin:0;">Red Dots</h3>
          </div>
          <p style="font-size:0.97rem;line-height:1.65;color:var(--charcoal);margin:0;">
            Your business is buried on page 2 or 3. Customers can't find you. You're effectively invisible to anyone not searching from directly outside your door.
          </p>
        </div>

        <!-- Orange -->
        <div style="background:#fff;border:1px solid #fed7aa;border-left:4px solid #EA580C;border-radius:12px;padding:28px 24px;">
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:14px;">
            <span
              style="width:18px;height:18px;border-radius:50%;background:#EA580C;flex-shrink:0;display:inline-block;"
              aria-hidden="true"
            ></span>
            <h3 style="font-size:1.05rem;font-weight:800;color:#EA580C;margin:0;">Orange Dots</h3>
          </div>
          <p style="font-size:0.97rem;line-height:1.65;color:var(--charcoal);margin:0;">
            You're close, but a competitor is currently taking your leads. Positions 4–10 capture a fraction of the clicks that positions 1–3 do. Close is not close enough.
          </p>
        </div>

      </div>
    </div>
  </section>

  <style>
    @media (max-width: 599px) {
      .explainer-grid { grid-template-columns: 1fr !important; }
    }
  </style>


  <!-- ══════════════════════════════════════════════════════════════════════
       SECTION 4 — LEAD CAPTURE FORM
       ═════════════════════════════════════════════════════════════════════ -->
  <section
    id="audit-form"
    aria-labelledby="audit-h2"
    style="padding:80px 0;background:#fff;scroll-margin-top:80px;"
  >
    <div class="container-xl">

      <div style="max-width:680px;margin:0 auto;">
        <p style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.15em;color:var(--accent);margin:0 0 14px;">
          Free audit — no strings
        </p>
        <h2
          id="audit-h2"
          style="font-size:clamp(1.6rem,3vw,2.25rem);font-weight:900;color:#000;letter-spacing:-0.02em;line-height:1.15;margin:0 0 16px;"
        >
          Get Your Full "Local Dominance" Strategy Audit
        </h2>
        <p style="font-size:1.05rem;line-height:1.7;color:rgba(58,58,58,0.8);margin:0 0 36px;">
          The scan above shows <em>where</em> you are. Our team will show you <em>how</em> to fix it. Fill out the form below to receive a manual audit of your top 3 competitors and a 90-day growth roadmap.
        </p>
      </div>

      <!-- Reuse ContactForm exactly — source tagged, submit label overridden -->
      <div style="max-width:680px;margin:0 auto;">
        <ContactForm
          source="Google Map Visibility Audit"
          submitLabel="Get My Free Audit"
        />
      </div>

    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════════════════════
       SECTION 5 — SOCIAL PROOF (Home page GoogleReviews — unchanged)
       ═════════════════════════════════════════════════════════════════════ -->
  <div style="background:var(--off-white);">
    <GoogleReviews client:visible />
  </div>


  <!-- ══════════════════════════════════════════════════════════════════════
       SECTION 6 — FAQ
       ═════════════════════════════════════════════════════════════════════ -->
  <section
    aria-labelledby="faq-h2"
    style="padding:88px 0;background:#fff;"
  >
    <div class="container-xl" style="max-width:800px;">
      <p style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.15em;color:var(--accent);margin:0 0 14px;">
        FAQ
      </p>
      <h2
        id="faq-h2"
        style="font-size:clamp(1.6rem,3vw,2.25rem);font-weight:900;color:#000;letter-spacing:-0.02em;line-height:1.15;margin:0 0 44px;"
      >
        Frequently Asked Questions
      </h2>

      <div style="display:flex;flex-direction:column;gap:8px;" role="list">

        <!-- Q1 -->
        <details role="listitem" style="background:var(--off-white);border:1px solid var(--alabaster);border-radius:12px;overflow:hidden;">
          <summary
            style="display:flex;align-items:center;justify-content:space-between;gap:16px;padding:22px 24px;font-size:1rem;font-weight:700;color:#000;line-height:1.4;"
            aria-expanded="false"
          >
            <span>Is this map check really free?</span>
            <svg class="faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" style="flex-shrink:0;color:var(--accent);transition:transform .25s ease;">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </summary>
          <div style="padding:0 24px 22px;border-top:1px solid var(--alabaster);">
            <p style="font-size:0.97rem;line-height:1.72;color:rgba(58,58,58,0.85);margin:16px 0 0;">
              Yes, 100%. There is no cost to run the scan. If you request the follow-up manual audit and 90-day roadmap from our team, that initial consultation is also free.
            </p>
          </div>
        </details>

        <!-- Q2 -->
        <details role="listitem" style="background:var(--off-white);border:1px solid var(--alabaster);border-radius:12px;overflow:hidden;">
          <summary
            style="display:flex;align-items:center;justify-content:space-between;gap:16px;padding:22px 24px;font-size:1rem;font-weight:700;color:#000;line-height:1.4;"
            aria-expanded="false"
          >
            <span>Why do my search results look different when I check on my phone at the office?</span>
            <svg class="faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" style="flex-shrink:0;color:var(--accent);transition:transform .25s ease;">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </summary>
          <div style="padding:0 24px 22px;border-top:1px solid var(--alabaster);">
            <p style="font-size:0.97rem;line-height:1.72;color:rgba(58,58,58,0.85);margin:16px 0 0;">
              Google personalizes search results based on a user's exact location and search history. If you frequently search for your own business while standing <em>at</em> your business, Google learns to show it to you. This tool bypasses that bias to show you what an average customer sees from different points across the city.
            </p>
          </div>
        </details>

        <!-- Q3 -->
        <details role="listitem" style="background:var(--off-white);border:1px solid var(--alabaster);border-radius:12px;overflow:hidden;">
          <summary
            style="display:flex;align-items:center;justify-content:space-between;gap:16px;padding:22px 24px;font-size:1rem;font-weight:700;color:#000;line-height:1.4;"
            aria-expanded="false"
          >
            <span>My map shows a lot of red and orange — is it too late to fix?</span>
            <svg class="faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" style="flex-shrink:0;color:var(--accent);transition:transform .25s ease;">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </summary>
          <div style="padding:0 24px 22px;border-top:1px solid var(--alabaster);">
            <p style="font-size:0.97rem;line-height:1.72;color:rgba(58,58,58,0.85);margin:16px 0 0;">
              Absolutely not. In fact, that's why we built this tool. Red and orange simply mean your competitors are currently out-optimizing you. Knowing <em>where</em> you are losing is the first step. By optimizing your Google Business Profile, gathering reviews, and improving local relevance, you can expand your "Green Zone."
            </p>
          </div>
        </details>

        <!-- Q4 — internal link to Local SEO service page -->
        <details role="listitem" style="background:var(--off-white);border:1px solid var(--alabaster);border-radius:12px;overflow:hidden;">
          <summary
            style="display:flex;align-items:center;justify-content:space-between;gap:16px;padding:22px 24px;font-size:1rem;font-weight:700;color:#000;line-height:1.4;"
            aria-expanded="false"
          >
            <span>What happens after I fill out the form for the "Dominance Strategy"?</span>
            <svg class="faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" style="flex-shrink:0;color:var(--accent);transition:transform .25s ease;">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </summary>
          <div style="padding:0 24px 22px;border-top:1px solid var(--alabaster);">
            <p style="font-size:0.97rem;line-height:1.72;color:rgba(58,58,58,0.85);margin:16px 0 0;">
              We don't just send you a generic automated PDF. One of our <a href="/services/local-seo/" style="color:var(--accent);font-weight:600;text-decoration:underline;text-underline-offset:3px;">local SEO specialists</a> will manually review your heat map results, analyze your top three nearest competitors, and draft a specific 90-day roadmap with actionable steps. We will then email you to schedule a brief 15-minute call to review those findings together.
            </p>
          </div>
        </details>

      </div>
    </div>
  </section>

  <style>
    details[open] > summary .faq-chevron { transform: rotate(180deg); }
    details > summary:focus-visible { outline: 2px solid var(--action); outline-offset: -2px; border-radius: 12px; }
  </style>


  <!-- ══════════════════════════════════════════════════════════════════════
       SECTION 7 — FINAL CTA
       ═════════════════════════════════════════════════════════════════════ -->
  <section
    aria-labelledby="final-cta-h2"
    style="padding:88px 0;background:var(--shadow);text-align:center;"
  >
    <div class="container-xl" style="max-width:640px;">

      <p style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.15em;color:var(--action);margin:0 0 16px;">
        Boutique. GTA. Results.
      </p>
      <h2
        id="final-cta-h2"
        style="font-size:clamp(1.75rem,3.5vw,2.75rem);font-weight:900;color:#fff;letter-spacing:-0.025em;line-height:1.1;margin:0 0 32px;"
      >
        Ready to grow with a boutique marketing partner?
      </h2>

      <div class="cta-buttons" style="display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:14px;">

        <!-- WhatsApp CTA -->
        <a
          href="https://wa.me/16475840800"
          target="_blank"
          rel="noopener noreferrer"
          data-event="whatsapp_click"
          style="display:inline-flex;align-items:center;gap:10px;padding:15px 32px;background:var(--wa-deep);color:#fff;font-weight:700;font-size:15px;border-radius:12px;text-decoration:none;transition:background .15s;"
          onmouseover="this.style.background='var(--wa-deep-h)'"
