---
// ContactForm.astro
// Self-contained multi-step lead qualification form (vanilla JS, no React dep)
// Pre-selection from hero: listen for custom event cicon:preselect with detail.type = "dental" | "local"
// Props:
//   source      — optional string injected as hidden field (e.g. "Google Map Visibility Audit")
//   submitLabel — optional override for submit button text (default "Send it →")
const FORM_ENDPOINT = "https://services.leadconnectorhq.com/hooks/dQdD9zKPpebLfgGNi9FP/webhook-trigger/572fd3b5-8703-4ed7-be76-faf8e478b623";
interface Props {
  source?: string;
  submitLabel?: string;
}
const { source = '', submitLabel = 'Send it' } = Astro.props;
---

<section id="contact-form" style="scroll-margin-top:80px;">
  <form
    id="cicon-contact-form"
    novalidate
    aria-label="Contact CiCon Marketing"
    style="background:#fff;border-radius:16px;padding:40px 32px;box-shadow:0 4px 24px rgba(33,33,41,0.10);max-width:680px;width:100%;"
  >
    <!-- Progress indicator -->
    <div style="margin-bottom:28px;">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
        <span
          id="step-label"
          style="font-size:13px;font-weight:600;color:#9D833E;text-transform:uppercase;letter-spacing:.06em;"
          aria-live="polite"
          aria-atomic="true"
        >Step 1 of 4</span>
        <span
          id="step-description"
          style="font-size:12px;color:#888;"
        >Who we're talking to</span>
      </div>
      <div style="height:4px;background:#E7E7E7;border-radius:999px;overflow:hidden;">
        <div
          id="progress-bar"
          style="height:100%;background:#9D833E;border-radius:999px;transition:width .35s ease;width:25%;"
          role="progressbar"
          aria-valuemin={0}
          aria-valuemax={100}
          aria-valuenow={25}
        ></div>
      </div>
    </div>

    <!-- Live region for validation errors -->
    <div id="form-error-live" role="alert" aria-live="polite" style="display:none;margin-bottom:12px;padding:12px 16px;background:#fff3f3;border:1px solid #f5a5a5;border-radius:8px;color:#c0392b;font-size:14px;"></div>

    <!-- ═══════════ STEP 1 ═══════════ -->
    <div id="step-1" data-step="1">
      <h2 style="font-family:'Inter',sans-serif;font-size:22px;font-weight:800;color:#212129;margin:0 0 8px;">First, who are we talking to?</h2>
      <p style="font-size:14px;color:#666;margin:0 0 24px;line-height:1.6;">This shapes everything we send back — strategy, not a brochure.</p>

      <fieldset style="border:none;padding:0;margin:0 0 28px;">
        <legend style="font-size:14px;font-weight:600;color:#3A3A3A;margin-bottom:12px;">I run a:</legend>
        <div style="display:flex;flex-direction:column;gap:12px;">
          <label class="radio-option" data-step-field>
            <input type="radio" name="business_type" value="dental" style="display:none;" />
            <span class="radio-custom" aria-hidden="true"></span>
            <span style="font-size:15px;font-weight:600;color:#212129;">Dental clinic</span>
          </label>
          <label class="radio-option" data-step-field>
            <input type="radio" name="business_type" value="local" style="display:none;" />
            <span class="radio-custom" aria-hidden="true"></span>
            <span style="font-size:15px;font-weight:600;color:#212129;">Local business</span>
          </label>
        </div>
      </fieldset>

      <div style="display:flex;justify-content:flex-end;">
        <button type="button" class="btn-next" id="next-1" disabled style="opacity:.5;cursor:not-allowed;">
          Next <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>

    <!-- ═══════════ STEP 2 ═══════════ -->
    <div id="step-2" data-step="2" style="display:none;">
      <h2 style="font-family:'Inter',sans-serif;font-size:22px;font-weight:800;color:#212129;margin:0 0 8px;">What does winning look like in 90 days?</h2>
      <p style="font-size:14px;color:#666;margin:0 0 24px;line-height:1.6;">Pick the closest match. We'll get into specifics on the call.</p>

      <fieldset style="border:none;padding:0;margin:0 0 28px;">
        <legend class="sr-only">90-day goal</legend>
        <div style="display:flex;flex-direction:column;gap:12px;">
          <label class="radio-option" data-step-field>
            <input type="radio" name="goal" value="more_patients" style="display:none;" />
            <span class="radio-custom" aria-hidden="true"></span>
            <span style="font-size:15px;font-weight:600;color:#212129;">More qualified patients/customers walking in the door</span>
          </label>
          <label class="radio-option" data-step-field>
            <input type="radio" name="goal" value="more_leads" style="display:none;" />
            <span class="radio-custom" aria-hidden="true"></span>
            <span style="font-size:15px;font-weight:600;color:#212129;">More leads from Google, Meta, or local search</span>
          </label>
          <label class="radio-option" data-step-field>
            <input type="radio" name="goal" value="gbp_visibility" style="display:none;" />
            <span class="radio-custom" aria-hidden="true"></span>
            <span style="font-size:15px;font-weight:600;color:#212129;">Better visibility on Google Business Profile and Maps</span>
          </label>
          <label class="radio-option" data-step-field>
            <input type="radio" name="goal" value="other" style="display:none;" />
            <span class="radio-custom" aria-hidden="true"></span>
            <span style="font-size:15px;font-weight:600;color:#212129;">Something else — I'll explain</span>
          </label>
        </div>
      </fieldset>

      <div style="display:flex;justify-content:space-between;">
        <button type="button" class="btn-back">
          <span aria-hidden="true">←</span> Back
        </button>
        <button type="button" class="btn-next" id="next-2" disabled style="opacity:.5;cursor:not-allowed;">
          Next <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>

    <!-- ═══════════ STEP 3 ═══════════ -->
    <div id="step-3" data-step="3" style="display:none;">
      <h2 style="font-family:'Inter',sans-serif;font-size:22px;font-weight:800;color:#212129;margin:0 0 8px;">What are you working with monthly?</h2>
      <p style="font-size:14px;color:#666;margin:0 0 24px;line-height:1.6;">This isn't a paywall — it tells us whether we're the right fit before we both waste a call.</p>

      <fieldset style="border:none;padding:0;margin:0 0 28px;">
        <legend class="sr-only">Monthly budget</legend>
        <div style="display:flex;flex-direction:column;gap:12px;">
          <label class="radio-option" data-step-field>
            <input type="radio" name="budget" value="1k_2k" style="display:none;" />
            <span class="radio-custom" aria-hidden="true"></span>
            <span style="font-size:15px;font-weight:600;color:#212129;">$1,000 – $2,000</span>
          </label>
          <label class="radio-option" data-step-field>
            <input type="radio" name="budget" value="2k_5k" style="display:none;" />
            <span class="radio-custom" aria-hidden="true"></span>
            <span style="font-size:15px;font-weight:600;color:#212129;">$2,000 – $5,000</span>
          </label>
          <label class="radio-option" data-step-field>
            <input type="radio" name="budget" value="5k_10k" style="display:none;" />
            <span class="radio-custom" aria-hidden="true"></span>
            <span style="font-size:15px;font-weight:600;color:#212129;">$5,000 – $10,000</span>
          </label>
          <label class="radio-option" data-step-field>
            <input type="radio" name="budget" value="10k_plus" style="display:none;" />
            <span class="radio-custom" aria-hidden="true"></span>
            <span style="font-size:15px;font-weight:600;color:#212129;">$10,000+</span>
          </label>
          <label class="radio-option" data-step-field>
            <input type="radio" name="budget" value="not_sure" style="display:none;" />
            <span class="radio-custom" aria-hidden="true"></span>
            <span style="font-size:15px;font-weight:600;color:#212129;">Not sure yet — let's talk</span>
          </label>
        </div>
      </fieldset>

      <div style="display:flex;justify-content:space-between;">
        <button type="button" class="btn-back">
          <span aria-hidden="true">←</span> Back
        </button>
        <button type="button" class="btn-next" id="next-3" disabled style="opacity:.5;cursor:not-allowed;">
          Next <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>

    <!-- ═══════════ STEP 4 ═══════════ -->
    <div id="step-4" data-step="4" style="display:none;">
      <h2 style="font-family:'Inter',sans-serif;font-size:22px;font-weight:800;color:#212129;margin:0 0 8px;">Last step. Where do we reach you?</h2>
      <p style="font-size:14px;color:#666;margin:0 0 24px;line-height:1.6;">We reply within 1 business hour, Mon–Fri. No drip campaigns. No "nurture sequences."</p>

      <div style="display:flex;flex-direction:column;gap:20px;margin-bottom:28px;">
        <!-- Full name -->
        <div>
          <label for="full_name" style="display:block;font-size:13px;font-weight:600;color:#3A3A3A;margin-bottom:6px;">
            Full name <span style="color:#c0392b;" aria-hidden="true">*</span>
          </label>
          <input
            type="text"
            id="full_name"
            name="full_name"
            autocomplete="name"
            required
            placeholder="Jane Smith"
            class="form-input"
          />
          <div id="err-full_name" class="field-error" role="alert" aria-live="polite" style="display:none;"></div>
        </div>

        <!-- Email -->
        <div>
          <label for="email" style="display:block;font-size:13px;font-weight:600;color:#3A3A3A;margin-bottom:6px;">
            Email <span style="color:#c0392b;" aria-hidden="true">*</span>
          </label>
          <input
            type="email"
            id="email"
            name="email"
            autocomplete="email"
            required
            placeholder="jane@example.com"
            class="form-input"
          />
          <div id="err-email" class="field-error" role="alert" aria-live="polite" style="display:none;"></div>
        </div>

        <!-- Phone -->
        <div>
          <label for="phone" style="display:block;font-size:13px;font-weight:600;color:#3A3A3A;margin-bottom:6px;">
            Phone <span style="color:#c0392b;" aria-hidden="true">*</span>
          </label>
          <input
            type="tel"
            id="phone"
            name="phone"
            autocomplete="tel"
            required
            placeholder="+1 (416) 555-0100"
            class="form-input"
          />
          <div id="err-phone" class="field-error" role="alert" aria-live="polite" style="display:none;"></div>
        </div>

        <!-- Website URL -->
        <div>
          <label for="website" style="display:block;font-size:13px;font-weight:600;color:#3A3A3A;margin-bottom:6px;">
            Website URL <span style="color:#c0392b;" aria-hidden="true">*</span>
          </label>
          <input
            type="url"
            id="website"
            name="website"
            autocomplete="url"
            required
            placeholder="https://yourwebsite.com"
            class="form-input"
          />
          <div id="err-website" class="field-error" role="alert" aria-live="polite" style="display:none;"></div>
        </div>

        <!-- Message -->
        <div>
          <label for="message" style="display:block;font-size:13px;font-weight:600;color:#3A3A3A;margin-bottom:6px;">
            Anything else we should know? <span style="font-size:12px;font-weight:400;color:#999;">(optional)</span>
          </label>
          <textarea
            id="message"
            name="message"
            rows="4"
            placeholder="Any details that would help us hit the ground running…"
            class="form-input"
            style="resize:vertical;min-height:100px;"
          ></textarea>
        </div>
      </div>

      <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;">
        <button type="button" class="btn-back">
          <span aria-hidden="true">←</span> Back
        </button>
        <button type="submit" id="btn-submit" class="btn-submit" data-event="audit_form_submit">
          {submitLabel} <span aria-hidden="true">→</span>
        </button>
      </div>
      <p style="font-size:12px;color:#999;margin:16px 0 0;text-align:center;line-height:1.5;">
        We don't sell, share, or spam. Your info goes to MJ and Soroush — that's it.
      </p>
    </div>

    <!-- Hidden source tag — injected via prop, picked up by form submit handler -->
    {source && <input type="hidden" name="source" value={source} />}
  </form>
</section>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border-width: 0;
  }

  /* Radio options */
  .radio-option {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    border: 2px solid #E7E7E7;
    border-radius: 10px;
    cursor: pointer;
    transition: border-color .15s, background .15s;
    min-height: 44px;
    user-select: none;
  }
  .radio-option:hover {
    border-color: #9D833E;
    background: rgba(157,131,62,0.04);
  }
  .radio-option.is-selected {
    border-color: #9D833E;
    background: rgba(157,131,62,0.08);
  }

  /* Custom radio dot */
  .radio-custom {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 2px solid #ccc;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color .15s;
    position: relative;
  }
  .radio-option.is-selected .radio-custom {
    border-color: #9D833E;
  }
  .radio-option.is-selected .radio-custom::after {
    content: '';
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #9D833E;
    display: block;
  }

  /* Form inputs */
  .form-input {
    width: 100%;
    padding: 12px 14px;
    border: 2px solid #E7E7E7;
    border-radius: 8px;
    font-size: 15px;
    font-family: 'Inter', sans-serif;
    color: #212129;
    background: #fff;
    transition: border-color .15s, box-shadow .15s;
    box-sizing: border-box;
    outline: none;
  }
  .form-input:focus {
    border-color: #9D833E;
    box-shadow: 0 0 0 3px rgba(157,131,62,0.15);
  }
  .form-input.has-error {
    border-color: #e74c3c;
  }

  /* Field error messages */
  .field-error {
    font-size: 12px;
    color: #c0392b;
    margin-top: 5px;
    padding-left: 2px;
  }

  /* Back button */
  .btn-back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 20px;
    border: 2px solid #E7E7E7;
    border-radius: 8px;
    background: transparent;
    color: #666;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: border-color .15s, color .15s;
    font-family: 'Inter', sans-serif;
  }
  .btn-back:hover {
    border-color: #9D833E;
    color: #9D833E;
  }

  /* Next button */
  .btn-next {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 12px 28px;
    border: none;
    border-radius: 10px;
    background: #212129;
    color: #fff;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    transition: background .15s, transform .1s;
    font-family: 'Inter', sans-serif;
  }
  .btn-next:not([disabled]):hover {
    background: #3A3A3A;
    transform: translateY(-1px);
  }
  .btn-next:not([disabled]) {
    opacity: 1 !important;
    cursor: pointer !important;
  }

  /* Submit button */
  .btn-submit {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 14px 32px;
    border: none;
    border-radius: 10px;
    background: #9D833E;
    color: #fff;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    transition: background .15s, transform .1s;
    font-family: 'Inter', sans-serif;
  }
  .btn-submit:hover:not(:disabled) {
    background: #7a6531;
    transform: translateY(-1px);
  }
  .btn-submit:disabled {
    opacity: .6;
    cursor: not-allowed;
  }
</style>

<script define:vars={{ FORM_ENDPOINT }}>
(function () {
  'use strict';

  var currentStep = 1;
  var totalSteps = 4;
  var formData = {};

  var stepDescriptions = {
    1: 'Who we\'re talking to',
    2: '90-day goal',
    3: 'Monthly budget',
    4: 'Contact details',
  };

  // ── helpers ──────────────────────────────────────────────────────────────
  function gtag() {
    if (typeof window.gtag === 'function') {
      window.gtag.apply(window, arguments);
    }
  }

  function showStep(n) {
    for (var i = 1; i <= totalSteps; i++) {
      var el = document.getElementById('step-' + i);
      if (el) el.style.display = (i === n) ? '' : 'none';
    }
    currentStep = n;

    // Progress
    var pct = Math.round((n / totalSteps) * 100);
    var bar = document.getElementById('progress-bar');
    if (bar) {
      bar.style.width = pct + '%';
      bar.setAttribute('aria-valuenow', String(pct));
    }
    var lbl = document.getElementById('step-label');
    if (lbl) lbl.textContent = 'Step ' + n + ' of ' + totalSteps;
    var desc = document.getElementById('step-description');
    if (desc) desc.textContent = stepDescriptions[n] || '';

    gtag('event', 'contact_form_step_view', { step: n });
  }

  function getSelectedValue(name) {
    var el = document.querySelector('input[name="' + name + '"]:checked');
    return el ? el.value : null;
  }

  function setNextBtnState(stepNum) {
    var names = { 1: 'business_type', 2: 'goal', 3: 'budget' };
    var name = names[stepNum];
    if (!name) return;
    var btn = document.getElementById('next-' + stepNum);
    if (!btn) return;
    var val = getSelectedValue(name);
    if (val) {
      btn.removeAttribute('disabled');
      btn.style.opacity = '1';
      btn.style.cursor = 'pointer';
    } else {
      btn.setAttribute('disabled', '');
      btn.style.opacity = '.5';
      btn.style.cursor = 'not-allowed';
    }
  }

  function showError(id, msg) {
    var el = document.getElementById(id);
    if (!el) return;
    el.textContent = msg;
    el.style.display = 'block';
    var input = document.getElementById(id.replace('err-', ''));
    if (input) input.classList.add('has-error');
  }

  function clearError(id) {
    var el = document.getElementById(id);
    if (el) { el.textContent = ''; el.style.display = 'none'; }
    var input = document.getElementById(id.replace('err-', ''));
    if (input) input.classList.remove('has-error');
  }

  function clearAllErrors() {
    ['full_name','email','phone','website'].forEach(function (f) { clearError('err-' + f); });
    var live = document.getElementById('form-error-live');
    if (live) live.style.display = 'none';
  }

  // ── radio selection styling ───────────────────────────────────────────────
  document.querySelectorAll('.radio-option').forEach(function (label) {
    label.addEventListener('click', function () {
      var input = label.querySelector('input[type="radio"]');
      if (!input) return;
      var name = input.name;
      // Deselect siblings
      document.querySelectorAll('input[name="' + name + '"]').forEach(function (sibling) {
        var sibLabel = sibling.closest('.radio-option');
        if (sibLabel) sibLabel.classList.remove('is-selected');
      });
      input.checked = true;
      label.classList.add('is-selected');
      // Store
      formData[name] = input.value;
      // Determine which step we're in from input name
      var stepMap = { business_type: 1, goal: 2, budget: 3 };
      var sn = stepMap[name];
      if (sn) setNextBtnState(sn);
    });

    // Keyboard accessibility
    label.addEventListener('keydown', function (e) {
      if (e.key === ' ' || e.key === 'Enter') {
        e.preventDefault();
        label.click();
      }
    });
    label.setAttribute('tabindex', '0');
    label.setAttribute('role', 'radio');
  });

  // ── next buttons ──────────────────────────────────────────────────────────
  [1, 2, 3].forEach(function (n) {
    var btn = document.getElementById('next-' + n);
    if (!btn) return;
    btn.addEventListener('click', function () {
      if (btn.hasAttribute('disabled')) return;
      var names = { 1: 'business_type', 2: 'goal', 3: 'budget' };
      formData[names[n]] = getSelectedValue(names[n]);
      gtag('event', 'contact_form_step_complete', { step: n });
      showStep(n + 1);
    });
  });

  // ── back buttons ─────────────────────────────────────────────────────────
  document.querySelectorAll('.btn-back').forEach(function (btn) {
    btn.addEventListener('click', function () {
      if (currentStep > 1) showStep(currentStep - 1);
    });
  });

  // ── step 4 validation ─────────────────────────────────────────────────────
  function validateStep4() {
    clearAllErrors();
    var valid = true;

    var name = document.getElementById('full_name');
    var email = document.getElementById('email');
    var phone = document.getElementById('phone');
    var website = document.getElementById('website');

    if (!name || !name.value.trim()) {
      showError('err-full_name', "This one's needed to move forward.");
      valid = false;
    }

    if (!email || !email.value.trim()) {
      showError('err-email', "This one's needed to move forward.");
      valid = false;
    } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim())) {
      showError('err-email', "That email doesn't look right — mind checking?");
      valid = false;
    }

    if (!phone || !phone.value.trim()) {
      showError('err-phone', "This one's needed to move forward.");
      valid = false;
    } else if (!/^[\+\d\s\(\)\-\.]{7,20}$/.test(phone.value.trim())) {
      showError('err-phone', "We need a working number to call you back.");
      valid = false;
    }

    if (!website || !website.value.trim()) {
      showError('err-website', "This one's needed to move forward.");
      valid = false;
    } else if (!/^https?:\/\/.+\..+/.test(website.value.trim())) {
      showError('err-website', "A full website address, including https://");
      valid = false;
    }

    return valid;
  }

  // ── form submit ───────────────────────────────────────────────────────────
  var form = document.getElementById('cicon-contact-form');
  if (form) {
    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      if (!validateStep4()) return;

      var submitBtn = document.getElementById('btn-submit');
      if (submitBtn) {
        submitBtn.setAttribute('disabled', '');
        submitBtn.textContent = 'Sending…';
      }

      // Collect step 4 data
      formData.full_name = (document.getElementById('full_name')).value.trim();
      formData.email     = (document.getElementById('email')).value.trim();
      formData.phone     = (document.getElementById('phone')).value.trim();
      formData.website   = (document.getElementById('website')).value.trim();
      formData.message   = (document.getElementById('message')).value.trim();
      // Source tag (set via hidden field from ContactForm prop)
      var sourceField = document.querySelector('input[name="source"]');
      if (sourceField) formData.source = sourceField.value;

      gtag('event', 'contact_form_submit');
      gtag('event', 'contact_form_step_complete', { step: 4 });

      try {
        await fetch(FORM_ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(formData),
        });
      } catch (_) {
        // Endpoint not set yet — proceed to thank-you anyway
      }

      window.location.href = '/thank-you/';
    });
  }

  // ── pre-selection from hero ───────────────────────────────────────────────
  window.addEventListener('cicon:preselect', function (e) {
    var type = e.detail && e.detail.type; // "dental" | "local"
    if (!type) return;
    var val = type === 'dental' ? 'dental' : 'local';
    var radio = document.querySelector('input[name="business_type"][value="' + val + '"]');
    if (!radio) return;
    var label = radio.closest('.radio-option');
    if (label) {
      // Deselect any current
      document.querySelectorAll('input[name="business_type"]').forEach(function (r) {
        var l = r.closest('.radio-option');
        if (l) l.classList.remove('is-selected');
      });
      radio.checked = true;
      label.classList.add('is-selected');
      formData['business_type'] = val;
      setNextBtnState(1);
    }
    // Scroll to form
    var formEl = document.getElementById('contact-form');
    if (formEl) formEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  // ── init ─────────────────────────────────────────────────────────────────
  showStep(1);
})();
</script>
