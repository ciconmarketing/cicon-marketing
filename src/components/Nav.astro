---
import { SERVICES_NAV } from '../lib/services-nav'
// No other props – Nav is static
---

<header
  id="site-nav"
  class="sticky top-0 z-50 transition-all duration-300"
  style="background:#FAFAFA;border-bottom:1px solid #E7E7E7;"
>
  <div class="nav-container">
    <nav class="flex items-center justify-between h-16 md:h-20">

      <!-- Logo -->
      <a href="/" class="flex items-center group" aria-label="CiCon Marketing Home">
        <img
          src="/logo-cicon.jpg"
          alt="CiCon Digital Marketing"
          width="800"
          height="800"
          class="h-12 md:h-[60px] w-auto object-contain transition-opacity duration-200 group-hover:opacity-80"
          style="mix-blend-mode:multiply;"
          loading="eager"
        />
      </a>

      <!-- Desktop Nav Links -->
      <ul class="hidden md:flex items-center gap-8" style="list-style:none;margin:0;padding:0;">

        <!-- Home -->
        <li>
          <a href="/" class="text-gray-600 hover:text-teal-600 font-medium text-sm transition-colors duration-150 relative after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-teal-600 after:transition-all hover:after:w-full">
            Home
          </a>
        </li>

        <!-- Services dropdown item -->
        <li class="nav-item nav-item--has-dropdown" data-mobile-accordion>
          <a href="/marketing-services/" class="nav-link text-gray-600 hover:text-teal-600 font-medium text-sm transition-colors duration-150 relative after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-teal-600 after:transition-all hover:after:w-full inline-flex items-center" aria-haspopup="true" aria-expanded="false">
            Services
            <svg class="nav-caret" width="12" height="12" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                 aria-hidden="true">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </a>
          <div class="nav-dropdown" role="menu" aria-label="Services menu">
            <ul class="nav-dropdown-list" style="list-style:none;margin:0;padding:0;">
              {SERVICES_NAV.map((service) => (
                <li role="none">
                  <a href={`/marketing-services/${service.slug}/`} class="nav-dropdown-item" role="menuitem">
                    <span class="nav-dropdown-icon" aria-hidden="true">{service.icon}</span>
                    <span class="nav-dropdown-label">{service.title}</span>
                    {service.isFlagship && <span class="nav-dropdown-badge">Flagship</span>}
                  </a>
                </li>
              ))}
              <li role="separator" class="nav-dropdown-divider"></li>
              <li role="none">
                <a href="/marketing-services/" class="nav-dropdown-viewall" role="menuitem">
                  View all services →
                </a>
              </li>
            </ul>
          </div>
        </li>

        <!-- Other desktop nav links -->
        {[
          { href: '/about-us/', label: 'About Us' },
          { href: '/blog/', label: 'Blog' },
          { href: '/check-google-map-visibility-for-free/', label: 'Free Map Check' },
          { href: '/contact-us/', label: 'Contact' },
        ].map(link => (
          <li>
            <a href={link.href} class="text-gray-600 hover:text-teal-600 font-medium text-sm transition-colors duration-150 relative after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-teal-600 after:transition-all hover:after:w-full">
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <!-- CTA area: phone + WhatsApp -->
      <div class="hidden md:flex items-center gap-3">

        <!-- Phone number -->
        <a
          href="tel:+12898071020"
          class="inline-flex items-center gap-1.5 text-gray-600 hover:text-teal-600 font-medium text-sm transition-colors duration-150"
          aria-label="Call CiCon Marketing"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          +1 (289) 807-1020
        </a>

        <!-- Divider -->
        <span class="h-5 w-px bg-gray-300" aria-hidden="true"></span>

        <!-- WhatsApp CTA -->
        <a
          href="https://wa.me/16475840800"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 text-white font-semibold rounded-xl text-sm transition-all duration-200 shadow-md hover:-translate-y-0.5"
          style="background:#25D366;"
          onmouseover="this.style.background='#1ebe5d'"
          onmouseout="this.style.background='#25D366'"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
          </svg>
          Chat on WhatsApp
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden p-2 text-gray-600 hover:text-navy-900 transition-colors rounded-lg hover:bg-gray-100"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg id="menu-icon" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </nav>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden bg-white border-t border-gray-100 shadow-lg"
  >
    <div class="container-xl py-4 flex flex-col gap-1">

      <a href="/" class="px-4 py-3 text-gray-700 hover:text-teal-600 hover:bg-teal-50 rounded-xl font-medium transition-colors">Home</a>

      <!-- Services accordion item (mobile) -->
      <div class="mobile-accordion-item" data-mobile-accordion>
        <a href="/marketing-services/" class="nav-link mobile-services-link px-4 py-3 text-gray-700 hover:text-teal-600 hover:bg-teal-50 rounded-xl font-medium transition-colors flex items-center justify-between" aria-haspopup="true" aria-expanded="false">
          Services
          <svg class="nav-caret w-4 h-4" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
               aria-hidden="true">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </a>
        <div class="mobile-services-dropdown" role="menu" aria-label="Services menu">
          {SERVICES_NAV.map((service) => (
            <a href={`/marketing-services/${service.slug}/`} class="mobile-dropdown-item" role="menuitem">
              <span aria-hidden="true">{service.icon}</span>
              <span>{service.title}</span>
              {service.isFlagship && <span class="nav-dropdown-badge">Flagship</span>}
            </a>
          ))}
          <div class="nav-dropdown-divider" style="margin:6px 8px;"></div>
          <a href="/marketing-services/" class="nav-dropdown-viewall mobile-viewall" role="menuitem">
            View all services →
          </a>
        </div>
      </div>

      <a href="/about-us/" class="px-4 py-3 text-gray-700 hover:text-teal-600 hover:bg-teal-50 rounded-xl font-medium transition-colors">About Us</a>
      <a href="/blog/" class="px-4 py-3 text-gray-700 hover:text-teal-600 hover:bg-teal-50 rounded-xl font-medium transition-colors">Blog</a>
      <a href="/check-google-map-visibility-for-free/" class="px-4 py-3 text-gray-700 hover:text-teal-600 hover:bg-teal-50 rounded-xl font-medium transition-colors">Free Map Check</a>
      <a href="/contact-us/" class="px-4 py-3 text-gray-700 hover:text-teal-600 hover:bg-teal-50 rounded-xl font-medium transition-colors">Contact</a>
      <div class="pt-3 pb-1 flex flex-col gap-2">
        <!-- Phone (mobile) -->
        <a
          href="tel:+12898071020"
          class="flex items-center justify-center gap-2 px-5 py-3 rounded-xl text-sm font-semibold border transition-colors"
          style="border-color:#E7E7E7;color:#3A3A3A;"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          +1 (289) 807-1020
        </a>
        <!-- WhatsApp (mobile) -->
        <a
          href="https://wa.me/16475840800"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2 px-5 py-3 text-white font-semibold rounded-xl text-sm transition-colors"
          style="background:#25D366;"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
          </svg>
          Chat on WhatsApp
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  /* ── Self-contained container (replaces globals.css container-xl) ── */
  .nav-container {
    max-width: 80rem; /* 1280px — same as Tailwind 7xl */
    margin: 0 auto;
    padding: 0 1rem;
  }
  @media (min-width: 640px)  { .nav-container { padding: 0 1.5rem; } }
  @media (min-width: 1024px) { .nav-container { padding: 0 2rem; } }

  /* ── Services dropdown ─────────────────────────────── */
  .nav-item { position: relative; }

  .nav-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    width: 320px;
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.12);
    padding: 8px;
    z-index: 100;
  }

  .nav-caret {
    display: inline-block;
    margin-left: 4px;
    vertical-align: middle;
    transition: transform 0.18s ease;
  }

  /* Desktop: hover/focus-within reveals dropdown */
  @media (min-width: 1024px) {
    .nav-dropdown {
      opacity: 0;
      visibility: hidden;
      transform: translateY(-4px);
      transition: opacity 0.18s ease, transform 0.18s ease, visibility 0s linear 0.18s;
    }
    .nav-item--has-dropdown:hover .nav-dropdown,
    .nav-item--has-dropdown:focus-within .nav-dropdown {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      transition: opacity 0.18s ease, transform 0.18s ease;
    }
    .nav-item--has-dropdown:hover .nav-caret,
    .nav-item--has-dropdown:focus-within .nav-caret {
      transform: rotate(180deg);
    }
  }

  /* Mobile: accordion */
  .mobile-services-dropdown {
    display: none;
    padding: 4px 0 4px 8px;
    margin-top: 4px;
  }
  .mobile-accordion-item.is-open .mobile-services-dropdown { display: block; }
  .mobile-accordion-item.is-open .nav-caret { transform: rotate(180deg); }

  /* Dropdown items */
  .nav-dropdown-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border-radius: 8px;
    color: #3A3A3A;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.15s ease;
  }
  .nav-dropdown-item:hover { background: #E7E7E7; color: #000; }
  .nav-dropdown-icon { font-size: 18px; width: 22px; text-align: center; flex-shrink: 0; }
  .nav-dropdown-label { flex: 1; }
  .nav-dropdown-badge {
    margin-left: auto;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    color: #9D833E;
    background: rgba(157,131,62,0.1);
    padding: 2px 8px;
    border-radius: 4px;
    white-space: nowrap;
  }
  .nav-dropdown-divider { height: 1px; background: #E7E7E7; margin: 6px 4px; }
  .nav-dropdown-viewall {
    display: block;
    padding: 10px 14px;
    border-radius: 8px;
    color: #9D833E;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
  }
  .nav-dropdown-viewall:hover { background: #E7E7E7; }

  /* Mobile dropdown items */
  .mobile-dropdown-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    border-radius: 8px;
    color: #3A3A3A;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.15s ease;
  }
  .mobile-dropdown-item:hover { background: #f0fdfa; color: #0d9488; }
  .mobile-viewall {
    padding: 8px 12px;
    font-size: 13px;
  }
</style>

<script>
  const btn = document.getElementById('mobile-menu-btn')!;
  const menu = document.getElementById('mobile-menu')!;
  const menuIcon = document.getElementById('menu-icon')!;
  const closeIcon = document.getElementById('close-icon')!;
  const nav = document.getElementById('site-nav')!;

  btn.addEventListener('click', () => {
    const isOpen = !menu.classList.contains('hidden');
    menu.classList.toggle('hidden', isOpen);
    menuIcon.classList.toggle('hidden', !isOpen);
    closeIcon.classList.toggle('hidden', isOpen);
    btn.setAttribute('aria-expanded', String(!isOpen));
  });

  menu.querySelectorAll('a:not(.mobile-services-link):not(.mobile-dropdown-item):not(.mobile-viewall)').forEach(link => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      menuIcon.classList.remove('hidden');
      closeIcon.classList.add('hidden');
    });
  });

  window.addEventListener('scroll', () => {
    if (window.scrollY > 100) {
      nav.style.boxShadow = '0 2px 8px rgba(0,0,0,0.06)';
    } else {
      nav.style.boxShadow = 'none';
    }
  }, { passive: true });

  // Services dropdown: mobile accordion + Escape key
  (function() {
    // Mobile accordion for the mobile menu's services item
    document.querySelectorAll('[data-mobile-accordion] .nav-link').forEach(function(link) {
      link.addEventListener('click', function(e) {
        if (window.matchMedia('(max-width: 1023px)').matches) {
          var parent = (link as HTMLElement).closest('[data-mobile-accordion]');
          if (!parent) return;
          var isOpen = parent.classList.contains('is-open');
          if (!isOpen) {
            e.preventDefault();
            parent.classList.add('is-open');
            link.setAttribute('aria-expanded', 'true');
          }
          // Second tap: let the link follow normally
        }
      });
    });

    // Escape key closes dropdown
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        document.querySelectorAll('[data-mobile-accordion]').forEach(function(item) {
          item.classList.remove('is-open');
          var link = item.querySelector('.nav-link');
          if (link) link.setAttribute('aria-expanded', 'false');
        });
      }
    });

    // Click outside closes dropdown on desktop
    document.addEventListener('click', function(e) {
      if (!(e.target as HTMLElement).closest('[data-mobile-accordion]')) {
        document.querySelectorAll('[data-mobile-accordion]').forEach(function(item) {
          item.classList.remove('is-open');
          var link = item.querySelector('.nav-link');
          if (link) link.setAttribute('aria-expanded', 'false');
        });
      }
    });
  })();
</script>
