---
/**
 * AreaProof — "Our work connected to {city}" section. Renders ONLY approved
 * proof items; unapproved placeholders exist in data for editorial tracking
 * but never reach the page. If no approved items exist the section renders
 * nothing (the build gate also prevents such a page from being indexable).
 *
 * Client/testimonial labels follow the "Company Name — description" pattern;
 * the company name renders bold and, if a link is provided, only the name is
 * clickable. External client sites open in a new tab with
 * rel="noopener noreferrer"; internal cicon.ca links (blog proof) do not.
 */
import type { ProofItem } from '../../lib/sanity'
interface Props {
  cityName: string
  proof: ProofItem[]
}
const { cityName, proof } = Astro.props
const approved = proof.filter((p) => p.approved)
if (!approved.length) return

// A section headed "Our work connected to X" must actually show work. Client,
// testimonial, and blog items qualify; a bare coverage fact does not. Areas
// carrying only 'fact' proof get an honest coverage heading instead, so a page
// can go live without implying engagements that do not exist.
const hasWork = approved.some((p) => p.kind === 'client' || p.kind === 'testimonial' || p.kind === 'blog')
const eyebrow = hasWork ? 'Receipts' : 'Coverage'
const heading = hasWork ? `Our work connected to ${cityName}` : `How we cover ${cityName}`

function splitLabel(item: ProofItem): { name: string; rest: string } | null {
  if ((item.kind === 'client' || item.kind === 'testimonial') && item.label.includes('—')) {
    const idx = item.label.indexOf('—')
    return { name: item.label.slice(0, idx).trim(), rest: item.label.slice(idx + 1).trim() }
  }
  return null
}
function isExternal(href?: string): boolean {
  return !!href && !href.startsWith('https://cicon.ca')
}
---

<section class="py-20" style="background:#fff">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-2 mb-3">
      <span class="h-[1px] w-8" style="background:var(--accent)"></span>
      <span class="text-xs font-semibold tracking-widest uppercase" style="color:var(--accent-text)">{eyebrow}</span>
    </div>
    <h2 class="font-heading text-3xl font-extrabold mb-8" style="color:var(--black)">
      {heading}
    </h2>
    <ul style="list-style:none;margin:0;padding:0" class="space-y-3">
      {approved.map((item) => {
        const split = splitLabel(item)
        const external = isExternal(item.href)
        return (
          <li class="rounded-xl border p-5 flex items-start gap-3" style="border-color:var(--alabaster);background:var(--off-white)">
            <span aria-hidden="true" class="flex-shrink-0" style="color:var(--accent);font-weight:700">◆</span>
            <div class="text-sm leading-relaxed flex-1 min-w-0 break-words" style="color:var(--charcoal)">
              {split ? (
                <Fragment>
                  {item.href ? (
                    <a
                      href={item.href}
                      class="font-semibold hover:underline break-words"
                      style="color:var(--black)"
                      {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                    >{split.name}</a>
                  ) : (
                    <strong class="font-semibold" style="color:var(--black)">{split.name}</strong>
                  )}
                  {` — ${split.rest}`}
                </Fragment>
              ) : item.href ? (
                <a
                  href={item.href}
                  class="font-semibold hover:underline break-words"
                  style="color:var(--black)"
                  {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >{item.label}</a>
              ) : (
                <span>{item.label}</span>
              )}
            </div>
          </li>
        )
      })}
    </ul>
  </div>
</section>
