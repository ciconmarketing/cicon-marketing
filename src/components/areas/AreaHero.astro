---
/**
 * AreaHero — dark hero for areas-served pages.
 * Same visual system as ServiceHero, but single-column (no stock city imagery
 * per visual direction) with the full CTA hierarchy:
 * WhatsApp (primary) → Get In Touch (secondary) → phone (tertiary).
 */
interface Props {
  eyebrow: string
  headline: string
  valueProp: string
  /** Honest base disclosure, e.g. "Based in Richmond Hill and serving …" */
  disclosure?: string
  /** Used in analytics event source, e.g. the city slug or 'hub' */
  trackSource: string
}
const { eyebrow, headline, valueProp, disclosure, trackSource } = Astro.props
---

<section id="hero" class="relative overflow-hidden" style="background:var(--shadow);padding:96px 0 72px">
  <div
    class="absolute inset-0 opacity-[0.04]"
    style="background-image:linear-gradient(var(--accent) 1px,transparent 1px),linear-gradient(90deg,var(--accent) 1px,transparent 1px);background-size:60px 60px"
  >
  </div>
  <div class="absolute bottom-0 left-0 right-0 h-[2px]" style="background:var(--accent);opacity:.4"></div>

  <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="inline-flex items-center gap-2 mb-6">
      <span class="h-[1px] w-8" style="background:var(--accent)"></span>
      <span class="text-xs font-semibold tracking-widest uppercase" style="color:var(--accent)">{eyebrow}</span>
    </div>

    <h1 class="font-heading text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-[1.1] text-white mb-5">
      {headline}
    </h1>

    <p class="text-lg leading-relaxed mb-8 max-w-2xl" style="color:#b0b0bb">{valueProp}</p>

    <div class="flex flex-wrap items-center gap-4 mb-3">
      <a
        href="https://wa.me/16475840800"
        target="_blank"
        rel="noopener noreferrer"
        data-cicon-event="whatsapp_click"
        data-cicon-source={trackSource}
        class="inline-flex items-center gap-2 px-7 py-3.5 font-bold rounded-xl transition-all duration-200 hover:-translate-y-0.5"
        style="background:#25D366;color:#10231A"
        onmouseover="this.style.background='#1FB855'"
        onmouseout="this.style.background='#25D366'"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="flex-shrink:0">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Chat on WhatsApp
      </a>
      <a
        href="/contact-us/#contact-form"
        data-cicon-event="get_in_touch_click"
        data-cicon-source={trackSource}
        class="inline-flex items-center gap-2 px-7 py-3.5 font-semibold rounded-xl transition-all duration-200 hover:-translate-y-0.5"
        style="border:1px solid rgba(255,255,255,0.35);color:#fff"
        onmouseover="this.style.borderColor='#fff'"
        onmouseout="this.style.borderColor='rgba(255,255,255,0.35)'"
      >
        Get In Touch
      </a>
    </div>
    <a
      href="tel:+12898071020"
      data-cicon-event="phone_click"
      data-cicon-source={trackSource}
      class="text-sm font-medium transition-opacity hover:opacity-100"
      style="color:rgba(255,255,255,0.7)"
    >
      or call +1 (289) 807-1020
    </a>

    {disclosure && (
      <p class="text-sm mt-8 pt-6 max-w-2xl" style="color:#888;border-top:1px solid rgba(255,255,255,0.08)">
        {disclosure}
      </p>
    )}
  </div>
</section>
