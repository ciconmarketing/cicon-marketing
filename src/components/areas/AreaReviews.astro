<section class="py-20" style="background:#fff">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-2 mb-3">
      <span class="h-[1px] w-8" style="background:var(--accent)"></span>
      <span class="text-xs font-semibold tracking-widest uppercase" style="color:var(--accent-text)">5-Star Google Reviews</span>
    </div>
    <h2 class="font-heading text-3xl font-extrabold mb-3" style="color:var(--black)">What our clients say</h2>
    <p class="text-base mb-2" style="color:var(--charcoal)">
      Real results from real GTA businesses who trusted CiCon Marketing to grow their brand.
    </p>
    <p class="text-sm mb-8" style="color:#5a5a5a">{RATING_VALUE} ★ average from {REVIEW_COUNT} Google Reviews</p>

    <div class="review-stage" id="area-review-stage">
      {REVIEWS.map((r, i) => (
        <article class={`review-card${i === 0 ? ' is-active' : ''}`} data-review={i}>
          <div class="rounded-2xl border p-6 sm:p-8" style="border-color:var(--alabaster);background:var(--off-white)">
            <div class="flex items-center gap-1 mb-4" role="img" aria-label={`${r.rating} out of 5 stars`} style="color:var(--action)">
              {Array(r.rating).fill(0).map(() => <span set:html={STAR} />)}
            </div>
            <p class="text-base leading-relaxed mb-6" style="color:var(--charcoal)">"{r.content}"</p>
            <div>
              <div class="font-semibold" style="color:var(--black)">{r.name}</div>
              <div class="text-sm" style="color:#5a5a5a">{r.role}</div>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="flex items-center gap-4 mt-6">
      <div class="flex gap-2" role="group" aria-label="Choose a review" id="area-review-dots">
        {REVIEWS.map((_, i) => (
          <button
            type="button"
            class={`review-dot${i === 0 ? ' is-active' : ''}`}
            data-review-dot={i}
            aria-label={`View testimonial ${i + 1} of ${REVIEWS.length}`}
          ></button>
        ))}
      </div>
      <span class="text-sm" style="color:#5a5a5a"><span id="area-review-idx">1</span> of {REVIEWS.length} reviews</span>
    </div>
  </div>
</section>

<style>
  .review-stage { position: relative; }
  .review-card { display: none; }
  .review-card.is-active { display: block; }
  /* 24x24 hit area (WCAG target-size) around an 8px visible dot, via a
     centered pseudo-element, so the tap target grows without changing
     the design's dot appearance. */
  .review-dot {
    width: 24px;
    height: 24px;
    border: none;
    padding: 0;
    background: transparent;
    cursor: pointer;
    position: relative;
  }
  .review-dot::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 8px;
    height: 8px;
    border-radius: 9999px;
    background: var(--alabaster);
    transition: background-color 0.2s ease;
  }
  .review-dot.is-active::before { background: var(--accent); }
</style>

<script>
  // Same rotation behaviour as the previous React carousel: 7s auto-advance,
  // dot navigation, disabled under prefers-reduced-motion (dots still work).
  const cards = [...document.querySelectorAll<HTMLElement>('#area-review-stage [data-review]')]
  const dots = [...document.querySelectorAll<HTMLButtonElement>('#area-review-dots [data-review-dot]')]
  const idxEl = document.getElementById('area-review-idx')
  if (cards.length > 1) {
    let active = 0
    let timer = 0
    const show = (i: number) => {
      active = (i + cards.length) % cards.length
      cards.forEach((c, k) => c.classList.toggle('is-active', k === active))
      dots.forEach((d, k) => d.classList.toggle('is-active', k === active))
      if (idxEl) idxEl.textContent = String(active + 1)
    }
    const motionOK = window.matchMedia('(prefers-reduced-motion: no-preference)').matches
    const start = () => {
      if (!motionOK) return
      window.clearInterval(timer)
      timer = window.setInterval(() => show(active + 1), 7000)
    }
    dots.forEach((d, k) =>
      d.addEventListener('click', () => {
        show(k)
        start()
      }),
    )
    start()
  }
</script>
