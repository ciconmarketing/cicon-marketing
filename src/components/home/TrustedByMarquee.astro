---
/**
 * TrustedByMarquee — "Trusted By" client logo strip.
 *
 * Logos live in /public/clients-logo/. Each logo is placed inside a
 * fixed-size normalisation container (140×90 px desktop) with
 * object-fit:contain so every aspect ratio looks optically balanced.
 * Per-logo `scale` overrides allow fine-tuning square/tall logos that
 * otherwise look too small inside the wide container.
 *
 * Data comes from Sanity `trustedByMarquee` singleton (with hard-coded
 * fallback). No JS animation library — pure CSS @keyframes.
 *
 * Optional override props let About Us render this component with its own
 * eyebrow / heading / subheading instead of the Sanity heading fields.
 */
import type { TrustedByMarqueeData } from '../../lib/types';

interface Props {
  data: TrustedByMarqueeData;
  /** Optional eyebrow label (e.g. "THE ROSTER"). Shown above the heading. */
  eyebrow?: string;
  /** Override the Sanity heading with a custom string. */
  overrideHeading?: string;
  /** Override the Sanity subheading with a custom string. Pass undefined to hide. */
  overrideSubheading?: string | null;
}

const { data, eyebrow, overrideHeading, overrideSubheading } = Astro.props;

// Bail early if Studio has disabled the section
if (!data.enabled) return;

const speed: Record<string, string> = { slow: '60s', medium: '40s', fast: '25s' };
const duration = speed[data.marqueeSpeed ?? 'medium'] ?? '40s';
const reverse  = data.direction === 'right' ? 'reverse' : 'normal';

const displayHeading    = overrideHeading    ?? data.heading;
// undefined = use Sanity subheading; null = explicitly hidden
const displaySubheading = overrideSubheading !== undefined ? overrideSubheading : data.subheading;
---

<section
  class="trusted-by"
  aria-label={eyebrow ?? 'Trusted by'}
>
  <!-- Heading block -->
  <div class="trusted-by__header">
    {eyebrow && (
      <p class="trusted-by__eyebrow">{eyebrow}</p>
    )}
    <h2 class="trusted-by__heading">{displayHeading}</h2>
    {displaySubheading && (
      <p class="trusted-by__subheading">{displaySubheading}</p>
    )}
  </div>

  <!-- Marquee -->
  <div class="trusted-by__marquee" aria-hidden="true">
    <div
      class="trusted-by__track"
      style={`animation-duration:${duration};animation-direction:${reverse};`}
    >
      {/* First set */}
      {data.logos.map((logo) => (
        <span class="trusted-by__item" title={logo.clientName}>
          <img
            src={`/clients-logo/${logo.logoFilename}`}
            alt={`${logo.clientName} logo`}
            class="trusted-by__logo"
            loading="lazy"
            decoding="async"
            style={logo.scale && logo.scale !== 1 ? `transform:scale(${logo.scale});transform-origin:center;` : undefined}
          />
        </span>
      ))}
      {/* Duplicate — makes translateX(-50%) loop seamless */}
      {data.logos.map((logo) => (
        <span class="trusted-by__item" aria-hidden="true" title={logo.clientName}>
          <img
            src={`/clients-logo/${logo.logoFilename}`}
            alt=""
            class="trusted-by__logo"
            loading="lazy"
            decoding="async"
            style={logo.scale && logo.scale !== 1 ? `transform:scale(${logo.scale});transform-origin:center;` : undefined}
          />
        </span>
      ))}
    </div>
  </div>
</section>

<style>
  /* ── Section shell ───────────────────────────────────── */
  .trusted-by {
    background: #ffffff;
    padding: 64px 0;
    overflow: hidden;
  }

  /* ── Heading block ───────────────────────────────────── */
  .trusted-by__header {
    text-align: center;
    padding: 0 24px;
    margin-bottom: 40px;
  }

  .trusted-by__eyebrow {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #9D833E;
    margin: 0 0 14px;
  }

  .trusted-by__heading {
    font-family: 'Montserrat', 'Inter', sans-serif;
    font-size: clamp(1.35rem, 3vw, 1.875rem); /* text-3xl desktop */
    font-weight: 600;
    color: #212129;
    margin: 0 0 12px;
    line-height: 1.2;
  }

  .trusted-by__subheading {
    font-family: 'Inter', sans-serif;
    font-size: clamp(0.875rem, 1.5vw, 1rem);
    color: #6B7280;
    max-width: 640px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* ── Marquee container ───────────────────────────────── */
  .trusted-by__marquee {
    display: flex;
    width: 100%;
    overflow: hidden;
    /* Edge fade */
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 8%,
      black 92%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 8%,
      black 92%,
      transparent 100%
    );
  }

  /* ── Scrolling track ─────────────────────────────────── */
  .trusted-by__track {
    display: flex;
    align-items: center;
    gap: 5rem;      /* generous gap between logo containers */
    flex-shrink: 0;
    animation: trusted-scroll 40s linear infinite; /* duration overridden inline */
    padding: 8px 0;
  }

  /* Pause on container hover so users can inspect logos */
  .trusted-by:hover .trusted-by__track {
    animation-play-state: paused;
  }

  /* ── Individual logo NORMALISATION container ─────────── */
  .trusted-by__item {
    /*
     * More square-ish container (140×90) gives square/tall logos equal
     * optical weight compared to the previous wide 160×70 container.
     */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 140px;
    height: 90px;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .trusted-by__item:hover {
    transform: scale(1.05);
  }

  .trusted-by__logo {
    /* Fill the container while respecting aspect ratio */
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
    /*
     * 0.75 opacity (was 0.6) keeps the restrained look while ensuring
     * every logo remains clearly readable before hover.
     */
    filter: grayscale(100%) opacity(0.75);
    transition: filter 300ms ease;
    /* NOTE: per-logo scale is applied via inline style on this element */
  }

  .trusted-by__item:hover .trusted-by__logo {
    filter: grayscale(0%) opacity(1);
  }

  /* ── Keyframe ────────────────────────────────────────── */
  @keyframes trusted-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* ── Tablet ──────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .trusted-by__item {
      width: 120px;
      height: 78px;
    }
    .trusted-by__track {
      gap: 3rem;
    }
  }

  /* ── Mobile ──────────────────────────────────────────── */
  @media (max-width: 768px) {
    .trusted-by {
      padding: 48px 0;
    }
    .trusted-by__header {
      margin-bottom: 32px;
    }
    .trusted-by__item {
      width: 100px;
      height: 65px;
    }
    .trusted-by__track {
      gap: 2rem;
    }
  }

  /* ── Reduced motion — static centered grid ───────────── */
  @media (prefers-reduced-motion: reduce) {
    .trusted-by__marquee {
      mask-image: none;
      -webkit-mask-image: none;
    }
    .trusted-by__track {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      gap: 2rem;
      padding: 0 24px;
    }
    /* Hide the duplicate set */
    .trusted-by__item[aria-hidden="true"] {
      display: none;
    }
  }
</style>
