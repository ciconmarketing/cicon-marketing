---
/**
 * EeatBlock — E-E-A-T proof section / Founder credibility block.
 * Dark navy background. Used on About Us and Services Hub.
 * All content driven from props; defaults match the hardcoded originals.
 */
interface Stat { value: string; label: string }
interface Props {
  sectionBadge?:    string
  headline?:        string
  bodyText?:        string   // paragraphs separated by \n\n
  founderName?:     string
  founderTitle?:    string
  founderImageUrl?: string
  credentials?:     string[]
  linkedInUrl?:     string
  stats?:           Stat[]
}
const {
  sectionBadge    = 'Why CiCon',
  headline        = 'Senior strategist on every account',
  bodyText        = `Every campaign at CiCon is run by Majid, our senior strategist with 14+ years in performance marketing. No junior account managers. No rotating points of contact. You get senior strategy on every call, every report, every decision.\n\nThat's what "boutique" actually means.`,
  founderName     = 'Majid Behzad',
  founderTitle    = 'Founder & Senior Strategist',
  founderImageUrl = 'https://cicon.ca/wp-content/uploads/majid-behzad-headshot.jpg',
  credentials     = [
    '14+ years in performance marketing',
    "Google-certified, Master's in Engineering",
    'Postgraduate in Marketing Management',
    'Senior strategist on every account — no handoffs',
    'Boutique model: limited client roster by design',
  ],
  linkedInUrl     = 'https://linkedin.com/in/majidlm/',
  stats           = [],
} = Astro.props
---

<section class="py-20" style="background:var(--shadow)">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">

      <!-- Text column — avatar row + headline/body -->
      <div>
        <div class="eeat-author-row">
          <!-- Circular founder avatar (left column, mobile-only) -->
          <div class="eeat-avatar-wrap flex-shrink-0">
            <img
              src={founderImageUrl}
              alt={`${founderName}, ${founderTitle}, CiCon Marketing`}
              class="eeat-avatar"
              loading="lazy"
              width="100" height="100"
            />
          </div>

          <!-- Headline + body -->
          <div>
            <div class="flex items-center gap-2 mb-3">
              <span class="h-[1px] w-8" style="background:var(--accent)"></span>
              <span class="text-xs font-semibold tracking-widest uppercase" style="color:var(--accent)">{sectionBadge}</span>
            </div>
            <h2 class="text-3xl font-extrabold text-white mb-6">{headline}</h2>
            <div class="space-y-4">
              {bodyText.split('\n\n').map((para) => (
                <p class="text-base leading-relaxed" style="color:#b0b0bb">{para}</p>
              ))}
            </div>

            {stats.length > 0 && (
              <div class="grid grid-cols-3 gap-6 mt-10">
                {stats.map((s) => (
                  <div class="border-l-2 pl-4" style="border-color:var(--accent)">
                    <div class="text-2xl font-extrabold text-white">{s.value}</div>
                    <div class="text-xs mt-0.5" style="color:#666">{s.label}</div>
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>

      <!-- Founder bio card (right column) -->
      <div class="rounded-2xl p-8 border" style="background:#1a1a20;border-color:#2a2a35">
        <div class="flex items-center gap-4 mb-6">
          <div class="w-16 h-16 rounded-full overflow-hidden flex-shrink-0" style="background:var(--accent)">
            <img
              src={founderImageUrl}
              alt={`${founderName}, CiCon Marketing founder`}
              class="w-full h-full object-cover"
              loading="lazy"
              width="64" height="64"
            />
          </div>
          <div>
            <p class="font-bold text-white">{founderName}</p>
            <p class="text-sm" style="color:var(--accent)">{founderTitle}</p>
          </div>
        </div>

        <ul class="space-y-3">
          {credentials.map((point) => (
            <li class="flex items-start gap-3 text-sm" style="color:#b0b0bb">
              <svg class="w-4 h-4 flex-shrink-0 mt-0.5" style="color:var(--action)" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
              </svg>
              {point}
            </li>
          ))}
        </ul>

        {linkedInUrl && (
          <div class="mt-6 pt-6 border-t" style="border-color:#2a2a35">
            <a
              href={linkedInUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm font-medium hover:underline"
              style="color:var(--accent)"
            >
              LinkedIn Profile →
            </a>
          </div>
        )}
      </div>

    </div>
  </div>
</section>

<style>
  .eeat-author-row {
    display: flex;
    gap: 24px;
    align-items: flex-start;
  }
  .eeat-avatar {
    border-radius: 50%;
    width: 100px;
    height: 100px;
    object-fit: cover;
    display: block;
  }
  @media (max-width: 767px) {
    .eeat-author-row {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .eeat-avatar {
      width: 80px;
      height: 80px;
    }
  }
</style>
