---
/**
 * ServiceProof — the #case-study-1 section on a service spoke page.
 *
 * Content comes from SERVICE_PROOF (src/lib/service-proof.ts), not from
 * Sanity, so the owner-approved figures, dates, cost note, screenshot,
 * definition and limits always appear together. Renders nothing for a slug
 * without proof. The screenshot is shown unedited; a native <details> opens it
 * at readable size (no script needed).
 */
import type { ServiceProof as Proof } from '../../lib/service-proof'

interface Props {
  proof: Proof | null
}
const { proof } = Astro.props
---

{proof && (
  <section id="case-study-1" class="py-20 scroll-mt-24" style="background:#fff" aria-labelledby="case-study-1-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="max-w-2xl mb-10">
        <div class="flex items-center gap-2 mb-3">
          <span class="h-[1px] w-8" style="background:var(--accent)" aria-hidden="true"></span>
          <span class="text-xs font-semibold tracking-widest uppercase" style="color:#6E5B2A">{proof.eyebrow}</span>
        </div>
        <h2 id="case-study-1-heading" class="font-heading text-3xl font-extrabold" style="color:var(--black)">{proof.headline}</h2>
        <p class="mt-3 text-base font-semibold" style="color:var(--charcoal)">{proof.period}</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {proof.stats.map((stat) => (
          <div
            class="rounded-2xl p-7 border flex flex-col"
            style="border-color:rgba(157,131,62,0.35);background:#FBF6E8"
          >
            <strong class="text-3xl sm:text-4xl font-extrabold tracking-tight" style="color:#1F1F1F">{stat.value}</strong>
            <span class="mt-2 text-base font-medium" style="color:#3A3A3A">{stat.label}</span>
          </div>
        ))}
      </div>
      <p class="mt-4 text-sm leading-relaxed" style="color:var(--charcoal)">{proof.costNote}</p>

      {proof.image && (
        <figure class="mt-10 max-w-5xl">
          <img
            src={proof.image.src}
            width={proof.image.width}
            height={proof.image.height}
            alt={proof.image.alt}
            loading="lazy"
            decoding="async"
            class="proof-shot block w-full h-auto rounded-xl border"
            style="border-color:rgba(0,0,0,0.12)"
          />
          <figcaption class="mt-3 text-sm leading-relaxed" style="color:var(--charcoal)">{proof.image.caption}</figcaption>
          <details class="proof-shot-full mt-3">
            <summary class="cursor-pointer font-semibold underline underline-offset-4 text-sm" style="color:var(--black)">View the screenshot at full size</summary>
            <div class="proof-shot-scroll mt-3" tabindex="0" aria-label="Full-size screenshot; scroll sideways to read">
              <img
                src={proof.image.src}
                width={proof.image.width}
                height={proof.image.height}
                alt=""
                loading="lazy"
                decoding="async"
                class="proof-shot-native"
              />
            </div>
          </details>
        </figure>
      )}

      <div class="max-w-3xl mt-10 space-y-4">
        <p class="text-base leading-relaxed" style="color:var(--charcoal)">{proof.definition}</p>
        <ul class="space-y-2" role="list">
          {proof.limits.map((limit) => (
            <li class="flex gap-3 text-sm leading-relaxed" style="color:var(--charcoal)">
              <span class="mt-[7px] shrink-0 w-1.5 h-1.5 rounded-full" style="background:var(--accent)" aria-hidden="true"></span>
              <span>{limit}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3">
        <a
          href="/contact-us/#assessment-form"
          class="proof-cta inline-flex items-center gap-2 px-7 py-3.5 font-bold rounded-xl transition-all hover:-translate-y-0.5"
          style="background:var(--action);color:var(--black)"
        >
          Request My Free Assessment
        </a>
        <a href="https://wa.me/16475840800" target="_blank" rel="noopener noreferrer" class="font-semibold underline underline-offset-4" style="color:var(--black)">
          or ask on WhatsApp what we would track for your clinic
        </a>
      </div>

    </div>
  </section>
)}

<style>
  /* Full-size view: the 2048 px screenshot at 1024 CSS px (its 2x capture size), scrolling inside its own box. */
  .proof-shot-scroll { overflow-x: auto; max-width: 100%; }
  .proof-shot-native { display: block; width: 1024px; max-width: none; height: auto; }
  .proof-cta:focus-visible,
  #case-study-1 a:focus-visible,
  #case-study-1 summary:focus-visible,
  .proof-shot-scroll:focus-visible { outline: 3px solid #212129; outline-offset: 3px; }
</style>
