---
/**
 * ServiceRankingProof — the #case-study-2 section on a service spoke page.
 *
 * A separate anonymous clinic's tracked local search positions, drawn as static
 * inline SVG line charts (no script). Every observation is a point placed at
 * its real timestamp; position 1 is at the top because lower is better.
 * Content comes from SERVICE_RANKING_PROOF (src/lib/service-ranking-proof.ts).
 */
import type { ServiceRankingProof as Proof, RankingSeries } from '../../lib/service-ranking-proof'

interface Props {
  proof: Proof | null
}
const { proof } = Astro.props

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']
const fmtDate = (iso: string) => {
  const d = new Date(iso)
  return `${MONTHS[d.getUTCMonth()]} ${d.getUTCDate()}, ${d.getUTCFullYear()}`
}
const fmtTime = (iso: string) => iso.slice(11, 16) + ' UTC'

// Chart geometry in SVG user units; each SVG scales to its container width.
// Two layouts share the same data and real timestamp spacing: "wide" (sm and up)
// and "narrow" (phones), so text stays about 14–16 px on a 375 px screen.
interface Geom { name: 'wide' | 'narrow'; W: number; H: number; pad: { left: number; right: number; top: number; bottom: number }; tick: number; label: number }
const GEOMS: Geom[] = [
  { name: 'wide', W: 600, H: 320, pad: { left: 52, right: 24, top: 28, bottom: 56 }, tick: 17, label: 19 },
  { name: 'narrow', W: 360, H: 300, pad: { left: 44, right: 18, top: 30, bottom: 54 }, tick: 17, label: 19 },
]

function chart(series: RankingSeries, g: Geom) {
  const { W, H, pad: PAD } = g
  const pts = series.points
  const t0 = Date.parse(pts[0].t)
  const t1 = Date.parse(pts[pts.length - 1].t)
  const maxPos = Math.max(...pts.map((p) => p.pos))
  const yMax = Math.max(10, Math.ceil(maxPos / 5) * 5)
  const x = (t: string) => PAD.left + ((Date.parse(t) - t0) / (t1 - t0)) * (W - PAD.left - PAD.right)
  const y = (pos: number) => PAD.top + ((pos - 1) / (yMax - 1)) * (H - PAD.top - PAD.bottom)
  const ticks = [1, ...Array.from({ length: yMax / 5 }, (_, i) => (i + 1) * 5)]
  const first = pts[0]
  const last = pts[pts.length - 1]
  return {
    points: pts.map((p) => ({ ...p, cx: +x(p.t).toFixed(2), cy: +y(p.pos).toFixed(2) })),
    line: pts.map((p) => `${x(p.t).toFixed(2)},${y(p.pos).toFixed(2)}`).join(' '),
    ticks: ticks.map((v) => ({ v, y: +y(v).toFixed(2) })),
    first, last,
    firstXY: { x: +x(first.t).toFixed(2), y: +y(first.pos).toFixed(2) },
    lastXY: { x: +x(last.t).toFixed(2), y: +y(last.pos).toFixed(2) },
    summary: `First supplied observation ${fmtDate(first.t)}: position ${first.pos}. Latest ${fmtDate(last.t)}: position ${last.pos}. ${pts.length} observations.`,
  }
}
const charts = proof ? proof.series.map((s) => ({ series: s, cs: GEOMS.map((g) => ({ g, c: chart(s, g) })) })) : []
---

{proof && (
  <section id="case-study-2" class="py-20 scroll-mt-24" style="background:#FAFAFA" aria-labelledby="case-study-2-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="max-w-3xl mb-10">
        <div class="flex items-center gap-2 mb-3">
          <span class="h-[1px] w-8" style="background:var(--accent)" aria-hidden="true"></span>
          <span class="text-xs font-semibold tracking-widest uppercase" style="color:#6E5B2A">{proof.eyebrow}</span>
        </div>
        <h2 id="case-study-2-heading" class="font-heading text-3xl font-extrabold" style="color:var(--black)">{proof.headline}</h2>
        <p class="mt-4 text-base leading-relaxed" style="color:var(--charcoal)">{proof.intro}</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {charts.map(({ series, cs }, i) => (
          <figure class="rounded-2xl border p-5 sm:p-6" style="border-color:rgba(0,0,0,0.12);background:#fff" data-keyword={series.keyword} data-observations={series.points.length}>
            <h3 class="font-heading text-xl font-bold" style="color:var(--black)">“{series.keyword}”</h3>
            <p class="mt-1 text-sm font-medium" style="color:#3A3A3A">{proof.metricLabel}</p>
            {cs.map(({ g, c }) => (
              <svg
                viewBox={`0 0 ${g.W} ${g.H}`}
                class={`ranking-chart ranking-${g.name} mt-4 w-full h-auto ${g.name === 'wide' ? 'hidden sm:block' : 'block sm:hidden'}`}
                data-variant={g.name}
                role="img"
                aria-labelledby={`rank-title-${i}-${g.name} rank-desc-${i}-${g.name}`}
              >
                <title id={`rank-title-${i}-${g.name}`}>{`${proof.metricLabel}: “${series.keyword}”`}</title>
                <desc id={`rank-desc-${i}-${g.name}`}>{`${c.summary} Each point is one recorded observation placed at its actual date; position 1 is at the top.`}</desc>
                {c.ticks.map((t) => (
                  <g>
                    <line x1={g.pad.left} x2={g.W - g.pad.right} y1={t.y} y2={t.y} stroke="#E5E5E5" stroke-width="1" />
                    <text x={g.pad.left - 8} y={t.y + 6} text-anchor="end" font-size={g.tick} fill="#555">{t.v}</text>
                  </g>
                ))}
                <line x1={g.pad.left} x2={g.W - g.pad.right} y1={g.H - g.pad.bottom + 6} y2={g.H - g.pad.bottom + 6} stroke="#BDBDBD" stroke-width="1" />
                <text x={g.pad.left} y={g.H - 18} font-size={g.tick} fill="#555">{fmtDate(c.first.t)}</text>
                <text x={g.W - g.pad.right} y={g.H - 18} font-size={g.tick} fill="#555" text-anchor="end">{fmtDate(c.last.t)}</text>
                <polyline points={c.line} fill="none" stroke="#9D833E" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" />
                {c.points.map((p) => (
                  <circle cx={p.cx} cy={p.cy} r="3.5" fill="#1F1F1F" data-t={p.t} data-pos={p.pos}>
                    <title>{`${fmtDate(p.t)} ${fmtTime(p.t)}: position ${p.pos}`}</title>
                  </circle>
                ))}
                <text x={c.firstXY.x + 6} y={c.firstXY.y + 26} font-size={g.label} font-weight="700" fill="#1F1F1F">{c.first.pos}</text>
                <text x={c.lastXY.x - 8} y={c.lastXY.y - 10} font-size={g.label} font-weight="700" fill="#1F1F1F" text-anchor="end">{c.last.pos}</text>
              </svg>
            ))}
            <figcaption class="mt-3 text-sm leading-relaxed" style="color:var(--charcoal)">
              {`First supplied observation: ${fmtDate(series.points[0].t)}, position ${series.points[0].pos}. Latest: ${fmtDate(series.points[series.points.length - 1].t)}, position ${series.points[series.points.length - 1].pos}. ${series.points.length} observations, shown at their actual dates (same-day scans overlap at this scale).`}
            </figcaption>
            <details class="mt-3">
              <summary class="cursor-pointer text-sm font-semibold underline underline-offset-4" style="color:var(--black)">{`Show all ${series.points.length} observations`}</summary>
              <div class="ranking-table mt-3">
                <table class="w-full text-sm" style="color:var(--charcoal)">
                  <thead><tr><th class="text-left pr-4">Date</th><th class="text-left pr-4">Time</th><th class="text-left">Position</th></tr></thead>
                  <tbody>
                    {series.points.map((p) => (
                      <tr><td class="pr-4">{fmtDate(p.t)}</td><td class="pr-4">{fmtTime(p.t)}</td><td>{p.pos}</td></tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </details>
          </figure>
        ))}
      </div>

      <ul class="max-w-3xl mt-10 space-y-2" role="list">
        {proof.notes.map((note) => (
          <li class="flex gap-3 text-sm leading-relaxed" style="color:var(--charcoal)">
            <span class="mt-[7px] shrink-0 w-1.5 h-1.5 rounded-full" style="background:var(--accent)" aria-hidden="true"></span>
            <span>{note}</span>
          </li>
        ))}
      </ul>

    </div>
  </section>
)}

<style>
  .ranking-chart text { font-family: Inter, system-ui, sans-serif; }
  .ranking-table { max-height: 18rem; overflow: auto; }
  #case-study-2 summary:focus-visible { outline: 3px solid #212129; outline-offset: 3px; }
</style>
