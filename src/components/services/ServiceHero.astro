---
/**
 * ServiceHero — dark background hero section.
 * Badge + Headline + Subheadline + Description + Stats grid + dual CTAs.
 * Desktop: two-column 60/40 — text left, heroImage right.
 */
import PlaceholderImage from '../PlaceholderImage.astro'

interface Stat { value: string; label: string }
interface Props {
  badge?: string
  headline: string
  subheadline?: string
  description?: string
  stats?: Stat[]
  serviceName: string
  heroImage?: any
}
const { badge, headline, subheadline, description, stats = [], serviceName, heroImage } = Astro.props
---

<section
  id="hero"
  class="relative overflow-hidden"
  style="background:var(--shadow);padding:120px 0 80px"
>
  <!-- Subtle grid texture -->
  <div class="absolute inset-0 opacity-[0.04]"
    style="background-image:linear-gradient(var(--accent) 1px,transparent 1px),linear-gradient(90deg,var(--accent) 1px,transparent 1px);background-size:60px 60px">
  </div>
  <!-- Gold bottom border -->
  <div class="absolute bottom-0 left-0 right-0 h-[2px]" style="background:var(--accent);opacity:.4"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Two-column grid: text left (3fr), image right (2fr) on desktop -->
    <div class="hero-grid">

      <!-- Text column -->
      <div class="hero-text">

        {badge && (
          <div class="inline-flex items-center gap-2 mb-6">
            <span class="h-[1px] w-8" style="background:var(--accent)"></span>
            <span class="text-xs font-semibold tracking-widest uppercase" style="color:var(--accent)">{badge}</span>
          </div>
        )}

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-[1.1] text-white mb-5">
          {headline}
        </h1>

        {subheadline && (
          <p class="text-xl font-semibold mb-4" style="color:var(--action)">{subheadline}</p>
        )}

        {description && (
          <p class="text-lg leading-relaxed mb-8" style="color:#b0b0bb">{description}</p>
        )}

        <!-- CTAs -->
        <div class="flex flex-wrap gap-4 mb-12">
          <div class="flex flex-col items-start gap-2">
            <a
              href="https://wa.me/16475840800"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-7 py-3.5 font-bold rounded-xl transition-all duration-200 hover:-translate-y-0.5"
              style="background:#128C7E;color:#fff"
              onmouseover="this.style.background='#0E6E63'"
              onmouseout="this.style.background='#128C7E'"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="flex-shrink:0">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              Chat on WhatsApp
            </a>
            <a
              href="tel:+12898071020"
              class="text-sm font-medium transition-opacity hover:opacity-100"
              style="color:rgba(255,255,255,0.7)"
            >
              or call +1 (289) 807-1020
            </a>
          </div>
        </div>

        <!-- Stats grid -->
        {stats.length > 0 && (
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-6">
            {stats.map((s) => (
              <div class="border-l-2 pl-4" style="border-color:var(--accent)">
                <div class="text-2xl font-extrabold text-white">{s.value}</div>
                <div class="text-xs mt-0.5" style="color:#888">{s.label}</div>
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- Image column -->
      <div class="hero-image-col">
        <PlaceholderImage
          src={heroImage}
          alt={`${serviceName} — hero image`}
          fieldName="heroImage"
          aspectRatio="16:9"
          variant="hero"
          fallback="stock"
        />
      </div>

    </div>
  </div>
</section>

<style>
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: center;
  }
  .hero-image-col {
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(157, 131, 62, 0.2);
  }
  /* Tablet: 50/50 */
  @media (min-width: 768px) {
    .hero-grid {
      grid-template-columns: 1fr 1fr;
    }
    .hero-image-col {
      max-height: 400px;
      overflow: hidden;
    }
    .hero-image-col :global(img),
    .hero-image-col :global(.cicon-placeholder) {
      max-height: 400px;
      object-fit: cover;
    }
  }
  /* Desktop: 60/40 */
  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: 3fr 2fr;
    }
    .hero-image-col {
      max-height: none;
    }
    .hero-image-col :global(img),
    .hero-image-col :global(.cicon-placeholder) {
      max-height: none;
    }
  }
  /* Mobile: image goes below text (default column order) */
  @media (max-width: 767px) {
    .hero-image-col {
      aspect-ratio: 16 / 9;
      overflow: hidden;
    }
    .hero-image-col :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }
</style>
