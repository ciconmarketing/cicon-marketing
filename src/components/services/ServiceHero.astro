---
/**
 * ServiceHero — dark background hero section.
 * Badge + Headline + Subheadline + Description + Stats grid + dual CTAs.
 * Desktop: two-column 60/40 — text left, heroImage right.
 */
import PlaceholderImage from '../PlaceholderImage.astro'

interface Stat { value: string; label: string }
interface Props {
  badge?: string
  headline: string
  subheadline?: string
  description?: string
  stats?: Stat[]
  serviceName: string
  heroImage?: any
}
const { badge, headline, subheadline, description, stats = [], serviceName, heroImage } = Astro.props
---

<section
  id="hero"
  class="relative overflow-hidden"
  style="background:var(--shadow);padding:120px 0 80px"
>
  <!-- Subtle grid texture -->
  <div class="absolute inset-0 opacity-[0.04]"
    style="background-image:linear-gradient(var(--accent) 1px,transparent 1px),linear-gradient(90deg,var(--accent) 1px,transparent 1px);background-size:60px 60px">
  </div>
  <!-- Gold bottom border -->
  <div class="absolute bottom-0 left-0 right-0 h-[2px]" style="background:var(--accent);opacity:.4"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Two-column grid: text left (3fr), image right (2fr) on desktop -->
    <div class="hero-grid">

      <!-- Text column -->
      <div class="hero-text">

        {badge && (
          <div class="inline-flex items-center gap-2 mb-6">
            <span class="h-[1px] w-8" style="background:var(--accent)"></span>
            <span class="text-xs font-semibold tracking-widest uppercase" style="color:var(--accent)">{badge}</span>
          </div>
        )}

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-[1.1] text-white mb-5">
          {headline}
        </h1>

        {subheadline && (
          <p class="text-xl font-semibold mb-4" style="color:var(--action)">{subheadline}</p>
        )}

        {description && (
          <p class="text-lg leading-relaxed mb-8" style="color:#b0b0bb">{description}</p>
        )}

        <!-- CTAs -->
        <div class="flex flex-wrap gap-4 mb-12">
          <a
            href="https://wa.me/16475840800"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-7 py-3.5 font-bold rounded-xl transition-all duration-200 hover:-translate-y-0.5"
            style="background:var(--action);color:var(--shadow)"
          >
            Chat on WhatsApp
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
          <a
            href="tel:+12898071020"
            class="inline-flex items-center gap-2 px-7 py-3.5 font-semibold rounded-xl border transition-all duration-200 hover:-translate-y-0.5"
            style="border-color:var(--accent);color:#fff"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            289-807-1020
          </a>
        </div>

        <!-- Stats grid -->
        {stats.length > 0 && (
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-6">
            {stats.map((s) => (
              <div class="border-l-2 pl-4" style="border-color:var(--accent)">
                <div class="text-2xl font-extrabold text-white">{s.value}</div>
                <div class="text-xs mt-0.5" style="color:#888">{s.label}</div>
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- Image column -->
      <div class="hero-image-col">
        <PlaceholderImage
          src={heroImage}
          alt={`${serviceName} — hero image`}
          fieldName="heroImage"
          aspectRatio="16:9"
          variant="hero"
          fallback="stock"
        />
      </div>

    </div>
  </div>
</section>

<style>
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: center;
  }
  .hero-image-col {
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(157, 131, 62, 0.2);
  }
  /* Tablet: 50/50 */
  @media (min-width: 768px) {
    .hero-grid {
      grid-template-columns: 1fr 1fr;
    }
    .hero-image-col {
      max-height: 400px;
      overflow: hidden;
    }
    .hero-image-col :global(img),
    .hero-image-col :global(.cicon-placeholder) {
      max-height: 400px;
      object-fit: cover;
    }
  }
  /* Desktop: 60/40 */
  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: 3fr 2fr;
    }
    .hero-image-col {
      max-height: none;
    }
    .hero-image-col :global(img),
    .hero-image-col :global(.cicon-placeholder) {
      max-height: none;
    }
  }
  /* Mobile: image goes below text (default column order) */
  @media (max-width: 767px) {
    .hero-image-col {
      aspect-ratio: 16 / 9;
      overflow: hidden;
    }
    .hero-image-col :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }
</style>
