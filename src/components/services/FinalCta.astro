---
/**
 * FinalCta — dark background closer section.
 * Strategy call CTA + phone + trust strip.
 */
interface Props {
  headline?: string
  body?: string
  serviceName?: string
}
const {
  headline = 'Ready to grow? Let\'s build the plan.',
  body = 'Book a free 30-minute strategy call. We\'ll audit your current marketing, identify your biggest gaps, and map out a realistic growth path — no fluff, no hard sell.',
  serviceName,
} = Astro.props
---

<section id="contact" class="py-24" style="background:var(--shadow)">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">

    <!-- Gold top accent -->
    <div class="w-16 h-[3px] mx-auto mb-8" style="background:var(--accent)"></div>

    <h2 class="text-4xl font-extrabold text-white mb-5">{headline}</h2>
    <p class="text-lg mb-10" style="color:#b0b0bb">{body}</p>

    <!-- CTAs -->
    <div class="flex flex-wrap justify-center gap-4 mb-12">
      <a
        href="https://calendly.com/cicon"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-8 py-4 font-bold rounded-xl text-lg transition-all hover:-translate-y-0.5"
        style="background:var(--action);color:var(--shadow)"
      >
        Book Free Strategy Call
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
      <a
        href="tel:+12898071020"
        class="inline-flex items-center gap-2 px-8 py-4 font-semibold rounded-xl border text-lg transition-all hover:-translate-y-0.5"
        style="border-color:var(--accent);color:#fff"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        289-807-1020
      </a>
    </div>

    <!-- Trust strip -->
    <div class="flex flex-wrap justify-center gap-6 text-sm" style="color:#666">
      {[
        '✓ No long-term contracts',
        '✓ Senior strategist on every account',
        '✓ Monthly transparent reporting',
        '✓ GTA-based, always reachable',
      ].map((t) => <span>{t}</span>)}
    </div>

  </div>
</section>
