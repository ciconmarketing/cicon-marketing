---
/**
 * StickyConversionBar
 * Desktop: slim top bar (40px) that appears after scrolling 300px past hero.
 * Mobile: fixed bottom bar (60px), always visible.
 */
interface Props { serviceName: string }
const { serviceName } = Astro.props
---

<!-- Desktop sticky top bar -->
<div
  id="sticky-bar"
  class="hidden md:flex fixed top-0 left-0 right-0 z-50 items-center justify-between px-6 transition-transform duration-300 -translate-y-full"
  style="height:44px;background:var(--shadow);border-bottom:1px solid var(--accent)"
  aria-label="Sticky conversion bar"
>
  <span class="text-sm font-semibold text-white">{serviceName}</span>
  <div class="flex items-center gap-4">
    <a
      href="tel:+12898071020"
      class="text-sm font-medium transition-colors"
      style="color:#888"
    >289-807-1020</a>
    <a
      href="https://wa.me/16475840800"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 px-4 py-1.5 text-sm font-bold rounded-lg transition-all hover:-translate-y-px"
      style="background:var(--action);color:var(--shadow)"
    >
      Chat on WhatsApp
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
    </a>
  </div>
</div>

<!-- Mobile fixed bottom bar -->
<div
  class="flex md:hidden fixed bottom-0 left-0 right-0 z-50 items-center justify-between px-4"
  style="height:60px;background:var(--shadow);border-top:1px solid var(--accent)"
  aria-label="Mobile conversion bar"
>
  <a
    href="tel:+12898071020"
    class="flex flex-col items-center gap-0.5"
    style="color:#fff"
  >
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
    <span class="text-[10px]" style="color:#888">Call</span>
  </a>
  <a
    href="https://wa.me/16475840800"
    target="_blank"
    rel="noopener noreferrer"
    class="flex-1 mx-4 flex items-center justify-center gap-2 font-bold rounded-xl"
    style="background:var(--action);color:var(--shadow);height:42px"
  >
    Chat on WhatsApp
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
  </a>
</div>

<script>
  const bar = document.getElementById('sticky-bar')
  if (bar) {
    window.addEventListener('scroll', () => {
      bar.classList.toggle('-translate-y-full', window.scrollY < 300)
    }, { passive: true })
  }
</script>
