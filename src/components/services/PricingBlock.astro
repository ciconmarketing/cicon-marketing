---
/**
 * PricingBlock — the #pricing section on a service spoke page.
 *
 * Content comes from SERVICE_PRICING (src/lib/service-pricing.ts), not from
 * Sanity, so the section always matches the hub cards, hero price line, cost
 * FAQ and Offer JSON-LD. Renders nothing for a slug without pricing.
 */
import {
  amountText, offerNotes, unitSuffix,
  type ServicePricing,
} from '../../lib/service-pricing'

interface Props {
  pricing: ServicePricing | null
}
const { pricing } = Astro.props
const offers = pricing?.offers ?? []
// Class strings are literal so Tailwind's scanner picks them up.
const cols =
  offers.length >= 3 ? 'md:grid-cols-2 lg:grid-cols-3'
  : offers.length === 2 ? 'md:grid-cols-2'
  : 'max-w-xl'
---

{pricing && offers.length > 0 && (
  <section id="pricing" class="py-20 scroll-mt-24" style="background:#fff" aria-labelledby="pricing-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="max-w-2xl mb-10">
        <div class="flex items-center gap-2 mb-3">
          <span class="h-[1px] w-8" style="background:var(--accent)" aria-hidden="true"></span>
          <span class="text-xs font-semibold tracking-widest uppercase" style="color:#6E5B2A">Pricing</span>
        </div>
        <h2 id="pricing-heading" class="font-heading text-3xl font-extrabold" style="color:var(--black)">{pricing.headline}</h2>
      </div>

      <div class={`grid grid-cols-1 ${cols} gap-6`}>
        {offers.map((offer) => {
          const notes = offerNotes(offer)
          return (
            <div
              class="pricing-card rounded-2xl p-7 border flex flex-col"
              style="border-color:rgba(157,131,62,0.35);background:#FBF6E8"
              data-offer={offer.id}
            >
              <h3 class="font-heading text-xl font-bold mb-3" style="color:var(--black)">{offer.name}</h3>
              <p class="pricing-price" style="color:#1F1F1F">
                <span class="text-base font-medium">From</span>{' '}
                <strong class="text-3xl sm:text-4xl font-extrabold tracking-tight">{amountText(offer)}</strong><wbr /><span class="text-base font-semibold">{unitSuffix(offer.unit)}</span>
              </p>
              {notes.length > 0 && (
                <ul class="mt-3 space-y-1 text-sm" style="color:#3A3A3A" role="list">
                  {notes.map((n) => <li>{n}</li>)}
                </ul>
              )}
              {offer.description && (
                <p class="mt-4 text-sm leading-relaxed" style="color:var(--charcoal)">{offer.description}</p>
              )}
            </div>
          )
        })}
      </div>

      <div class="max-w-3xl mt-10 space-y-4">
        <p class="text-base leading-relaxed" style="color:var(--charcoal)">{pricing.explanation}</p>
        {pricing.notes?.map((n) => (
          <p class="text-sm leading-relaxed" style="color:var(--charcoal)">{n}</p>
        ))}
      </div>

      {pricing.scopeItems && pricing.scopeItems.length > 0 && (
        <div class="max-w-3xl mt-8">
          <h3 class="font-heading text-lg font-bold mb-4" style="color:var(--black)">{pricing.scopeHeading ?? 'Work we can scope into your plan'}</h3>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2" role="list">
            {pricing.scopeItems.map((item) => (
              <li class="flex gap-3 text-sm leading-relaxed" style="color:var(--charcoal)">
                <span class="mt-[7px] shrink-0 w-1.5 h-1.5 rounded-full" style="background:var(--accent)" aria-hidden="true"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3">
        <a
          href="https://wa.me/16475840800"
          target="_blank"
          rel="noopener noreferrer"
          class="pricing-cta inline-flex items-center gap-2 px-7 py-3.5 font-bold rounded-xl transition-all hover:-translate-y-0.5"
          style="background:#25D366;color:#10231A"
        >
          Get a quote on WhatsApp
        </a>
        <a href="tel:+12898071020" class="font-semibold underline underline-offset-4" style="color:var(--black)">
          or call +1 (289) 807-1020
        </a>
      </div>

    </div>
  </section>
)}

<style>
  .pricing-price { line-height: 1.2; overflow-wrap: anywhere; }
  .pricing-cta:hover { background: #1FB855 !important; }
  .pricing-cta:focus-visible,
  #pricing a:focus-visible { outline: 3px solid #212129; outline-offset: 3px; }
</style>
