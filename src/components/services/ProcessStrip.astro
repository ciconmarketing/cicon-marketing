---
/**
 * ProcessStrip — 4-step process timeline. Light background.
 * Reusable on both spoke pages and hub page.
 */
interface Step { number: number; label: string; description: string }
interface Props { steps?: Step[] }

const defaultSteps: Step[] = [
  { number: 1, label: 'Discovery',  description: 'Audit your current state, identify gaps, define KPIs' },
  { number: 2, label: 'Strategy',   description: 'Build the plan — channels, budget, creative direction' },
  { number: 3, label: 'Execute',    description: 'Launch campaigns, ship assets, track every action' },
  { number: 4, label: 'Report',     description: 'Monthly reviews with the numbers that matter' },
]
const { steps = defaultSteps } = Astro.props
---

<section class="py-20" style="background:var(--off-white)">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="max-w-2xl mb-14">
      <div class="flex items-center gap-2 mb-3">
        <span class="h-[1px] w-8" style="background:var(--accent)"></span>
        <span class="text-xs font-semibold tracking-widest uppercase" style="color:var(--accent-text)">How We Work</span>
      </div>
      <h2 class="font-heading text-3xl font-extrabold" style="color:var(--black)">Four steps. No surprises.</h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {steps.map((step) => (
        <div class="relative">
          <!-- Connector line (hidden on last item) -->
          <div
            class="hidden lg:block absolute top-8 left-[calc(50%+28px)] right-[-50%] h-[1px]"
            style={`background:var(--alabaster);${step.number === steps.length ? 'display:none' : ''}`}
          ></div>

          <div class="bg-white rounded-2xl p-6 border h-full" style="border-color:var(--alabaster)">
            <!-- Step number badge -->
            <div
              class="w-14 h-14 rounded-xl flex items-center justify-center text-xl font-extrabold mb-5"
              style="background:var(--shadow);color:var(--action)"
            >
              {String(step.number).padStart(2, '0')}
            </div>
            <h3 class="font-heading text-lg font-bold mb-2" style="color:var(--black)">{step.label}</h3>
            <p class="text-sm leading-relaxed" style="color:var(--charcoal)">{step.description}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
