---
/**
 * LocalVisibilityScan — the hero-right "Local Visibility Scan" dashboard.
 *
 * Native rebuild of the approved Claude Design reference: same composition,
 * same motion sequence (outward scan → centre-out marker pop → metric
 * resolve → one example tooltip → resting state), but as plain SVG + CSS
 * keyframes instead of a React bundle. The only JS is the metric count-up
 * and the tooltip; every marker reveal is declarative CSS.
 *
 * Two point sets are rendered and toggled by media query rather than by a JS
 * breakpoint: the approved mobile composition uses its own 3×3 layout and its
 * own rank values, so it can't be derived from the desktop 5×5 by scaling.
 * CSS toggling costs ~2 KB of markup and buys zero JS + no hydration flash.
 *
 * SSR renders the *completed* state (all 25 markers, final metric values), so
 * the first frame is never blank, there is no layout shift, and no-JS and
 * reduced-motion visitors get the full meaning. The animation only ever
 * rewinds from there.
 */

// ── Desktop: 5 × 5 scan grid ──────────────────────────────────────────────────
// x/y are percentages inside the map; rank drives the colour bucket; dist is
// the tooltip's secondary line. Centre (50,50) is the business itself.
const INNER = [
  { x: 31, y: 31.5, rank: 3, dist: '1.2 km from your business', delay: 0.70 },
  { x: 50, y: 31.5, rank: 2, dist: '0.9 km from your business', delay: 0.75 },
  { x: 69, y: 31.5, rank: 3, dist: '1.3 km from your business', delay: 0.80 },
  { x: 31, y: 50,   rank: 2, dist: '1.0 km from your business', delay: 0.85 },
  { x: 69, y: 50,   rank: 1, dist: '0.8 km from your business', delay: 0.90 },
  { x: 31, y: 68.5, rank: 1, dist: '1.2 km from your business', delay: 0.95 },
  { x: 50, y: 68.5, rank: 1, dist: '1.0 km from your business', delay: 1.00 },
  { x: 69, y: 68.5, rank: 2, dist: '1.3 km from your business', delay: 1.05 },
];

const OUTER = [
  { x: 12, y: 13,   rank: 7,  dist: '3.1 km from your business', delay: 1.25 },
  { x: 31, y: 13,   rank: 4,  dist: '2.4 km from your business', delay: 1.31 },
  { x: 50, y: 13,   rank: 3,  dist: '2.2 km from your business', delay: 1.37 },
  { x: 69, y: 13,   rank: 6,  dist: '2.5 km from your business', delay: 1.43 },
  { x: 88, y: 13,   rank: 11, dist: '3.3 km from your business', delay: 1.49 },
  { x: 12, y: 31.5, rank: 5,  dist: '2.1 km from your business', delay: 1.55 },
  { x: 88, y: 31.5, rank: 7,  dist: '2.6 km from your business', delay: 1.61 },
  { x: 12, y: 50,   rank: 4,  dist: '1.9 km from your business', delay: 1.67 },
  // the one marker the example tooltip points at — gets a late emphasis pulse
  { x: 88, y: 50,   rank: 7,  dist: '2.3 km from your business', delay: 1.73, emph: true },
  { x: 12, y: 68.5, rank: 3,  dist: '2.0 km from your business', delay: 1.79 },
  { x: 88, y: 68.5, rank: 6,  dist: '2.7 km from your business', delay: 1.85 },
  { x: 12, y: 87,   rank: 8,  dist: '3.2 km from your business', delay: 1.91 },
  { x: 31, y: 87,   rank: 5,  dist: '2.4 km from your business', delay: 1.97 },
  { x: 50, y: 87,   rank: 4,  dist: '2.2 km from your business', delay: 2.03 },
  { x: 69, y: 87,   rank: 7,  dist: '2.5 km from your business', delay: 2.09 },
  { x: 88, y: 87,   rank: 14, dist: '3.5 km from your business', delay: 2.15 },
];

// ── Mobile: approved simplified 3 × 3 composition ─────────────────────────────
const MOBILE = [
  { x: 20, y: 20, rank: 6, delay: 1.05 },
  { x: 50, y: 20, rank: 3, delay: 0.75 },
  { x: 80, y: 20, rank: 9, delay: 1.15 },
  { x: 20, y: 50, rank: 2, delay: 0.65 },
  { x: 80, y: 50, rank: 4, delay: 0.85 },
  { x: 20, y: 80, rank: 3, delay: 0.95 },
  { x: 50, y: 80, rank: 1, delay: 0.70 },
  { x: 80, y: 80, rank: 7, delay: 1.25 },
];

const rankColor = (r: number) =>
  r <= 3 ? '#2F8F5B' : r <= 7 ? '#E0A02C' : r <= 12 ? '#D9762B' : '#B23F2C';
---

<div class="lvs" role="img" aria-label="Example local visibility scan: a 5 by 5 grid of Google Maps ranking positions around a business, strongest at the centre and weakening toward the edges.">

  <!-- ── Chrome ─────────────────────────────────────────────────────────── -->
  <div class="lvs-bar">
    <div class="lvs-bar-l">
      <span class="lvs-logo"><span class="lvs-logo-dot"></span></span>
      <span class="lvs-title">Local Visibility Scan</span>
      <span class="lvs-meta">5 × 5 grid · 3.2 km radius · plumbing services</span>
    </div>
    <div class="lvs-bar-r">
      <span class="lvs-eyebrow">Example scan</span>
      <span class="lvs-chip" data-anim><span class="lvs-chip-dot"></span><span>Complete</span></span>
    </div>
  </div>

  <div class="lvs-body">

    <!-- ── Map ──────────────────────────────────────────────────────────── -->
    <div class="lvs-map" id="lvs-map">

      <!-- Desktop base map. Decorative: all meaning is in the aria-label above. -->
      <svg class="lvs-svg lvs-d" viewBox="0 0 1540 1000" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
        <rect x="0" y="0" width="1540" height="1000" fill="#F0EBE2"></rect>
        <path d="M0 856 C180 838 300 892 470 878 C640 864 720 906 900 918 C1080 930 1240 902 1540 916 L1540 1000 L0 1000 Z" fill="#E3EAEC"></path>
        <path d="M96 74 L344 62 L372 208 L286 262 L110 246 Z" fill="#E5EBDD"></path>
        <path d="M1188 606 L1424 594 L1452 742 L1246 764 L1170 686 Z" fill="#E5EBDD"></path>
        <path d="M640 396 L742 392 L748 470 L646 474 Z" fill="#E7EBE1"></path>
        <g fill="#1E1B170A">
          <rect x="150" y="330" width="70" height="46"></rect><rect x="238" y="326" width="46" height="52"></rect>
          <rect x="150" y="404" width="52" height="40"></rect><rect x="220" y="400" width="64" height="44"></rect>
          <rect x="430" y="150" width="58" height="42"></rect><rect x="506" y="146" width="70" height="46"></rect>
          <rect x="430" y="216" width="80" height="38"></rect><rect x="528" y="214" width="48" height="40"></rect>
          <rect x="860" y="180" width="64" height="48"></rect><rect x="942" y="176" width="52" height="52"></rect>
          <rect x="860" y="252" width="52" height="42"></rect><rect x="930" y="250" width="64" height="44"></rect>
          <rect x="1160" y="330" width="72" height="44"></rect><rect x="1250" y="326" width="54" height="48"></rect>
          <rect x="1160" y="400" width="50" height="46"></rect><rect x="1228" y="398" width="76" height="48"></rect>
          <rect x="330" y="620" width="66" height="48"></rect><rect x="414" y="616" width="52" height="52"></rect>
          <rect x="330" y="692" width="54" height="42"></rect><rect x="402" y="688" width="64" height="46"></rect>
          <rect x="700" y="640" width="70" height="44"></rect><rect x="788" y="636" width="48" height="48"></rect>
          <rect x="700" y="708" width="56" height="40"></rect><rect x="774" y="704" width="62" height="44"></rect>
          <rect x="1000" y="470" width="58" height="40"></rect><rect x="1076" y="466" width="66" height="44"></rect>
        </g>
        <g stroke="#FBF8F3" stroke-width="3.5" vector-effect="non-scaling-stroke" fill="none">
          <path d="M0 130 H1540"></path><path d="M0 296 H1540"></path><path d="M0 546 H1540"></path><path d="M0 758 H1540"></path>
          <path d="M212 0 V1000"></path><path d="M410 0 V1000"></path><path d="M616 0 V860"></path><path d="M846 0 V1000"></path>
          <path d="M1060 0 V880"></path><path d="M1300 0 V1000"></path>
          <path d="M0 396 H616"></path><path d="M846 396 H1540"></path><path d="M0 648 H1540"></path>
          <path d="M116 0 V546"></path><path d="M516 130 V860"></path><path d="M950 130 V1000"></path>
          <path d="M1180 296 V1000"></path><path d="M1430 0 V860"></path>
        </g>
        <g stroke="#FFFFFF" stroke-width="9" vector-effect="non-scaling-stroke" fill="none" stroke-linecap="round">
          <path d="M0 470 H1540"></path><path d="M712 0 V1000"></path>
          <path d="M0 96 C260 150 380 300 620 372 C860 444 1080 700 1540 806"></path>
        </g>
        <g stroke="#E8A33D33" stroke-width="1" vector-effect="non-scaling-stroke" fill="none" stroke-dasharray="7 7">
          <path d="M300 40 C520 120 470 380 560 560 C650 740 520 900 620 990"></path>
          <path d="M1120 20 C1010 200 1160 420 1090 620 C1030 790 1140 900 1080 990"></path>
        </g>
        <g fill="#7C736680" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="17" letter-spacing="1.4">
          <text x="150" y="500">NORTHGATE</text>
          <text x="1210" y="248">RIVERBEND</text>
          <text x="470" y="936">SOUTH MILL</text>
        </g>
      </svg>

      <!-- Mobile base map -->
      <svg class="lvs-svg lvs-m" viewBox="0 0 600 600" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
        <rect x="0" y="0" width="600" height="600" fill="#F0EBE2"></rect>
        <path d="M0 512 C120 500 220 534 330 526 C440 518 520 546 600 540 L600 600 L0 600 Z" fill="#E3EAEC"></path>
        <path d="M40 44 L188 38 L200 128 L64 140 Z" fill="#E5EBDD"></path>
        <path d="M452 366 L568 358 L576 452 L462 462 Z" fill="#E5EBDD"></path>
        <g stroke="#FBF8F3" stroke-width="2.5" vector-effect="non-scaling-stroke" fill="none">
          <path d="M0 168 H600"></path><path d="M0 432 H600"></path>
          <path d="M168 0 V600"></path><path d="M432 0 V600"></path><path d="M0 300 H600"></path>
        </g>
        <g stroke="#FFFFFF" stroke-width="6" vector-effect="non-scaling-stroke" fill="none" stroke-linecap="round">
          <path d="M300 0 V600"></path>
          <path d="M0 60 C160 130 240 300 420 380 C520 424 560 500 600 560"></path>
        </g>
      </svg>

      <!-- Scan-grid overlay (desktop only) -->
      <svg class="lvs-svg lvs-grid lvs-d" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false" data-anim>
        <g stroke="#1E1B1712" stroke-width="1" vector-effect="non-scaling-stroke" stroke-dasharray="3 6" fill="none">
          <path d="M12 0 V100"></path><path d="M31 0 V100"></path><path d="M50 0 V100"></path><path d="M69 0 V100"></path><path d="M88 0 V100"></path>
          <path d="M0 13 H100"></path><path d="M0 31.5 H100"></path><path d="M0 50 H100"></path><path d="M0 68.5 H100"></path><path d="M0 87 H100"></path>
        </g>
      </svg>

      <!-- Service-radius ring + the outward scan pulses -->
      <div class="lvs-radius" data-anim></div>
      <div class="lvs-pulse lvs-pulse-a" data-anim data-pulse></div>
      <div class="lvs-pulse lvs-pulse-b" data-anim data-pulse></div>

      <!-- Desktop markers -->
      {[...INNER, ...OUTER].map((p) => (
        <div
          class="lvs-pt lvs-d"
          data-rank={p.rank}
          data-x={p.x}
          data-y={p.y}
          data-dist={p.dist}
          style={`left:${p.x}%;top:${p.y}%`}
        >
          <span
            data-anim
            class:list={['lvs-dot', { 'lvs-emph': 'emph' in p }]}
            style={`background:${rankColor(p.rank)};--d:${p.delay}s`}
          >{p.rank}</span>
        </div>
      ))}

      <!-- Mobile markers -->
      {MOBILE.map((p) => (
        <div class="lvs-pt lvs-m" style={`left:${p.x}%;top:${p.y}%`}>
          <span
            data-anim
            class="lvs-dot lvs-dot-lg"
            style={`background:${rankColor(p.rank)};--d:${p.delay}s`}
          >{p.rank}</span>
        </div>
      ))}

      <!-- The business itself -->
      <div class="lvs-biz">
        <span class="lvs-biz-pin"><span class="lvs-biz-dot"></span></span>
        <span class="lvs-biz-label">Your Business</span>
      </div>

      <!-- Tooltip (desktop only; driven by JS) -->
      <div class="lvs-tip" id="lvs-tip" hidden>
        <div class="lvs-tip-in">
          <span class="lvs-tip-rank"></span>
          <span class="lvs-tip-dist"></span>
        </div>
      </div>
    </div>

    <!-- ── Metrics rail ─────────────────────────────────────────────────── -->
    <div class="lvs-rail">
      <div class="lvs-stat lvs-d">
        <span class="lvs-stat-k">Scan points</span>
        <span class="lvs-stat-v" data-lvs-count="25">25</span>
      </div>
      <div class="lvs-stat">
        <span class="lvs-stat-k">Average position</span>
        <span class="lvs-stat-v" data-lvs-avg="4.8" data-lvs-avg-m="4.4">4.8</span>
      </div>
      <div class="lvs-stat">
        <span class="lvs-stat-k">Visibility score</span>
        <span class="lvs-stat-v lvs-stat-accent" data-lvs-count="72" data-lvs-suffix="%">72%</span>
      </div>

      <div class="lvs-dist lvs-d">
        <span class="lvs-stat-k">Rank distribution</span>
        <div class="lvs-bars">
          <div class="lvs-row"><span class="lvs-row-k">1–3</span><span class="lvs-track"><span data-anim class="lvs-fill" style="width:91%;background:#2F8F5B;animation-delay:2.4s"></span></span><span class="lvs-row-n">10</span></div>
          <div class="lvs-row"><span class="lvs-row-k">4–7</span><span class="lvs-track"><span data-anim class="lvs-fill" style="width:100%;background:#E0A02C;animation-delay:2.5s"></span></span><span class="lvs-row-n">11</span></div>
          <div class="lvs-row"><span class="lvs-row-k">8–12</span><span class="lvs-track"><span data-anim class="lvs-fill" style="width:18%;background:#D9762B;animation-delay:2.6s"></span></span><span class="lvs-row-n">2</span></div>
          <div class="lvs-row"><span class="lvs-row-k">13+</span><span class="lvs-track"><span data-anim class="lvs-fill" style="width:9%;background:#B23F2C;animation-delay:2.7s"></span></span><span class="lvs-row-n">1</span></div>
        </div>
      </div>

      <!-- Mobile legend replaces the distribution bars -->
      <div class="lvs-legend lvs-m">
        <span><i style="background:#2F8F5B"></i>1–3</span>
        <span><i style="background:#E0A02C"></i>4–7</span>
        <span><i style="background:#D9762B"></i>8–12</span>
        <span><i style="background:#B23F2C"></i>13+</span>
      </div>
    </div>

  </div>
</div>

<style>
  .lvs {
    --ink: #1E1B17;
    --paper: #FFFDFA;
    --bar: #FBF7F1;
    --map: #F0EBE2;
    --line: rgba(30, 27, 23, 0.08);
    --hair: rgba(30, 27, 23, 0.06);
    /* Darkened from #7C7366 / #9A9084 — both failed WCAG AA on the card's
       cream backgrounds (4.37:1 and 2.94:1). These clear 4.5:1 against every
       surface they sit on while keeping the same two-tier grey hierarchy. */
    --muted: #6E675C;
    --muted-2: #726A5D;
    --amber: #E8A33D;
    --amber-ink: #7A4E15;
    --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;

    width: 100%;
    max-width: 780px;
    margin-inline: auto;
    /* Without this the card's intrinsic (min-content) width leaks out to any
       grid/flex parent — a `1fr` hero column would size itself to the card and
       starve the copy beside it. */
    min-width: 0;
    /* Deliberately no aspect-ratio lock on the card. The reference composition
       is 1600 × 900, but the metrics rail has a fixed intrinsic height; below
       ~700px of card width a hard 16:9 makes the card shorter than the rail
       and `overflow:hidden` silently crops the rank-distribution rows. The map
       carries the proportions instead (below), and the card takes whichever of
       map/rail is taller — so it lands near 16:9 when there's room and simply
       grows instead of cropping when there isn't. */
    border-radius: 16px;
    background: var(--paper);
    border: 1px solid var(--line);
    box-shadow: 0 1px 2px rgba(30, 27, 23, 0.05), 0 22px 46px -20px rgba(0, 0, 0, 0.45);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    color: var(--ink);
    /* the widget is a UI mock — keep it off the page's heading font */
    font-family: 'Inter', system-ui, sans-serif;
    contain: paint;
  }

  /* ── Breakpoint toggles ──────────────────────────────────────────────── */
  .lvs-m { display: none; }
  @media (max-width: 700px) {
    .lvs-d { display: none !important; }
    .lvs-m { display: block; }
    .lvs-legend.lvs-m { display: flex; }
  }

  /* ── Chrome ──────────────────────────────────────────────────────────── */
  .lvs-bar {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 12px 16px; border-bottom: 1px solid var(--hair); background: var(--bar); flex: none;
  }
  .lvs-bar-l { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .lvs-logo {
    display: flex; align-items: center; justify-content: center;
    width: 24px; height: 24px; border-radius: 7px; background: var(--ink); flex: none;
  }
  .lvs-logo-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--amber); }
  .lvs-title { font-size: 14px; font-weight: 700; letter-spacing: -0.01em; white-space: nowrap; }
  .lvs-meta {
    font-family: var(--mono); font-size: 11px; color: var(--muted);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    /* nowrap text keeps its full width as min-content unless the flex item is
       explicitly allowed to shrink; without this the ellipsis never engages */
    min-width: 0;
  }
  .lvs-bar-r { display: flex; align-items: center; gap: 10px; flex: none; }
  .lvs-eyebrow {
    font-family: var(--mono); font-size: 10px; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--muted-2);
  }
  .lvs-chip {
    display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 999px;
    background: rgba(232, 163, 61, 0.16); color: var(--amber-ink);
    font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.06em; text-transform: uppercase;
    animation: lvsFade 0.4s ease 0.3s both;
  }
  .lvs-chip-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--amber); }

  @media (max-width: 700px) {
    .lvs-meta, .lvs-eyebrow { display: none; }
  }

  /* ── Layout ──────────────────────────────────────────────────────────── */
  .lvs-body { flex: 1; display: flex; min-height: 0; }
  .lvs-map {
    position: relative; flex: 1; min-width: 0; background: var(--map);
    overflow: hidden;
    /* sets the card's proportions when the map is the taller of the two;
       flex stretch takes over when the rail needs more height */
    aspect-ratio: 16 / 10;
  }
  .lvs-svg { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .lvs-grid { animation: lvsFade 0.55s ease 0.35s both; }

  .lvs-rail {
    flex: none; width: 27%; min-width: 168px; max-width: 240px;
    border-left: 1px solid var(--line); background: var(--paper);
    display: flex; flex-direction: column; overflow: hidden;
  }
  .lvs-stat {
    padding: 11px 14px 10px; border-bottom: 1px solid var(--hair);
    display: flex; flex-direction: column; gap: 3px; flex: none;
  }
  .lvs-stat-k {
    font-family: var(--mono); font-size: 10px; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--muted);
  }
  .lvs-stat-v {
    font-size: 22px; font-weight: 700; letter-spacing: -0.025em;
    font-variant-numeric: tabular-nums; line-height: 1;
  }
  .lvs-stat-accent { color: var(--amber-ink); }

  .lvs-dist { padding: 12px 14px; display: flex; flex-direction: column; gap: 8px; }
  .lvs-bars { display: flex; flex-direction: column; gap: 8px; }
  .lvs-row { display: flex; align-items: center; gap: 8px; }
  .lvs-row-k { font-family: var(--mono); font-size: 10.5px; color: #575046; width: 30px; flex: none; }
  .lvs-track {
    flex: 1; height: 6px; border-radius: 4px;
    background: rgba(30, 27, 23, 0.07); overflow: hidden;
  }
  .lvs-fill {
    display: block; height: 100%; border-radius: 4px; transform-origin: left;
    animation: lvsBar 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .lvs-row-n {
    font-family: var(--mono); font-size: 10.5px; color: #575046;
    width: 15px; text-align: right; flex: none;
  }

  .lvs-legend {
    display: none; gap: 10px; padding: 10px 14px;
    font-family: var(--mono); font-size: 10px; color: #575046;
    border-top: 1px solid var(--hair);
  }
  .lvs-legend span { display: inline-flex; align-items: center; gap: 4px; }
  .lvs-legend i { width: 8px; height: 8px; border-radius: 50%; }

  /* Mobile: map goes near-square, rail becomes a 2-up strip underneath */
  @media (max-width: 700px) {
    /* mobile is its own composition: the metrics stack under the map rather
       than sitting in a side rail. The map is trimmed slightly off square and
       the chrome paddings tightened, so the card claims noticeably less
       vertical space after the hero copy — marker size is left alone so the
       rank numbers stay readable. */
    .lvs { max-width: 420px; }
    .lvs-body { flex-direction: column; }
    .lvs-map { aspect-ratio: 1 / 0.9; flex: none; }
    .lvs-bar { padding: 10px 14px; }
    .lvs-stat { padding: 9px 12px 8px; }
    .lvs-stat-v { font-size: 21px; }
    .lvs-legend { padding: 8px 12px; }
    .lvs-rail {
      width: 100%; max-width: none; min-width: 0;
      border-left: 0; border-top: 1px solid var(--line);
      flex-direction: row; flex-wrap: wrap;
    }
    .lvs-stat { flex: 1 1 50%; border-bottom: 0; border-right: 1px solid var(--hair); }
    .lvs-stat:last-of-type { border-right: 0; }
    .lvs-legend { flex-basis: 100%; }
  }

  /* ── Scan pulses + radius ────────────────────────────────────────────── */
  .lvs-radius {
    position: absolute; left: 50%; top: 50%; width: 20%; padding-bottom: 20%; height: 0;
    border-radius: 50%; background: rgba(47, 143, 91, 0.08); border: 1px solid rgba(47, 143, 91, 0.16);
    transform: translate(-50%, -50%); animation: lvsFade 0.7s ease 1.1s both;
  }
  .lvs-pulse {
    position: absolute; left: 50%; top: 50%; width: 34%; padding-bottom: 34%; height: 0;
    border-radius: 50%;
    animation: lvsScan 2.2s cubic-bezier(0.2, 0.65, 0.3, 1) 1 both;
  }
  .lvs-pulse-a { background: rgba(232, 163, 61, 0.15); animation-delay: 0.45s; }
  .lvs-pulse-b { border: 1px solid rgba(232, 163, 61, 0.36); animation-delay: 0.6s; }
  @media (max-width: 700px) {
    .lvs-pulse { width: 40%; padding-bottom: 40%; animation-duration: 1.9s; }
    .lvs-pulse-b { display: none; }
    .lvs-radius { display: none; }
  }

  /* ── Markers ─────────────────────────────────────────────────────────── */
  .lvs-pt { position: absolute; transform: translate(-50%, -50%); }
  .lvs-dot {
    display: flex; align-items: center; justify-content: center;
    width: 34px; height: 34px; border-radius: 50%;
    color: #fff; font-family: var(--mono); font-size: 13px; font-weight: 600;
    border: 2px solid var(--paper); box-shadow: 0 3px 8px rgba(30, 27, 23, 0.16);
    /* delay comes in as --d so the emphasis rule below can add a second
       animation without an inline animation-delay clobbering both of them */
    animation: lvsPop 0.5s cubic-bezier(0.22, 1, 0.36, 1) var(--d, 0s) both;
    /* deliberately no will-change: the pop is a one-shot intro, so promoting
       24 markers to permanent compositor layers only costs memory (and made
       them drop out of rasterised screenshots) */
  }
  .lvs-dot-lg { width: 42px; height: 42px; font-size: 16px; }
  /* the marker the example tooltip lands on — pops in, then breathes once */
  .lvs-emph {
    box-shadow: 0 4px 12px rgba(30, 27, 23, 0.22);
    animation:
      lvsPop 0.5s cubic-bezier(0.22, 1, 0.36, 1) var(--d, 0s) both,
      lvsEmph 1.5s ease 3.5s 1 both;
  }
  /* scale the wrapper, not the dot: the dot's pop animation uses fill-mode
     `both`, and an animated transform always beats a plain declaration */
  .lvs-pt { transition: transform 0.18s cubic-bezier(0.22, 1, 0.36, 1); }
  .lvs-pt:hover { transform: translate(-50%, -50%) scale(1.12); z-index: 6; }

  /* markers scale down on narrow desktop / tablet so 25 of them stay legible */
  @media (max-width: 1100px) and (min-width: 701px) {
    .lvs-dot { width: 28px; height: 28px; font-size: 11px; border-width: 2px; }
  }
  @media (max-width: 860px) and (min-width: 701px) {
    .lvs-dot { width: 24px; height: 24px; font-size: 10px; }
  }

  .lvs-biz {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
    display: flex; flex-direction: column; align-items: center; gap: 7px; z-index: 5;
    pointer-events: none;
  }
  .lvs-biz-pin {
    display: flex; align-items: center; justify-content: center;
    width: 30px; height: 30px; border-radius: 50%; background: var(--ink);
    border: 3px solid var(--paper);
    box-shadow: 0 0 0 6px rgba(232, 163, 61, 0.17), 0 4px 14px rgba(30, 27, 23, 0.27);
  }
  .lvs-biz-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--amber); }
  .lvs-biz-label {
    padding: 5px 11px; border-radius: 8px; background: var(--ink); color: #FBF8F3;
    font-size: 12px; font-weight: 700; white-space: nowrap;
    box-shadow: 0 3px 10px rgba(30, 27, 23, 0.22);
  }

  /* ── Tooltip ─────────────────────────────────────────────────────────── */
  .lvs-tip {
    position: absolute; z-index: 8; pointer-events: none;
    transform: translate(-50%, -128%);
    animation: lvsTip 0.22s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .lvs-tip[hidden] { display: none; }
  .lvs-tip-in {
    padding: 8px 11px; border-radius: 10px; background: var(--ink); color: #FBF8F3;
    box-shadow: 0 10px 26px -10px rgba(30, 27, 23, 0.4);
    white-space: nowrap; display: flex; flex-direction: column; gap: 2px;
  }
  .lvs-tip-rank { font-size: 13px; font-weight: 700; }
  .lvs-tip-dist { font-family: var(--mono); font-size: 10.5px; color: rgba(251, 248, 243, 0.65); }

  /* ── Keyframes ───────────────────────────────────────────────────────── */
  @keyframes lvsScan {
    0%   { transform: translate(-50%, -50%) scale(0.18); opacity: 0.42; }
    65%  { opacity: 0.12; }
    100% { transform: translate(-50%, -50%) scale(2.75); opacity: 0; }
  }
  @keyframes lvsPop  { 0% { opacity: 0; transform: scale(0.55); } 100% { opacity: 1; transform: scale(1); } }
  @keyframes lvsFade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes lvsEmph { 0%, 100% { transform: scale(1); } 30%, 70% { transform: scale(1.1); } }
  @keyframes lvsTip  {
    from { opacity: 0; transform: translate(-50%, -108%) scale(0.95); }
    to   { opacity: 1; transform: translate(-50%, -128%) scale(1); }
  }
  @keyframes lvsBar  { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  /* Reduced motion: the SSR'd resting state is already the finished scan, so
     simply disabling every animation leaves the full meaning on screen. */
  @media (prefers-reduced-motion: reduce) {
    .lvs [data-anim],
    .lvs .lvs-chip,
    .lvs .lvs-grid,
    .lvs .lvs-radius { animation: none !important; opacity: 1 !important; transform: none !important; }
    .lvs [data-pulse] { display: none !important; }
    .lvs-pt .lvs-dot { transform: none !important; }
    .lvs-tip { animation: none !important; }
  }
</style>

<script>
  // Metric count-up + tooltip. Everything else is CSS.
  (() => {
    const root = document.querySelector<HTMLElement>('.lvs');
    const map = document.getElementById('lvs-map');
    if (!root || !map) return;

    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const counts = [...root.querySelectorAll<HTMLElement>('[data-lvs-count]')];
    const avg = root.querySelector<HTMLElement>('[data-lvs-avg]');

    // SSR already renders the finished values, so reduced-motion users are done.
    if (!reduced) {
      const isMobile = matchMedia('(max-width: 700px)').matches;
      counts.forEach((el) => { el.textContent = '0' + (el.dataset.lvsSuffix || ''); });
      if (avg) avg.textContent = '—';

      const run = () => {
        const t0 = performance.now();
        const tick = (now: number) => {
          const p = Math.min(1, (now - t0) / 850);
          const e = 1 - Math.pow(1 - p, 3);
          counts.forEach((el) => {
            const to = Number(el.dataset.lvsCount) || 0;
            el.textContent = Math.round(e * to) + (el.dataset.lvsSuffix || '');
          });
          if (avg) {
            avg.textContent = p < 0.4 ? '—' : (isMobile ? avg.dataset.lvsAvgM : avg.dataset.lvsAvg) || '';
          }
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };

      // Only start once the widget is actually on screen.
      const io = new IntersectionObserver((entries) => {
        if (!entries[0].isIntersecting) return;
        io.disconnect();
        setTimeout(run, isMobile ? 1700 : 2300);
        if (!isMobile) {
          // one brief example tooltip on the marker that gets the emphasis pulse
          setTimeout(() => showTip(88, 50, '7', '2.3 km from your business', true), 3600);
          setTimeout(() => { if (autoTip) hideTip(); }, 4900);
        }
      }, { threshold: 0.25 });
      io.observe(root);
    }

    // ── Tooltip ────────────────────────────────────────────────────────────
    const tip = document.getElementById('lvs-tip');
    const tipRank = tip?.querySelector<HTMLElement>('.lvs-tip-rank');
    const tipDist = tip?.querySelector<HTMLElement>('.lvs-tip-dist');
    let autoTip = false;

    function showTip(x: number, y: number, rank: string, dist: string, auto = false) {
      if (!tip || !tipRank || !tipDist) return;
      autoTip = auto;
      tipRank.textContent = 'Position #' + rank;
      tipDist.textContent = dist;
      tip.style.left = x + '%';
      tip.style.top = y + '%';
      tip.hidden = false;
      // The map clips its overflow, so a percentage clamp isn't enough on
      // narrow cards — the bubble is a fixed pixel width. Measure it and pull
      // it back inside the map's actual box.
      const mapW = map.clientWidth;
      const half = tip.offsetWidth / 2;
      const pad = 8;
      const wanted = (x / 100) * mapW;
      const clamped = Math.min(mapW - half - pad, Math.max(half + pad, wanted));
      tip.style.left = (clamped / mapW) * 100 + '%';
    }
    function hideTip() {
      if (tip) tip.hidden = true;
      autoTip = false;
    }

    map.addEventListener('mouseover', (e) => {
      const cell = (e.target as HTMLElement)?.closest?.<HTMLElement>('[data-rank]');
      if (!cell) return;
      showTip(+cell.dataset.x!, +cell.dataset.y!, cell.dataset.rank!, cell.dataset.dist!);
    });
    map.addEventListener('mouseleave', hideTip);
  })();
</script>
