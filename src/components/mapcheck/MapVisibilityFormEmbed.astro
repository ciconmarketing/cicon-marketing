---
/**
 * MapVisibilityFormEmbed — MJ's dedicated GHL "Google Map Visibility" form,
 * shown as a visible inline form on the Free Map Check page.
 *
 * Same pattern as AssessmentFormEmbed: the layout is INLINE, never sticky or
 * collapsed. The form, trigger and cookie-consent attributes stay as supplied.
 * Do not edit them here without MJ's approval.
 *
 * The form's heading and fields live in GHL. After submit, GHL opens
 * /gbp-thank-you/, which vercel.json forwards to /thank-you/.
 * GhlFormLoader loads the form and form_embed.js when a visitor gets near it.
 */
import GhlFormLoader from '../GhlFormLoader.astro';
---

<div class="map-form-card">
  <p class="ghl-form-wait">
    Loading the form…
    <a href="https://link.cicon.ca/widget/form/NcwBsJYWmlpd2jI3BkHr" target="_blank" rel="noopener">Open it in a new tab</a>
  </p>
  <iframe
    src="https://link.cicon.ca/widget/form/NcwBsJYWmlpd2jI3BkHr"
    id="inline-NcwBsJYWmlpd2jI3BkHr"
    loading="lazy"
    class="map-form-frame"
    data-layout="{'id':'INLINE'}"
    data-trigger-type="alwaysShow"
    data-trigger-value=""
    data-activation-type="alwaysActivated"
    data-activation-value=""
    data-deactivation-type="neverDeactivate"
    data-deactivation-value=""
    data-form-name="Google Map Visibility"
    data-height="923"
    data-layout-iframe-id="inline-NcwBsJYWmlpd2jI3BkHr"
    data-form-id="NcwBsJYWmlpd2jI3BkHr"
    data-cookie-consent="true"
    data-cookie-consent-provider="auto"
    title="Google Map Visibility"
  ></iframe>
  <GhlFormLoader />
</div>

<style is:global>
  .map-form-card {
    --form-h: 1640px;
    position: relative;
    min-height: var(--form-h);
    background: #fff;
    border: 1px solid #E7E7E7;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(33, 33, 41, 0.08);
  }

  /* Starting heights from the measured form; GHL's script can then resize the iframe */
  .map-form-frame { display: block; width: 100%; height: var(--form-h); border: 0; }
  /* GHL's script hides the iframe off-page until the form reports in. Keep it visible
     and in place so the form never depends on that; the script still sets the height. */
  .map-form-frame {
    position: relative !important;
    left: auto !important;
    opacity: 1 !important;
    visibility: visible !important;
    pointer-events: auto !important;
  }
  @media (max-width: 340px) { .map-form-card { --form-h: 1870px; } }
  /* Phones: edge-to-edge card so the form's Cloudflare check has room */
  @media (max-width: 639px) {
    .map-form-card {
      width: 100vw;
      margin-left: calc(50% - 50vw);
      border-radius: 0;
      border-left: 0;
      border-right: 0;
    }
  }
  @media (min-width: 480px) { .map-form-card { --form-h: 1420px; } }
  @media (min-width: 640px) { .map-form-card { --form-h: 1330px; } }
</style>
