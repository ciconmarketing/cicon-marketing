---
/**
 * RServices — dark re-skin of the "What We Do" 12-service grid.
 * Same items, descriptions and destination URLs; icons are the same lucide
 * glyphs inlined as SVG (no React island needed on this page).
 */
import type { ServicesData } from '../../../lib/types';
interface Props { data: ServicesData }
const { data } = Astro.props;

// lucide-static path data (ISC) — mirrors the live grid's icon mapping
