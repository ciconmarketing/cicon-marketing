---
/**
 * RContactForm — dark re-skin of the 4-step qualifier (contact/ContactForm).
 * The step logic, fields, validation, copy, endpoint and analytics events match
 * the light form (including the step-3 budget period) — only the skin differs (rdf-* classes in /public/redesign/
 * redesign.css: charcoal card, amber focus/selected states, non-amber submit).
 */
const FORM_ENDPOINT = "https://services.leadconnectorhq.com/hooks/dQdD9zKPpebLfgGNi9FP/webhook-trigger/572fd3b5-8703-4ed7-be76-faf8e478b623";
interface Props {
  source?: string;
  submitLabel?: string;
}
const { source = '', submitLabel = 'Send it' } = Astro.props;
---

<section id="contact-form" style="scroll-margin-top:80px;">
  <form
    id="cicon-contact-form"
    novalidate
    aria-label="Contact CiCon Marketing"
    class="rdf-form"
  >
    <!-- Progress indicator -->
    <div style="margin-bottom:28px;">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
        <span id="step-label" class="rdf-steplabel" aria-live="polite" aria-atomic="true">Step 1 of 4</span>
        <span id="step-description" class="rdf-stepdesc">Who we're talking to</span>
      </div>
      <div class="rdf-progress">
        <div
          id="progress-bar"
          class="rdf-progress-bar"
          role="progressbar"
          aria-labelledby="step-label"
          aria-valuemin={0}
          aria-valuemax={100}
          aria-valuenow={25}
        ></div>
      </div>
    </div>

    <!-- Live region for validation errors -->
    <div id="form-error-live" class="rdf-alert" role="alert" aria-live="polite" style="display:none;"></div>

    <!-- ═══════════ STEP 1 ═══════════ -->
    <div id="step-1" data-step="1">
      <h2 class="rdf-h font-heading">First, who are we talking to?</h2>
      <p class="rdf-p">This shapes everything we send back — strategy, not a brochure.</p>

      <fieldset style="border:none;padding:0;margin:0 0 28px;">
        <legend id="legend-step1" class="rdf-legend">I run a:</legend>
        <div role="radiogroup" aria-labelledby="legend-step1" style="display:flex;flex-direction:column;gap:12px;">
          <label class="rdf-radio" data-step-field tabindex="0">
            <input type="radio" name="business_type" value="dental" style="display:none;" />
            <span class="rdf-dot" aria-hidden="true"></span>
            <span>Dental clinic</span>
          </label>
          <label class="rdf-radio" data-step-field tabindex="0">
            <input type="radio" name="business_type" value="local" style="display:none;" />
            <span class="rdf-dot" aria-hidden="true"></span>
            <span>Local business</span>
          </label>
        </div>
      </fieldset>

      <div style="display:flex;justify-content:flex-end;">
        <button type="button" class="rdf-next" id="next-1" disabled style="opacity:.5;cursor:not-allowed;">
          Next <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>

    <!-- ═══════════ STEP 2 ═══════════ -->
    <div id="step-2" data-step="2" style="display:none;">
      <h2 class="rdf-h font-heading">What does winning look like in 90 days?</h2>
      <p class="rdf-p">Pick the closest match. We'll get into specifics on the call.</p>

      <fieldset style="border:none;padding:0;margin:0 0 28px;">
        <legend id="legend-step2" class="rd-sr-only">90-day goal</legend>
        <div role="radiogroup" aria-labelledby="legend-step2" style="display:flex;flex-direction:column;gap:12px;">
          <label class="rdf-radio" data-step-field tabindex="0">
            <input type="radio" name="goal" value="more_patients" style="display:none;" />
            <span class="rdf-dot" aria-hidden="true"></span>
            <span>More qualified patients/customers walking in the door</span>
          </label>
          <label class="rdf-radio" data-step-field tabindex="0">
            <input type="radio" name="goal" value="more_leads" style="display:none;" />
            <span class="rdf-dot" aria-hidden="true"></span>
            <span>More leads from Google, Meta, or local search</span>
          </label>
          <label class="rdf-radio" data-step-field tabindex="0">
            <input type="radio" name="goal" value="gbp_visibility" style="display:none;" />
            <span class="rdf-dot" aria-hidden="true"></span>
            <span>Better visibility on Google Business Profile and Maps</span>
          </label>
          <label class="rdf-radio" data-step-field tabindex="0">
            <input type="radio" name="goal" value="other" style="display:none;" />
            <span class="rdf-dot" aria-hidden="true"></span>
            <span>Something else — I'll explain</span>
          </label>
        </div>
      </fieldset>

      <div style="display:flex;justify-content:space-between;">
        <button type="button" class="rdf-back">
          <span aria-hidden="true">←</span> Back
        </button>
        <button type="button" class="rdf-next" id="next-2" disabled style="opacity:.5;cursor:not-allowed;">
          Next <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>

    <!-- ═══════════ STEP 3 ═══════════ -->
    <!-- Budget: period first (monthly / one-time / not sure), then a range for
         that period. `budget` keeps its existing values (plus under_1k) for the
         CRM mapping; `budgetPeriod` and `budgetLabel` carry the period. -->
    <div id="step-3" data-step="3" style="display:none;">
      <h2 class="rdf-h font-heading">What budget are you working with?</h2>
      <p class="rdf-p">This isn't a paywall. It helps us suggest a service and scope that fit.</p>

      <fieldset style="border:none;padding:0;margin:0 0 24px;">
        <legend id="legend-step3-period" class="rdf-legend">Is this for:</legend>
        <div role="radiogroup" aria-labelledby="legend-step3-period" style="display:flex;flex-direction:column;gap:12px;">
          <label class="rdf-radio" data-step-field tabindex="0">
            <input type="radio" name="budgetPeriod" value="monthly" style="display:none;" />
            <span class="rdf-dot" aria-hidden="true"></span>
            <span>A monthly service</span>
          </label>
          <label class="rdf-radio" data-step-field tabindex="0">
            <input type="radio" name="budgetPeriod" value="one_time" style="display:none;" />
            <span class="rdf-dot" aria-hidden="true"></span>
            <span>A one-time project or session</span>
          </label>
          <label class="rdf-radio" data-step-field tabindex="0">
            <input type="radio" name="budgetPeriod" value="not_sure" style="display:none;" />
            <span class="rdf-dot" aria-hidden="true"></span>
            <span>Not sure yet</span>
          </label>
        </div>
      </fieldset>

      <fieldset id="budget-amount" hidden style="border:none;padding:0;margin:0 0 20px;">
        <legend id="legend-step3" class="rdf-legend" data-monthly="What monthly budget do you have for our service fees?" data-one_time="What budget do you have for the project or session?">What budget do you have?</legend>
        <div role="radiogroup" aria-labelledby="legend-step3" style="display:flex;flex-direction:column;gap:12px;">
          <label class="rdf-radio" data-step-field tabindex="0">
            <input type="radio" name="budget" value="under_1k" style="display:none;" />
            <span class="rdf-dot" aria-hidden="true"></span>
            <span><span class="budget-text">Under $1,000 CAD</span><span class="budget-suffix"></span></span>
          </label>
          <label class="rdf-radio" data-step-field tabindex="0">
            <input type="radio" name="budget" value="1k_2k" style="display:none;" />
            <span class="rdf-dot" aria-hidden="true"></span>
            <span><span class="budget-text">$1,000 – $2,000 CAD</span><span class="budget-suffix"></span></span>
          </label>
          <label class="rdf-radio" data-step-field tabindex="0">
            <input type="radio" name="budget" value="2k_5k" style="display:none;" />
            <span class="rdf-dot" aria-hidden="true"></span>
            <span><span class="budget-text">$2,000 – $5,000 CAD</span><span class="budget-suffix"></span></span>
          </label>
          <label class="rdf-radio" data-step-field tabindex="0">
            <input type="radio" name="budget" value="5k_10k" style="display:none;" />
            <span class="rdf-dot" aria-hidden="true"></span>
            <span><span class="budget-text">$5,000 – $10,000 CAD</span><span class="budget-suffix"></span></span>
          </label>
          <label class="rdf-radio" data-step-field tabindex="0">
            <input type="radio" name="budget" value="10k_plus" style="display:none;" />
            <span class="rdf-dot" aria-hidden="true"></span>
            <span><span class="budget-text">$10,000+ CAD</span><span class="budget-suffix"></span></span>
          </label>
          <label class="rdf-radio" data-step-field tabindex="0">
            <input type="radio" name="budget" value="not_sure" style="display:none;" />
            <span class="rdf-dot" aria-hidden="true"></span>
            <span><span class="budget-text">Not sure yet — let's talk</span></span>
          </label>
        </div>
      </fieldset>

      <p id="budget-unsure-note" class="rdf-p" hidden style="margin-bottom:20px;">No problem — we'll work out the right service and scope together.</p>
      <p class="rdf-p" style="font-size:13px;margin-bottom:28px;">Ad spend is excluded from CiCon service fees. If you run ads, your ad budget is separate.</p>

      <div style="display:flex;justify-content:space-between;">
        <button type="button" class="rdf-back">
          <span aria-hidden="true">←</span> Back
        </button>
        <button type="button" class="rdf-next" id="next-3" disabled style="opacity:.5;cursor:not-allowed;">
          Next <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>

    <!-- ═══════════ STEP 4 ═══════════ -->
    <div id="step-4" data-step="4" style="display:none;">
      <h2 class="rdf-h font-heading">Last step. Where do we reach you?</h2>
      <p class="rdf-p">We reply within 1 business hour, Mon–Sat. No drip campaigns. No "nurture sequences."</p>

      <div style="display:flex;flex-direction:column;gap:20px;margin-bottom:28px;">
        <!-- Full name -->
        <div>
          <label for="full_name" class="rdf-label">
            Full name <span style="color:#ff9d91;" aria-hidden="true">*</span>
          </label>
          <input
            type="text"
            id="full_name"
            name="full_name"
            autocomplete="name"
            required
            placeholder="Jane Smith"
            class="rdf-input"
          />
          <div id="err-full_name" class="rdf-err" role="alert" aria-live="polite" style="display:none;"></div>
        </div>

        <!-- Email -->
        <div>
          <label for="email" class="rdf-label">
            Email <span style="color:#ff9d91;" aria-hidden="true">*</span>
          </label>
          <input
            type="email"
            id="email"
            name="email"
            autocomplete="email"
            required
            placeholder="jane@example.com"
            class="rdf-input"
          />
          <div id="err-email" class="rdf-err" role="alert" aria-live="polite" style="display:none;"></div>
        </div>

        <!-- Phone -->
        <div>
          <label for="phone" class="rdf-label">
            Phone <span style="color:#ff9d91;" aria-hidden="true">*</span>
          </label>
          <input
            type="tel"
            id="phone"
            name="phone"
            autocomplete="tel"
            required
            placeholder="+1 (416) 555-0100"
            class="rdf-input"
          />
          <div id="err-phone" class="rdf-err" role="alert" aria-live="polite" style="display:none;"></div>
        </div>

        <!-- Website URL -->
        <div>
          <label for="website" class="rdf-label">
            Website URL <span style="color:#ff9d91;" aria-hidden="true">*</span>
          </label>
          <input
            type="url"
            id="website"
            name="website"
            autocomplete="url"
            required
            placeholder="https://yourwebsite.com"
            class="rdf-input"
          />
          <div id="err-website" class="rdf-err" role="alert" aria-live="polite" style="display:none;"></div>
        </div>

        <!-- Message -->
        <div>
          <label for="message" class="rdf-label">
            Anything else we should know? <span style="font-size:12px;font-weight:400;color:rgba(231,231,231,0.4);">(optional)</span>
          </label>
          <textarea
            id="message"
            name="message"
            rows="4"
            placeholder="Any details that would help us hit the ground running…"
            class="rdf-input"
            style="resize:vertical;min-height:100px;"
          ></textarea>
        </div>
      </div>

      <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;">
        <button type="button" class="rdf-back">
          <span aria-hidden="true">←</span> Back
        </button>
        <button type="submit" id="btn-submit" class="rdf-submit" data-event="audit_form_submit">
          {submitLabel} <span aria-hidden="true">→</span>
        </button>
      </div>
      <p class="rdf-fine">
        We don't sell, share, or spam. Your info goes to MJ and Soroush — that's it.
      </p>
    </div>

    <!-- Hidden source tag — injected via prop, picked up by form submit handler -->
    {source && <input type="hidden" name="source" value={source} />}
  </form>
</section>

<script define:vars={{ FORM_ENDPOINT }}>
(function () {
  'use strict';

  var currentStep = 1;
  var totalSteps = 4;
  var formData = {};

  var stepDescriptions = {
    1: 'Who we\'re talking to',
    2: '90-day goal',
    3: 'Budget',
    4: 'Contact details',
  };

  // ── helpers ──────────────────────────────────────────────────────────────
  function gtag() {
    if (typeof window.gtag === 'function') {
      window.gtag.apply(window, arguments);
    }
  }

  function showStep(n) {
    for (var i = 1; i <= totalSteps; i++) {
      var el = document.getElementById('step-' + i);
      if (el) el.style.display = (i === n) ? '' : 'none';
    }
    currentStep = n;

    // Progress
    var pct = Math.round((n / totalSteps) * 100);
    var bar = document.getElementById('progress-bar');
    if (bar) {
      bar.style.width = pct + '%';
      bar.setAttribute('aria-valuenow', String(pct));
    }
    var lbl = document.getElementById('step-label');
    if (lbl) lbl.textContent = 'Step ' + n + ' of ' + totalSteps;
    var desc = document.getElementById('step-description');
    if (desc) desc.textContent = stepDescriptions[n] || '';

    gtag('event', 'contact_form_step_view', { step: n });
  }

  function getSelectedValue(name) {
    var el = document.querySelector('input[name="' + name + '"]:checked');
    return el ? el.value : null;
  }

  // Step 3 is complete once a period is chosen and, for monthly or one-time,
  // a range too. "Not sure" needs no range. No range is ever rejected.
  function budgetStepComplete() {
    var period = getSelectedValue('budgetPeriod');
    if (period === 'not_sure') return true;
    return !!(period && getSelectedValue('budget'));
  }

  function setNextBtnState(stepNum) {
    var names = { 1: 'business_type', 2: 'goal', 3: 'budget' };
    var name = names[stepNum];
    if (!name) return;
    var btn = document.getElementById('next-' + stepNum);
    if (!btn) return;
    var val = stepNum === 3 ? budgetStepComplete() : getSelectedValue(name);
    if (val) {
      btn.removeAttribute('disabled');
      btn.style.opacity = '1';
      btn.style.cursor = 'pointer';
    } else {
      btn.setAttribute('disabled', '');
      btn.style.opacity = '.5';
      btn.style.cursor = 'not-allowed';
    }
  }

  function showError(id, msg) {
    var el = document.getElementById(id);
    if (!el) return;
    el.textContent = msg;
    el.style.display = 'block';
    var input = document.getElementById(id.replace('err-', ''));
    if (input) input.classList.add('has-error');
  }

  function clearError(id) {
    var el = document.getElementById(id);
    if (el) { el.textContent = ''; el.style.display = 'none'; }
    var input = document.getElementById(id.replace('err-', ''));
    if (input) input.classList.remove('has-error');
  }

  function clearAllErrors() {
    ['full_name','email','phone','website'].forEach(function (f) { clearError('err-' + f); });
    var live = document.getElementById('form-error-live');
    if (live) live.style.display = 'none';
  }

  // ── budget period (step 3) ────────────────────────────────────────────────
  var PERIOD_SUFFIX = { monthly: ' per month', one_time: ' total' };
  var PERIOD_LABEL = { monthly: 'Monthly service', one_time: 'One-time project or session', not_sure: 'Not sure yet' };

  function applyBudgetPeriod(period) {
    var amount = document.getElementById('budget-amount');
    var unsure = document.getElementById('budget-unsure-note');
    var legend = document.getElementById('legend-step3');
    // A range means something different per period, so ask again on change.
    document.querySelectorAll('input[name="budget"]').forEach(function (r) {
      r.checked = false;
      var l = r.closest('.rdf-radio');
      if (l) l.classList.remove('is-selected');
    });
    delete formData.budget;
    if (amount) amount.hidden = period === 'not_sure';
    if (unsure) unsure.hidden = period !== 'not_sure';
    if (legend && legend.dataset[period]) legend.textContent = legend.dataset[period];
    document.querySelectorAll('#budget-amount .budget-suffix').forEach(function (el) {
      el.textContent = PERIOD_SUFFIX[period] || '';
    });
  }

  function budgetLabel(period, budget) {
    if (period === 'not_sure') return PERIOD_LABEL.not_sure;
    var input = document.querySelector('input[name="budget"][value="' + budget + '"]');
    var label = input && input.closest('.rdf-radio');
    var text = label ? label.textContent.replace(/\s+/g, ' ').trim() : budget;
    return PERIOD_LABEL[period] + ': ' + text;
  }

  // ── radio selection styling ───────────────────────────────────────────────
  document.querySelectorAll('.rdf-radio').forEach(function (label) {
    label.addEventListener('click', function () {
      var input = label.querySelector('input[type="radio"]');
      if (!input) return;
      var name = input.name;
      // Deselect siblings
      document.querySelectorAll('input[name="' + name + '"]').forEach(function (sibling) {
        var sibLabel = sibling.closest('.rdf-radio');
        if (sibLabel) {
          sibLabel.classList.remove('is-selected');
        }
      });
      input.checked = true;
      label.classList.add('is-selected');
      // Store
      formData[name] = input.value;
      if (name === 'budgetPeriod') applyBudgetPeriod(input.value);
      // Determine which step we're in from input name
      var stepMap = { business_type: 1, goal: 2, budget: 3, budgetPeriod: 3 };
      var sn = stepMap[name];
      if (sn) setNextBtnState(sn);
    });

    // Keyboard accessibility
    label.addEventListener('keydown', function (e) {
      if (e.key === ' ' || e.key === 'Enter') {
        e.preventDefault();
        label.click();
      }
    });
  });

  // ── next buttons ──────────────────────────────────────────────────────────
  [1, 2, 3].forEach(function (n) {
    var btn = document.getElementById('next-' + n);
    if (!btn) return;
    btn.addEventListener('click', function () {
      if (btn.hasAttribute('disabled')) return;
      var names = { 1: 'business_type', 2: 'goal', 3: 'budget' };
      if (n === 3) {
        // budget keeps its existing values (not_sure when no range applies).
        var period = getSelectedValue('budgetPeriod');
        formData.budgetPeriod = period;
        formData.budget = period === 'not_sure' ? 'not_sure' : getSelectedValue('budget');
        formData.budgetLabel = budgetLabel(period, formData.budget);
      } else {
        formData[names[n]] = getSelectedValue(names[n]);
      }
      gtag('event', 'contact_form_step_complete', { step: n });
      showStep(n + 1);
    });
  });

  // ── back buttons ─────────────────────────────────────────────────────────
  document.querySelectorAll('.rdf-back').forEach(function (btn) {
    btn.addEventListener('click', function () {
      if (currentStep > 1) showStep(currentStep - 1);
    });
  });

  // ── step 4 validation ─────────────────────────────────────────────────────
  function validateStep4() {
    clearAllErrors();
    var valid = true;

    var name = document.getElementById('full_name');
    var email = document.getElementById('email');
    var phone = document.getElementById('phone');
    var website = document.getElementById('website');

    if (!name || !name.value.trim()) {
      showError('err-full_name', "This one's needed to move forward.");
      valid = false;
    }

    if (!email || !email.value.trim()) {
      showError('err-email', "This one's needed to move forward.");
      valid = false;
    } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim())) {
      showError('err-email', "That email doesn't look right — mind checking?");
      valid = false;
    }

    if (!phone || !phone.value.trim()) {
      showError('err-phone', "This one's needed to move forward.");
      valid = false;
    } else if (!/^[\+\d\s\(\)\-\.]{7,20}$/.test(phone.value.trim())) {
      showError('err-phone', "We need a working number to call you back.");
      valid = false;
    }

    if (!website || !website.value.trim()) {
      showError('err-website', "This one's needed to move forward.");
      valid = false;
    } else if (!/^https?:\/\/.+\..+/.test(website.value.trim())) {
      showError('err-website', "A full website address, including https://");
      valid = false;
    }

    return valid;
  }

  // ── form submit ───────────────────────────────────────────────────────────
  var form = document.getElementById('cicon-contact-form');
  if (form) {
    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      if (!validateStep4()) return;

      var submitBtn = document.getElementById('btn-submit');
      if (submitBtn) {
        submitBtn.setAttribute('disabled', '');
        submitBtn.textContent = 'Sending…';
      }

      // Collect step 4 data — field names match GHL inbound_webhook variable names
      var rawName = (document.getElementById('full_name')).value.trim();
      var nameParts = rawName.split(' ');
      formData.fullName   = rawName;                          // {{inbound_webhook.fullName}}
      formData.firstName  = nameParts[0] || '';               // {{inbound_webhook.firstName}}
      formData.lastName   = nameParts.slice(1).join(' ') || ''; // {{inbound_webhook.lastName}}
      formData.email      = (document.getElementById('email')).value.trim();
      formData.phone      = (document.getElementById('phone')).value.trim();
      formData.website    = (document.getElementById('website')).value.trim();
      formData.message    = (document.getElementById('message')).value.trim();
      // Source tag (set via hidden field from RContactForm prop)
      var sourceField = document.querySelector('input[name="source"]');
      if (sourceField) formData.source = sourceField.value;

      gtag('event', 'contact_form_submit');
      gtag('event', 'contact_form_step_complete', { step: 4 });

      try {
        await fetch(FORM_ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(formData),
        });
      } catch (_) {
        // Endpoint not set yet — proceed to thank-you anyway
      }

      window.location.href = '/thank-you/';
    });
  }

  // ── pre-selection from hero ───────────────────────────────────────────────
  window.addEventListener('cicon:preselect', function (e) {
    var type = e.detail && e.detail.type; // "dental" | "local"
    if (!type) return;
    var val = type === 'dental' ? 'dental' : 'local';
    var radio = document.querySelector('input[name="business_type"][value="' + val + '"]');
    if (!radio) return;
    var label = radio.closest('.rdf-radio');
    if (label) {
      // Deselect any current
      document.querySelectorAll('input[name="business_type"]').forEach(function (r) {
        var l = r.closest('.rdf-radio');
        if (l) {
          l.classList.remove('is-selected');
        }
      });
      radio.checked = true;
      label.classList.add('is-selected');
      formData['business_type'] = val;
      setNextBtnState(1);
    }
    // Scroll to form
    var formEl = document.getElementById('contact-form');
    if (formEl) formEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  // ── init ─────────────────────────────────────────────────────────────────
  showStep(1);
})();
</script>
