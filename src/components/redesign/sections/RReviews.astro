<section id="testimonials" class="rd-section rd-section--deep">
  <div class="container-xl">
    <div class="rd-reviews">

      <div>
        <p class="rd-eyebrow rd-r">5-Star Google Reviews</p>
        <h2 class="font-heading rd-h2">
          <span class="rd-k"><span class="rd-k-in">What our clients say</span></span>
        </h2>
        <p class="rd-sub rd-r">
          Real results from real GTA businesses who trusted CiCon Marketing to grow their brand.
        </p>
        <p class="rd-review-count rd-r">{RATING_VALUE} ★ average from {REVIEW_COUNT} Google Reviews</p>

        <div class="rd-dots rd-r" role="group" aria-label="Reviews">
          {REVIEWS.map((r, i) => (
            <button
              class={`rd-dot${i === 0 ? ' is-active' : ''}`}
              data-rd-review-dot={i}
              aria-label={`View testimonial ${i + 1}`}
            ></button>
          ))}
        </div>
        <p class="rd-review-count rd-r"><span id="rd-review-idx">1</span> of {REVIEWS.length} reviews</p>
      </div>

      <div class="rd-review-stage rd-r" id="rd-review-stage">
        {REVIEWS.map((r, i) => (
          <article class={`rd-review${i === 0 ? ' is-active' : ''}`} data-rd-review={i}>
            <div class="rd-review-top">
              <span class="rd-review-id">REC/{String(i + 1).padStart(2, '0')}</span>
              <div class="rd-stars" role="img" aria-label={`${r.rating} out of 5 stars`}>
                {Array(r.rating).fill(0).map(() => <span set:html={STAR} />)}
              </div>
            </div>
            <p class="rd-review-text">"{r.content}"</p>
            <div class="rd-review-meta">
              <h3>{r.name}</h3>
              <span>{r.role}{r.company ? `, ${r.company}` : ''}</span>
            </div>
          </article>
        ))}
      </div>

    </div>
  </div>
</section>

<script>
  // Same rotation behaviour as the live carousel: 7s auto-advance + dot nav.
  const cards = [...document.querySelectorAll<HTMLElement>('[data-rd-review]')];
  const dots = [...document.querySelectorAll<HTMLButtonElement>('[data-rd-review-dot]')];
  const idxEl = document.getElementById('rd-review-idx');
  if (cards.length > 1) {
    let active = 0;
    let timer = 0;
    const show = (i: number) => {
      active = (i + cards.length) % cards.length;
      cards.forEach((c, k) => c.classList.toggle('is-active', k === active));
      dots.forEach((d, k) => d.classList.toggle('is-active', k === active));
      if (idxEl) idxEl.textContent = String(active + 1);
    };
    const motionOK = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;
    const start = () => {
      if (!motionOK) return;
      window.clearInterval(timer);
      timer = window.setInterval(() => show(active + 1), 7000);
    };
    dots.forEach((d, k) =>
      d.addEventListener('click', () => {
        show(k);
        start(); // restart the clock after manual navigation
      }),
    );
    start();
  }
</script>
