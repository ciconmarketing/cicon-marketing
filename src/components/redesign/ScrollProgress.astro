---
/**
 * ScrollProgress — top-of-viewport reading-progress bar.
 *
 * Vanilla replacement for the former React island (ScrollProgress.tsx), which
 * pulled React + ReactDOM (~58 KB, 59% unused) and framer-motion (~42 KB, 75%
 * unused) onto the homepage to animate a 3 px bar. Same look, same spring
 * feel, no framework runtime.
 *
 * Notes:
 *  - Renders server-side as a static element, so there is no hydration cost
 *    and no layout shift (position: fixed, outside normal flow).
 *  - Progress is written to a CSS custom property and applied with a GPU
 *    -composited scaleX transform, so scrolling never triggers layout.
 *  - Uses the same critically-damped spring constants as the framer-motion
 *    version (stiffness 100, damping 30, restDelta 0.001) so the easing is
 *    visually identical.
 *  - Honours prefers-reduced-motion by snapping straight to the target
 *    instead of animating toward it.
 */
---

<div id="rd-scroll-progress" aria-hidden="true"></div>

<style>
  #rd-scroll-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    z-index: 9999;
    transform-origin: 0%;
    transform: scaleX(0);
    background: linear-gradient(90deg, #9d833e, #c9a94a, #ffcf00);
    will-change: transform;
    pointer-events: none;
  }
</style>

<script>
  (() => {
    const bar = document.getElementById('rd-scroll-progress');
    if (!bar) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // framer-motion useSpring defaults used by the previous implementation.
    const STIFFNESS = 100;
    const DAMPING = 30;
    const REST_DELTA = 0.001;
    const MASS = 1;

    let current = 0;   // rendered value
    let velocity = 0;
    let target = 0;
    let rafId = 0;
    let lastTime = 0;

    const readTarget = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      target = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
    };

    const paint = (v: number) => {
      bar.style.transform = `scaleX(${v})`;
    };

    const step = (now: number) => {
      const dt = Math.min((now - lastTime) / 1000, 1 / 30); // clamp long frames
      lastTime = now;

      // Semi-implicit Euler integration of a damped spring.
      const force = -STIFFNESS * (current - target) - DAMPING * velocity;
      velocity += (force / MASS) * dt;
      current += velocity * dt;

      if (Math.abs(current - target) < REST_DELTA && Math.abs(velocity) < REST_DELTA) {
        current = target;
        velocity = 0;
        paint(current);
        rafId = 0;
        return;
      }

      paint(current);
      rafId = requestAnimationFrame(step);
    };

    const onScroll = () => {
      readTarget();
      if (reduceMotion) {
        current = target;
        paint(current);
        return;
      }
      if (!rafId) {
        lastTime = performance.now();
        rafId = requestAnimationFrame(step);
      }
    };

    readTarget();
    current = target;
    paint(current);

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
  })();
</script>
