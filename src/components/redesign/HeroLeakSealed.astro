---
/**
 * HeroLeakSealed — "The Leak, Sealed" redesign POC.
 *
 * Server-rendered shell: everything below is complete, real DOM before any JS
 * runs (eyebrow, headline, subline, CTAs, trust line on charcoal). This is the
 * LCP layer and works with JS disabled.
 *
 * The WebGL particle scene (./leak-scene/mount) is lazy-loaded after first
 * paint on capable desktops only — never on touch devices and never when
 * prefers-reduced-motion is set. In those cases the pure-CSS amber-on-charcoal
 * backdrop below is the final presentation. The canvas is painted into an
 * absolutely-positioned layer, so mounting it causes zero layout shift.
 */
---

<section id="hls" class="hls">

  <!-- Decorative backdrop: amber-on-charcoal glow. Always present; doubles as
       the reduced-motion / touch / no-JS fallback composition. -->
  <div class="hls-bg" aria-hidden="true">
    <!--
      OPTIONAL POSTER SLOT — drop a still image at /public/redesign/hero-poster.jpg
      and uncomment to layer it under the glow. The design must not depend on it.
      <img src="/redesign/hero-poster.jpg" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.4;" loading="eager" decoding="async" />
    -->
  </div>

  <!-- Particle stage — decorative, never intercepts input. Fades in after the
       first WebGL frame; layout is unaffected either way. -->
  <div id="hls-stage" class="hls-stage" aria-hidden="true">
    <canvas id="hls-canvas" class="hls-canvas"></canvas>
  </div>

  <!-- ── Content (real DOM, server-rendered) ── -->
  <div class="container-xl hls-content">

    <p class="hls-eyebrow">For GTA Service Businesses</p>

    <h1 class="hls-h1 font-heading">
      <span class="hls-line">Your marketing isn't broken.</span>
      <span class="hls-line">Your lead system is <span class="hls-leak">leaking</span>.</span>
    </h1>

    <p class="hls-sub">
      CiCon Marketing helps GTA businesses fix the hidden gaps between ads, landing pages, calls, CRM, and reporting — so more traffic turns into real customers.
    </p>

    <div class="hls-ctas">
      <a class="hls-btn hls-btn-outline rd-mag" href="/marketing-services/">
        Explore Services
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>

      <a class="hls-btn hls-btn-wa rd-mag" href="https://wa.me/16475840800" target="_blank" rel="noopener noreferrer">
        <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
        </svg>
        Chat on WhatsApp
      </a>
    </div>

    <p class="hls-trust">Free consultation · No long-term contracts · Measurable results</p>

  </div>

  <!-- Phase-C metric — decorative counter, driven by scroll progress -->
  <div class="hls-metric" id="hls-metric" aria-hidden="true">
    <span class="hls-metric-value" id="hls-metric-value">+0%</span>
    <span class="hls-metric-label">lead capture ↑</span>
  </div>

  <!-- Scroll hint — fades out as the choreography begins -->
  <div class="hls-hint" id="hls-hint" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
    </svg>
  </div>

</section>

<!-- is:inline keeps these rules embedded in this page's HTML so they can never
     be merged into shared CSS chunks that live pages also link. All selectors
     are .hls-* prefixed, so the global scope is safe. -->
<style is:inline>
  .hls {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: #212129; /* shadow-grey (hyphenated: bare utility words in
                            scanned files would generate Tailwind rules) */
  }

  /* CSS backdrop / fallback composition — soft amber glow on charcoal */
  .hls-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(52% 44% at 67% 40%, rgba(255, 207, 0, 0.12), transparent 62%),
      radial-gradient(64% 54% at 28% 74%, rgba(157, 131, 62, 0.16), transparent 66%),
      radial-gradient(120% 90% at 50% 118%, rgba(0, 0, 0, 0.5), transparent 60%);
  }

  /* Particle stage — overlays the glow; opacity-only reveal = zero layout shift */
  .hls-stage {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.8s ease;
    pointer-events: none;
  }
  .hls-stage.is-live { opacity: 1; }
  .hls-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  .hls-content {
    position: relative;
    z-index: 10;
    width: 100%;
    padding-top: 5rem;
    padding-bottom: 5rem;
  }

  /* Eyebrow — Space Mono, engineered/data feel. Goldenrod tick, never amber. */
  .hls-eyebrow {
    font-family: 'Space Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    font-weight: 700;
    font-size: 0.72rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgba(231, 231, 231, 0.62);
    margin: 0 0 1.7rem;
  }
  .hls-eyebrow::before {
    content: '// ';
    color: rgba(157, 131, 62, 0.95); /* dark goldenrod */
  }

  /* Headline — Clash Display 600, two locked visual lines */
  .hls-h1 {
    font-family: 'Clash Display', 'Inter', system-ui, sans-serif;
    font-weight: 600;
    font-size: clamp(2.5rem, 5.5vw, 4.6rem);
    line-height: 1.03;
    letter-spacing: -0.015em;
    color: #ffffff;
    margin: 0 0 1.7rem;
  }
  .hls-line { display: block; }
  .hls-leak {
    color: #FFCF00; /* bright amber — the only text accent allowed in amber */
    text-shadow: 0 0 26px rgba(255, 207, 0, 0.32);
  }

  /* Subline — Inter (site body font) */
  .hls-sub {
    font-size: clamp(1.02rem, 1.6vw, 1.25rem);
    line-height: 1.7;
    color: rgba(231, 231, 231, 0.78);
    max-width: 40rem;
    margin: 0 0 2.4rem;
  }

  /* CTAs — amber is banned here by art direction */
  .hls-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .hls-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 0.95rem 1.9rem;
    border-radius: 12px;
    font-weight: 600;
    font-size: 1.05rem;
    text-decoration: none;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }
  .hls-btn:focus-visible {
    outline: 2px solid #E7E7E7;
    outline-offset: 3px;
  }
  .hls-btn-outline {
    color: #ffffff;
    border: 2px solid rgba(231, 231, 231, 0.3);
    background: rgba(255, 255, 255, 0.02);
  }
  .hls-btn-outline:hover {
    border-color: rgba(231, 231, 231, 0.65);
    background: rgba(255, 255, 255, 0.08);
    transform: translateY(-2px);
  }
  .hls-btn-wa {
    background: #25D366; /* WhatsApp green */
    color: #10231A;      /* near-black on green — WCAG AA, unlike white on this green */
  }
  .hls-btn-wa:hover {
    background: #1FB855;
    transform: translateY(-2px);
  }

  .hls-trust {
    margin: 2rem 0 0;
    font-size: 0.9rem;
    letter-spacing: 0.01em;
    color: rgba(231, 231, 231, 0.55);
  }

  /* Phase-C metric — Space Mono, appears over the ordered stream */
  .hls-metric {
    position: absolute;
    left: 67%;
    top: 16%;
    transform: translate(-50%, 12px);
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    font-family: 'Space Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    opacity: 0;
    transition: opacity 0.45s ease, transform 0.45s ease;
    pointer-events: none;
  }
  .hls-metric.is-on {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  .hls-metric-value {
    font-weight: 700;
    font-size: 1.55rem;
    color: #E7E7E7;
  }
  .hls-metric-label {
    font-weight: 700;
    font-size: 0.62rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(231, 231, 231, 0.55);
  }

  /* Scroll hint */
  .hls-hint {
    position: absolute;
    bottom: 1.8rem;
    left: 50%;
    transform: translateX(-50%);
    color: rgba(231, 231, 231, 0.4);
    animation: hls-bounce 1.6s ease-in-out infinite;
    pointer-events: none;
  }
  @keyframes hls-bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50%      { transform: translateX(-50%) translateY(7px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hls-hint { animation: none; }
    .hls-stage { transition: none; }
  }
</style>

<script>
  /**
   * Gate + lazy boot for the particle scene.
   *
   * Loads Three/GSAP/Lenis ONLY when all of these hold:
   *  - fine pointer + hover (rules out touch devices)
   *  - prefers-reduced-motion is NOT set
   *  - viewport ≥ 768px
   *  - WebGL is actually available
   *  - no ?static override (handy for demoing the fallback)
   *
   * Otherwise nothing is imported at all — the server-rendered shell with the
   * CSS glow above is the final state. Boot is deferred past first paint via
   * requestIdleCallback so the chunk never competes with LCP.
   */
  const section = document.getElementById('hls');
  const forceFallback = new URLSearchParams(window.location.search).has('static');
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const motionOK = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;
  const hasWebGL = (() => {
    try {
      const c = document.createElement('canvas');
      return !!(c.getContext('webgl2') || c.getContext('webgl'));
    } catch {
      return false;
    }
  })();

  const boot = () =>
    import('./leak-scene/mount')
      .then((m) => m.mountHeroScene())
      .catch((err) => {
        console.warn('[hls] scene failed to boot, keeping CSS fallback', err);
        section?.classList.add('hls-static');
      });

  // Width is measured lazily: background / pre-rendered tabs can report a
  // 0-size layout viewport at script-eval time, so a one-shot innerWidth
  // check would mis-gate. Returns false while the viewport is unmeasurable.
  const tryDecide = (): boolean => {
    const w = Math.max(
      document.documentElement.clientWidth || 0,
      window.innerWidth || 0,
      section?.getBoundingClientRect().width || 0,
    );
    if (w === 0) return false;
    if (w < 768) {
      section?.classList.add('hls-static');
    } else if ('requestIdleCallback' in window) {
      requestIdleCallback(boot, { timeout: 2000 });
    } else {
      setTimeout(boot, 300);
    }
    return true;
  };

  if (!forceFallback && finePointer && motionOK && hasWebGL) {
    if (!tryDecide()) {
      // Not measurable yet (prerendered/background tab): retry when the page
      // becomes visible or resizes, with a slow interval as a safety net.
      let iv = 0;
      const retry = () => {
        if (!tryDecide()) return;
        window.clearInterval(iv);
        document.removeEventListener('visibilitychange', retry);
        window.removeEventListener('resize', retry);
      };
      iv = window.setInterval(retry, 400);
      document.addEventListener('visibilitychange', retry);
      window.addEventListener('resize', retry);
    }
  } else {
    section?.classList.add('hls-static');
  }
</script>
