---
import { SERVICES_NAV } from '../lib/services-nav';
import { getServiceAreas } from '../lib/sanity';
import { LOCAL_BUSINESS_CICON } from '../lib/schema-constants';

interface Props {
  // Set to false on pages that already render their own page-specific
  // LocalBusiness block (home, about-us, contact-us) to avoid a duplicate.
  includeLocalBusinessSchema?: boolean;
}
const { includeLocalBusinessSchema = true } = Astro.props;

const year = new Date().getFullYear();
// Sort alphabetically, matching nav dropdown convention
const footerServices = [...SERVICES_NAV].sort((a, b) => a.title.localeCompare(b.title));

// Service Areas column: keep the historical 7-city claim, but link a city only
// when its /areas-served/ page is published + indexable (never link drafts).
// getServiceAreas() is memoized per build, so this costs one Sanity fetch total.
const FOOTER_AREA_NAMES = ['Richmond Hill', 'North York', 'Thornhill', 'Markham', 'Vaughan', 'Aurora', 'Newmarket'];
const allAreas = await getServiceAreas();
const footerAreas = FOOTER_AREA_NAMES.map((name) => {
  const p = allAreas.find((a) => a.cityName === name && a.hasDedicatedPage && a.status === 'published' && a.indexable);
  return { name, href: p ? `/areas-served/${p.slug}/` : null };
});
---

<footer style="background:#212129;color:#a0a0b0;">

  <!-- Main footer content -->
  <div style="max-width:1280px;margin:0 auto;padding:64px 24px 48px;">
    <div style="display:grid;grid-template-columns:1fr;gap:40px;" class="footer-grid">

      <!-- Column 1: Brand + NAP + Hours + Map -->
      <div class="footer-col-brand">

        <!-- Logo + Tagline -->
        <a href="/" style="display:inline-flex;margin-bottom:16px;background:#fff;border-radius:12px;padding:8px;text-decoration:none;">
          <picture>
            <source srcset="/logo-cicon-footer-160.webp" type="image/webp" />
            <img
              src="/logo-cicon-footer-160.png"
              alt="CiCon Digital Marketing"
              width="160"
              height="160"
              style="height:40px;width:auto;object-fit:contain;"
              loading="lazy"
              decoding="async"
            />
          </picture>
        </a>
        <p style="font-size:14px;line-height:1.6;max-width:360px;margin:0 0 20px;color:#a0a0b0;">
          Boutique digital marketing and media production for GTA businesses and dental clinics.
        </p>

        <!-- WhatsApp CTA -->
        <a
          href="https://wa.me/16475840800"
          target="_blank"
          rel="noopener noreferrer"
          style="display:inline-flex;align-items:center;gap:8px;padding:10px 20px;background:#25D366;color:#10231A;font-weight:600;font-size:14px;border-radius:10px;text-decoration:none;margin-bottom:28px;transition:background .2s;"
          onmouseover="this.style.background='#1ebe5d'"
          onmouseout="this.style.background='#25D366'"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="flex-shrink:0">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Chat on WhatsApp
        </a>

        <!-- Contact details -->
        <div style="font-size:13px;line-height:1.7;margin-bottom:20px;">
          <div style="margin-bottom:6px;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle;margin-right:6px;color:#9D833E" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>131 Golf Club Ct, Richmond Hill, ON L4C 5E1, Canada</span>
          </div>
          <div style="margin-bottom:6px;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle;margin-right:6px;color:#9D833E" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.46 12 19.79 19.79 0 0 1 1.39 3.18 2 2 0 0 1 3.36 1h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 8.63a16 16 0 0 0 6.29 6.29l.83-.83a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <a href="tel:+12898071020" style="color:#a0a0b0;text-decoration:none;transition:color .15s;" onmouseover="this.style.color='#5eead4'" onmouseout="this.style.color='#a0a0b0'">+1 (289) 807-1020</a>
          </div>
          <div style="margin-bottom:6px;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle;margin-right:6px;color:#9D833E" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <a href="mailto:info@cicon.ca" style="color:#a0a0b0;text-decoration:none;transition:color .15s;" onmouseover="this.style.color='#5eead4'" onmouseout="this.style.color='#a0a0b0'">info@cicon.ca</a>
          </div>
        </div>

        <!-- Hours -->
        <div style="font-size:13px;color:#a0a0b0;margin-bottom:24px;">
          <div style="font-weight:600;color:#fff;margin-bottom:6px;text-transform:uppercase;letter-spacing:.05em;font-size:11px;">Hours</div>
          <div>Mon – Sat: 9:00 AM – 6:00 PM EST</div>
          <div>Sun: Closed</div>
        </div>

        <!-- Maps link only — iframe removed to eliminate ~400KB Maps JS on every page load -->
        <a
          href="https://www.google.com/maps/dir/?api=1&destination=131+Golf+Club+Ct,+Richmond+Hill,+ON+L4C+5E1"
          target="_blank"
          rel="noopener noreferrer"
          style="font-size:13px;color:#B79A54;text-decoration:none;display:inline-block;margin-bottom:8px;"
          onmouseover="this.style.color='#5eead4'"
          onmouseout="this.style.color='#B79A54'"
        >📍 Get Directions &rarr;</a>

      </div>

      <!-- Column 2: Services — driven by SERVICES_NAV (single source of truth) -->
      <div class="footer-col-services">
        <p style="color:#fff;font-weight:600;margin:0 0 20px;font-size:12px;text-transform:uppercase;letter-spacing:.08em;">Services</p>
        <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:10px;font-size:13px;">
          {footerServices.map(service => (
            <li>
              <a
                href={`/marketing-services/${service.slug}/`}
                style="color:#a0a0b0;text-decoration:none;transition:color .15s;"
                onmouseover="this.style.color='#5eead4'"
                onmouseout="this.style.color='#a0a0b0'"
              >{service.title}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Company -->
      <div class="footer-col-company">
        <p style="color:#fff;font-weight:600;margin:0 0 20px;font-size:12px;text-transform:uppercase;letter-spacing:.08em;">Company</p>
        <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:10px;font-size:13px;">
          {[
            { label: 'About Us',       href: '/about-us/' },
            { label: 'Areas Served',   href: '/areas-served/' },
            { label: 'Blog',           href: '/blog/' },
            { label: 'FAQ',            href: '/faq/' },
            { label: 'Contact',        href: '/contact-us/' },
            { label: 'Free Map Check', href: '/check-google-map-visibility-for-free/' },
          ].map(link => (
            <li>
              <a
                href={link.href}
                style="color:#a0a0b0;text-decoration:none;transition:color .15s;"
                onmouseover="this.style.color='#5eead4'"
                onmouseout="this.style.color='#a0a0b0'"
              >{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 4: Service Areas — heading links to the hub; cities link only
           when their areas-served page is published (drafts stay plain text) -->
      <div class="footer-col-areas">
        <p style="color:#fff;font-weight:600;margin:0 0 20px;font-size:12px;text-transform:uppercase;letter-spacing:.08em;">
          <a href="/areas-served/" style="color:#fff;text-decoration:none;transition:color .15s;" onmouseover="this.style.color='#5eead4'" onmouseout="this.style.color='#fff'">Service Areas</a>
        </p>
        <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:10px;font-size:13px;color:#a0a0b0;">
          {footerAreas.map((area) => (
            <li>
              {area.href ? (
                <a
                  href={area.href}
                  style="color:#a0a0b0;text-decoration:none;transition:color .15s;"
                  onmouseover="this.style.color='#5eead4'"
                  onmouseout="this.style.color='#a0a0b0'"
                >{area.name}</a>
              ) : (
                area.name
              )}
            </li>
          ))}
          <li>
            <a
              href="/areas-served/"
              style="color:#B79A54;text-decoration:none;transition:color .15s;"
              onmouseover="this.style.color='#5eead4'"
              onmouseout="this.style.color='#B79A54'"
            >All areas we serve →</a>
          </li>
        </ul>
      </div>

    </div>
  </div>

  <!-- Bottom bar -->
  <div style="border-top:1px solid rgba(255,255,255,0.08);">
    <div style="max-width:1280px;margin:0 auto;padding:20px 24px;display:flex;flex-direction:column;align-items:center;gap:16px;" class="footer-bottom">

      <!-- Copyright + legal links -->
      <p style="font-size:12px;color:#a0a0b0;margin:0;text-align:center;">
        &copy; {year} CiCon Marketing. All rights reserved.
        &nbsp;&middot;&nbsp;
        <a href="/privacy-policy/" style="color:#a0a0b0;text-decoration:none;transition:color .15s;" onmouseover="this.style.color='#5eead4'" onmouseout="this.style.color='#a0a0b0'">Privacy Policy</a>
        &nbsp;&middot;&nbsp;
        <a href="/terms-and-conditions-sms/" style="color:#a0a0b0;text-decoration:none;transition:color .15s;" onmouseover="this.style.color='#5eead4'" onmouseout="this.style.color='#a0a0b0'">SMS Terms</a>
      </p>

      <!-- Social icons -->
      <div style="display:flex;align-items:center;gap:16px;">
        <!-- Instagram -->
        <a href="https://www.instagram.com/ciconmktg/" target="_blank" rel="noopener noreferrer" aria-label="CiCon Marketing on Instagram" style="color:#a0a0b0;text-decoration:none;transition:color .15s;" onmouseover="this.style.color='#E1306C'" onmouseout="this.style.color='#a0a0b0'">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
          </svg>
        </a>
        <!-- LinkedIn -->
        <a href="https://linkedin.com/company/cicon-marketing/" target="_blank" rel="noopener noreferrer" aria-label="CiCon Marketing on LinkedIn" style="color:#a0a0b0;text-decoration:none;transition:color .15s;" onmouseover="this.style.color='#0A66C2'" onmouseout="this.style.color='#a0a0b0'">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>
          </svg>
        </a>
        <!-- Facebook -->
        <a href="https://www.facebook.com/ciconmarketing/" target="_blank" rel="noopener noreferrer" aria-label="CiCon Marketing on Facebook" style="color:#a0a0b0;text-decoration:none;transition:color .15s;" onmouseover="this.style.color='#1877F2'" onmouseout="this.style.color='#a0a0b0'">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
          </svg>
        </a>
        <!-- YouTube -->
        <a href="https://www.youtube.com/@CiConMarketing" target="_blank" rel="noopener noreferrer" aria-label="CiCon Marketing on YouTube" style="color:#a0a0b0;text-decoration:none;transition:color .15s;" onmouseover="this.style.color='#FF0000'" onmouseout="this.style.color='#a0a0b0'">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.97C18.88 4 12 4 12 4s-6.88 0-8.59.45A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.95 1.97C5.12 20 12 20 12 20s6.88 0 8.59-.45a2.78 2.78 0 0 0 1.95-1.97A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/>
            <polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"/>
          </svg>
        </a>
      </div>

    </div>
  </div>

</footer>

<style>
  /* Desktop: 4-column grid */
  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1fr 1fr !important;
      gap: 60px !important;
    }
    .footer-map {
      height: 220px !important;
    }
    .footer-bottom {
      flex-direction: row !important;
      justify-content: space-between !important;
    }
  }
  /* Tablet: brand full-width + 3 equal columns */
  @media (min-width: 640px) and (max-width: 1023px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr 1fr !important;
    }
    .footer-col-brand {
      grid-column: 1 / -1;
    }
    .footer-map {
      height: 220px !important;
    }
  }
  /* Mobile map full-width, 220px tall */
  @media (max-width: 639px) {
    .footer-map {
      height: 220px !important;
    }
  }
</style>

{includeLocalBusinessSchema && (
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    ...LOCAL_BUSINESS_CICON,
  })} />
)}
