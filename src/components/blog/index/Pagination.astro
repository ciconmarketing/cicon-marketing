---
interface Props { currentPage: number; totalPages: number; }
const { currentPage, totalPages } = Astro.props;
if (totalPages <= 1) return;

function pageUrl(n: number) { return n === 1 ? '/blog/' : `/blog/page/${n}/`; }

// Build page number list with ellipsis
function buildPageList(current: number, total: number): (number | '...')[] {
  if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
  const pages: (number | '...')[] = [1];
  if (current > 3) pages.push('...');
  for (let i = Math.max(2, current - 1); i <= Math.min(total - 1, current + 1); i++) pages.push(i);
  if (current < total - 2) pages.push('...');
  pages.push(total);
  return pages;
}
const pageList = buildPageList(currentPage, totalPages);
---

<nav class="flex items-center justify-center gap-2 mt-16 mb-24 flex-wrap" aria-label="Blog pagination">
  {currentPage > 1 && (
    <a href={pageUrl(currentPage - 1)} rel="prev"
       class="inline-flex items-center px-4 py-1.5 rounded-full text-[13px] font-semibold border border-teal-600 text-teal-600 hover:bg-teal-600 hover:text-white transition-all duration-200"
       style="font-family:'Montserrat',sans-serif;letter-spacing:0.05em;" aria-label="Newer posts">
      ← Newer
    </a>
  )}

  {pageList.map(page =>
    page === '...' ? (
      <span class="px-2 text-gray-400">…</span>
    ) : (
      <a href={pageUrl(page as number)}
         aria-current={page === currentPage ? 'page' : undefined}
         class={`inline-flex items-center px-4 py-1.5 rounded-full text-[13px] font-semibold transition-all duration-200 ${
           page === currentPage
             ? 'text-black border border-transparent'
             : 'border border-teal-600 text-teal-600 hover:bg-teal-600 hover:text-white'
         }`}
         style={`font-family:'Montserrat',sans-serif;letter-spacing:0.05em;${page === currentPage ? 'background:#FFCF00;' : ''}`}>
        {page}
      </a>
    )
  )}

  {currentPage < totalPages && (
    <a href={pageUrl(currentPage + 1)} rel="next"
       class="inline-flex items-center px-4 py-1.5 rounded-full text-[13px] font-semibold border border-teal-600 text-teal-600 hover:bg-teal-600 hover:text-white transition-all duration-200"
       style="font-family:'Montserrat',sans-serif;letter-spacing:0.05em;" aria-label="Older posts">
      Older →
    </a>
  )}
</nav>
