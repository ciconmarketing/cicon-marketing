---
// No props — content is static per spec
---
<section class="bg-navy-900 relative overflow-hidden pt-16 md:pt-20" style="min-height: 280px;" aria-label="Blog hero">
  <!-- Subtle dot texture inherited from homepage pattern -->
  <div class="absolute inset-0 bg-hero-pattern opacity-50 pointer-events-none"></div>
  <div class="container-xl relative z-10 flex items-center py-12 md:py-0" style="min-height: inherit;">
    <div class="max-w-2xl">
      <!-- Eyebrow -->
      <p class="text-teal-600 font-semibold uppercase tracking-widest text-xs mb-3" style="font-family:'Montserrat',sans-serif;letter-spacing:0.15em;">
        Field Notes
      </p>
      <!-- H1 -->
      <h1 class="text-white font-bold leading-tight tracking-tight mb-4"
          style="font-family:'Montserrat',sans-serif;font-size:clamp(2.25rem,4.5vw,3.5rem);letter-spacing:-0.02em;">
        Field Notes on Modern Marketing
      </h1>
      <!-- Dek -->
      <p class="text-white/80 leading-relaxed mb-6 max-w-xl"
         style="font-style:italic;font-size:1.125rem;line-height:1.5;">
        Data-driven playbooks from the boutique agency growing GTA businesses. New guides every week — covering local SEO, paid acquisition, dental marketing, and the strategy stack behind real growth.
      </p>
      <!-- Amber accent rule -->
      <div class="h-0.5 rounded-full" style="width:60px;background:#FFCF00;" aria-hidden="true"></div>
    </div>
  </div>
</section>
