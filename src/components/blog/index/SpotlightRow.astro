---
import type { BlogCategory } from '../../../lib/sanity';
interface Props { variant: 'stat' | 'category'; categories: BlogCategory[] }
const { variant, categories } = Astro.props;

const stats = [
  { num: '76%', context: 'of mobile local searches result in a store visit within 24 hours.', link: '/blog/local-seo-agency-toronto-guide-2026/' },
  { num: '$1,500–$5,000', context: 'the monthly range that separates serious local SEO from outsourced spam.', link: '/blog/local-seo-agency-toronto-guide-2026/' },
  { num: '87%', context: 'of consumers used Google to find local businesses in 2025.', link: '/blog/local-seo-agency-toronto-guide-2026/' },
]
const stat = stats[0];

const topCategory = [...categories].sort((a, b) => b.postCount - a.postCount)[0];
---

{variant === 'stat' ? (
  <div class="bg-navy-900 -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8 py-16 my-8 rounded-2xl" aria-label="Data spotlight">
    <div class="max-w-5xl mx-auto">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-8">
        <div>
          <p class="text-teal-600 font-semibold uppercase text-[10px] tracking-widest mb-3" style="font-family:'Inter',sans-serif;">By the Numbers</p>
          <p class="font-bold leading-none mb-3" style={`font-family:'Inter',sans-serif;font-size:clamp(4rem,7vw,6rem);color:#FFCF00;letter-spacing:-0.04em;text-shadow:0 4px 24px rgba(255,207,0,0.25);`}>{stat.num}</p>
          <p class="text-white/80 max-w-lg leading-relaxed" style="font-style:italic;font-size:1.125rem;">{stat.context}</p>
        </div>
        <a href={stat.link} class="text-white/70 hover:text-white font-medium text-sm whitespace-nowrap transition-colors flex-shrink-0" style="font-family:'Inter',sans-serif;">
          Read the guide that proves it →
        </a>
      </div>
    </div>
  </div>
) : topCategory ? (
  <div class="bg-white border rounded-2xl p-10 my-8" style="border-color:rgba(157,131,62,0.15);" aria-label="Category spotlight">
    <p class="text-teal-600 font-semibold uppercase text-[10px] tracking-widest mb-2" style="font-family:'Inter',sans-serif;">More on {topCategory.name}</p>
    <h3 class="text-black font-bold mb-2" style="font-family:'Inter',sans-serif;font-size:1.75rem;">{topCategory.name} guides for GTA businesses</h3>
    {topCategory.description && <p class="text-gray-500 mb-4">{topCategory.description}</p>}
    <a href={`/blog/?category=${topCategory.slug}`} class="group inline-flex items-center gap-1 font-semibold text-sm text-teal-600 relative" style="font-family:'Inter',sans-serif;">
      View all {topCategory.postCount} guide{topCategory.postCount !== 1 ? 's' : ''} →
      <span class="absolute -bottom-0.5 left-0 h-px w-0 group-hover:w-full transition-all duration-300" style="background:#FFCF00;"></span>
    </a>
  </div>
) : null}
