---
import type { BlogCategory } from '../../../lib/sanity';
interface Props { categories: BlogCategory[] }
const { categories } = Astro.props;
---

<!-- Sentinel for sticky detection -->
<div id="filter-bar-sentinel" class="h-px w-full" aria-hidden="true"></div>

<div id="filter-bar" class="bg-gray-50/90 backdrop-blur-md border-b sticky z-40" style="top:64px;border-color:rgba(157,131,62,0.15);">
  <div class="container-xl">
    <div class="flex items-center justify-between gap-4 py-3">

      <!-- Category chips -->
      <div class="flex items-center gap-2 overflow-x-auto scrollbar-hide flex-1 min-w-0 pb-0.5" role="group" aria-label="Filter posts by category">
        <button
          data-category-chip="all"
          aria-pressed="true"
          class="chip-active flex-shrink-0 inline-flex items-center px-4 py-1.5 rounded-full text-[13px] font-semibold uppercase tracking-wide transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2"
          style="font-family:'Montserrat',sans-serif;letter-spacing:0.05em;"
        >
          All
        </button>
        {categories.filter(c => c.postCount > 0).map(cat => (
          <button
            data-category-chip={cat.slug}
            aria-pressed="false"
            class="chip-inactive flex-shrink-0 inline-flex items-center px-4 py-1.5 rounded-full text-[13px] font-semibold uppercase tracking-wide transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2"
            style="font-family:'Montserrat',sans-serif;letter-spacing:0.05em;"
          >
            {cat.name}
          </button>
        ))}
      </div>

      <!-- Search -->
      <div id="search-wrapper" class="flex items-center gap-2 flex-shrink-0">
        <button id="search-toggle" aria-label="Toggle search" class="p-2 text-gray-500 hover:text-gray-900 transition-colors rounded-lg focus-visible:outline-2 focus-visible:outline-offset-2">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
          </svg>
        </button>
        <div class="overflow-hidden transition-all duration-300" style="width:0;max-width:280px;" id="search-input-wrap">
          <label for="blog-search" class="sr-only">Search guides</label>
          <input
            id="blog-search"
            type="search"
            placeholder="Search guides…"
            class="w-full bg-white border border-gray-200 rounded-lg px-3 py-1.5 text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:border-teal-600 focus:ring-1 focus:ring-teal-600 transition-colors"
            aria-label="Search blog posts"
          />
        </div>
      </div>
    </div>
  </div>
</div>

<!-- No results state -->
<div id="no-results" class="hidden text-center py-20">
  <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mx-auto mb-4 text-teal-600" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
  <p class="text-gray-600 mb-4">No guides match your filters. Try clearing them or search a different term.</p>
  <button id="clear-filters" class="inline-flex items-center px-4 py-2 rounded-full text-sm font-semibold text-black" style="background:#FFCF00;font-family:'Montserrat',sans-serif;" aria-live="polite">
    Clear filters
  </button>
</div>

<style>
  .chip-active {
    background: #FFCF00;
    color: #000;
    border: 1.5px solid transparent;
  }
  .chip-inactive {
    background: transparent;
    color: #9D833E;
    border: 1.5px solid #9D833E;
  }
  .chip-inactive:hover {
    background: #9D833E;
    color: #fff;
  }
  .search-expanded #search-input-wrap {
    width: 280px !important;
  }
  *:focus-visible {
    outline-color: #FFCF00;
  }
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
</style>

<script is:inline>
  // Clear filters button
  document.getElementById('clear-filters')?.addEventListener('click', () => {
    history.pushState({}, '', window.location.pathname);
    window.location.reload();
  });
  // Search expand
  const searchToggle = document.getElementById('search-toggle');
  const searchWrapper = document.getElementById('search-wrapper');
  const searchInput = document.getElementById('blog-search');
  searchToggle?.addEventListener('click', () => {
    searchWrapper?.classList.toggle('search-expanded');
    if (searchWrapper?.classList.contains('search-expanded')) searchInput?.focus();
  });
</script>
