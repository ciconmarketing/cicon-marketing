---
import type { WhyCiConData } from '../lib/types';
import StatCards from './react/StatCards.tsx';
interface Props { data: WhyCiConData }
const { data } = Astro.props;
---

<section id="why-cicon" class="py-20 lg:py-28 bg-gray-50">
  <div class="container-xl">

    <div class="text-center mb-16">
      <span class="section-label" data-aos="fade-up">Trusted Since 2010</span>
      <h2 class="section-heading mx-auto max-w-3xl" data-aos="fade-up" data-aos-delay="100">{data.headline}</h2>
    </div>

    <StatCards stats={data.stats} client:visible />

    <!-- Description + visual layout -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div data-aos="fade-right">
        <p class="text-lg md:text-xl text-gray-600 leading-relaxed">
          {data.description}
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-4">
          <a
            href="https://wa.me/16475840800"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-7 py-3.5 text-white font-semibold rounded-xl transition-all duration-200 shadow-md hover:-translate-y-0.5"
            style="background:var(--whatsapp-bright)"
            onmouseover="this.style.background='var(--whatsapp-bright-hover)'"
            onmouseout="this.style.background='var(--whatsapp-bright)'"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="flex-shrink:0">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Chat on WhatsApp
          </a>
        </div>
      </div>

      <!-- Feature image (if set in Sanity) or default checklist -->
      {data.featureImageUrl ? (
        <div class="rounded-2xl overflow-hidden shadow-md" data-aos="fade-left">
          <img
            src={data.featureImageUrl}
            alt={data.featureImageAlt ?? data.headline}
            class="w-full h-auto object-cover"
          />
          {data.featureImageCaption && (
            <p class="text-sm text-gray-500 text-center mt-3 px-2">{data.featureImageCaption}</p>
          )}
        </div>
      ) : (
        <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-sm" data-aos="fade-left">
          <h3 class="text-lg font-bold text-navy-900 mb-6">What Sets Us Apart</h3>
          <ul class="space-y-4">
            {[
              'Boutique agency — you work with the actual strategists, not account managers',
              'Full-funnel approach from awareness to conversion to retention',
              'Transparent, jargon-free reporting every month',
              'Local GTA market expertise with hyper-targeted campaigns',
              'No long-term contracts — we earn your business every month',
            ].map((item, i) => (
              <li class="flex items-start gap-3" data-aos="fade-left" data-aos-delay={String(i * 80)}>
                <div class="w-5 h-5 rounded-full bg-teal-100 flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-teal-700" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                </div>
                <span class="text-gray-600 leading-snug">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>

  </div>
</section>
